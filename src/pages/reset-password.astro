---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const token = Astro.url.searchParams.get('token') || '';
---

<Base title="Reset Password | VINSHO" description="Set a new password for your VINSHO account.">
  <Nav />

  <main class="auth-page-wrapper">
    <div class="auth-card-container wrap">
      <div class="auth-card">
        
        <div class="auth-header-group">
          <span class="auth-eyebrow">NEW PASSWORD</span>
          <h1 class="auth-title">Reset Your Password</h1>
          <p class="auth-sub">Enter a new secure password for your account.</p>
        </div>

        <div id="auth-alert" class="auth-alert-box" hidden></div>

        <form id="reset-form" class="auth-form" novalidate>
          <input type="hidden" id="token" name="token" value={token} />

          <div class="form-field">
            <label for="newPassword" class="field-label">New Password * (min. 6 characters)</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input 
                type="password" 
                id="newPassword" 
                name="newPassword" 
                placeholder="Enter new password" 
                required 
                autocomplete="new-password"
              />
            </div>
          </div>

          <div class="form-field">
            <label for="confirmPassword" class="field-label">Confirm New Password *</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input 
                type="password" 
                id="confirmPassword" 
                name="confirmPassword" 
                placeholder="Confirm new password" 
                required 
                autocomplete="new-password"
              />
            </div>
          </div>

          <button type="submit" id="reset-btn" class="auth-submit-btn">
            UPDATE PASSWORD
          </button>
        </form>

        <div class="auth-footer-prompt" style="margin-top: 1.5rem;">
          <a href="/login" class="back-link">&larr; Back to Login</a>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Base>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('reset-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('auth-alert');
    const submitBtn = document.getElementById('reset-btn') as HTMLButtonElement | null;

    const tokenInput = document.getElementById('token') as HTMLInputElement | null;
    const urlParams = new URLSearchParams(window.location.search);
    const tokenVal = tokenInput?.value || urlParams.get('token') || '';

    if (!tokenVal && alertBox) {
      alertBox.textContent = 'Invalid or missing password reset token. Please request a new reset link.';
      alertBox.classList.add('error');
      alertBox.hidden = false;
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const newPass = (document.getElementById('newPassword') as HTMLInputElement)?.value.trim();
      const confirmPass = (document.getElementById('confirmPassword') as HTMLInputElement)?.value.trim();

      if (alertBox) {
        alertBox.hidden = true;
        alertBox.className = 'auth-alert-box';
      }

      if (!tokenVal) {
        showError('Missing reset token. Please request a new reset link.');
        return;
      }

      if (!newPass || newPass.length < 6) {
        showError('New password must be at least 6 characters long.');
        return;
      }

      if (newPass !== confirmPass) {
        showError('Passwords do not match. Please verify.');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'UPDATING…';
      }

      try {
        const res = await fetch('/api/account', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'reset-password',
            token: tokenVal,
            newPassword: newPass
          })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          if (alertBox) {
            alertBox.textContent = 'Password reset successfully! Redirecting to login…';
            alertBox.classList.add('success');
            alertBox.hidden = false;
          }
          setTimeout(() => {
            window.location.href = '/login';
          }, 1200);
        } else {
          showError(data.error || 'Password reset failed.');
        }
      } catch (err) {
        showError('Network error. Please try again.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'UPDATE PASSWORD';
        }
      }
    });

    function showError(msg: string) {
      if (alertBox) {
        alertBox.textContent = msg;
        alertBox.classList.add('error');
        alertBox.hidden = false;
      }
    }
  });
</script>

<style>
  .auth-page-wrapper {
    background-color: #FAF6F0;
    padding-block: clamp(2rem, 5vw, 4.5rem);
    min-height: 75vh;
    display: flex;
    align-items: center;
  }

  .auth-card-container {
    max-width: 480px;
    margin-inline: auto;
    width: 100%;
  }

  .auth-card {
    background: #ffffff;
    border: 1px solid rgba(138, 23, 75, 0.12);
    border-radius: 16px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 10px 35px rgba(138, 23, 75, 0.05);
  }

  .auth-header-group {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .auth-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--pink, #CD788F);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.35rem;
  }

  .auth-title {
    font-family: var(--serif, serif);
    font-size: clamp(1.5rem, 3.5vw, 1.95rem);
    color: var(--maroon, #8A174B);
    margin: 0 0 0.35rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .auth-sub {
    font-size: 0.844rem;
    color: var(--ink-soft, #7C6B6E);
    margin: 0;
  }

  .auth-alert-box {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.844rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .auth-alert-box.error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .auth-alert-box.success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-size: 0.813rem;
    font-weight: 600;
    color: var(--ink, #3E3336);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background: #FAF6F0;
    border: 1.5px solid rgba(138, 23, 75, 0.15);
    border-radius: 8px;
    padding-left: 0.85rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .input-wrapper:focus-within {
    border-color: var(--maroon, #8A174B);
    box-shadow: 0 0 0 3px rgba(138, 23, 75, 0.08);
  }

  .input-icon {
    color: var(--ink-soft, #7C6B6E);
    flex-shrink: 0;
  }

  .input-wrapper input {
    width: 100%;
    border: none;
    background: transparent;
    outline: none;
    padding: 0.75rem 0.85rem;
    font-size: 16px !important;
    color: var(--ink, #3E3336);
    font-family: var(--sans, sans-serif);
  }

  .auth-submit-btn {
    background: var(--maroon, #8A174B);
    color: #ffffff;
    border: 1.5px solid var(--maroon, #8A174B);
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    margin-top: 0.5rem;
    min-height: 46px;
    transition: all 0.2s ease;
    width: 100%;
  }

  .auth-submit-btn:hover:not(:disabled) {
    background: var(--maroon-2, #6B0E38);
    border-color: var(--maroon-2, #6B0E38);
  }

  .back-link {
    color: var(--maroon, #8A174B);
    font-size: 0.844rem;
    font-weight: 600;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
