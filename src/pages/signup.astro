---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCustomerFromSession } from '../lib/customerAuth';

const customer = getCustomerFromSession(Astro.request);
const redirectUrl = Astro.url.searchParams.get('redirect') || '/account';

if (customer) {
  return Astro.redirect(redirectUrl);
}
---

<Base title="Create an Account | VINSHO" description="Register a new customer account on VINSHO to complete your purchase and manage orders.">
  <Nav />

  <main class="auth-page-wrapper">
    <div class="auth-card-container wrap">
      <div class="auth-card">
        
        <div class="auth-header-group">
          <span class="auth-eyebrow">JOIN VINSHO</span>
          <h1 class="auth-title">Create Your Account</h1>
          <p class="auth-sub">Enter your details to register and manage your orders seamlessly.</p>
        </div>

        <div id="auth-alert" class="auth-alert-box" hidden></div>

        <form id="signup-form" class="auth-form" novalidate>
          
          <div class="form-field">
            <label for="name" class="field-label">Full Name *</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              <input 
                type="text" 
                id="name" 
                name="name" 
                placeholder="Full Name" 
                required 
                autocomplete="name"
              />
            </div>
          </div>

          <div class="form-field">
            <label for="email" class="field-label">Email Address *</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="name@example.com" 
                required 
                autocomplete="email"
              />
            </div>
          </div>

          <div class="form-field">
            <label for="phone" class="field-label">Mobile Phone Number *</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                placeholder="10-digit mobile number" 
                required 
                autocomplete="tel"
              />
            </div>
          </div>

          <div class="form-field">
            <label for="password" class="field-label">Password * (min. 6 characters)</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input 
                type="password" 
                id="password" 
                name="password" 
                placeholder="Create a strong password" 
                required 
                autocomplete="new-password"
              />
            </div>
          </div>

          <div class="form-field">
            <label for="confirmPassword" class="field-label">Confirm Password *</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input 
                type="password" 
                id="confirmPassword" 
                name="confirmPassword" 
                placeholder="Re-enter your password" 
                required 
                autocomplete="new-password"
              />
            </div>
          </div>

          <button type="submit" id="signup-btn" class="auth-submit-btn">
            CREATE ACCOUNT
          </button>
        </form>

        <div class="auth-divider">
          <span>ALREADY HAVE AN ACCOUNT?</span>
        </div>

        <div class="auth-footer-prompt">
          <a href={`/login${redirectUrl !== '/account' ? `?redirect=${encodeURIComponent(redirectUrl)}` : ''}`} class="auth-secondary-btn">
            LOG IN TO YOUR ACCOUNT &rarr;
          </a>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Base>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('signup-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('auth-alert');
    const submitBtn = document.getElementById('signup-btn') as HTMLButtonElement | null;

    const urlParams = new URLSearchParams(window.location.search);
    const redirectTarget = urlParams.get('redirect') || '/account';

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nameVal = (document.getElementById('name') as HTMLInputElement)?.value.trim();
      const emailVal = (document.getElementById('email') as HTMLInputElement)?.value.trim();
      const phoneVal = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
      const passwordVal = (document.getElementById('password') as HTMLInputElement)?.value.trim();
      const confirmVal = (document.getElementById('confirmPassword') as HTMLInputElement)?.value.trim();

      if (alertBox) {
        alertBox.hidden = true;
        alertBox.className = 'auth-alert-box';
      }

      if (!nameVal) {
        showError('Please enter your full name.');
        return;
      }

      if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
        showError('Please enter a valid email address.');
        return;
      }

      if (!phoneVal || phoneVal.replace(/[^\d]/g, '').length < 10) {
        showError('Please enter a valid 10-digit phone number.');
        return;
      }

      if (!passwordVal || passwordVal.length < 6) {
        showError('Password must be at least 6 characters long.');
        return;
      }

      if (passwordVal !== confirmVal) {
        showError('Passwords do not match. Please verify.');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'CREATING ACCOUNT…';
      }

      try {
        const res = await fetch('/api/account', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'signup',
            name: nameVal,
            email: emailVal,
            phone: phoneVal,
            password: passwordVal,
            confirmPassword: confirmVal
          })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          if (alertBox) {
            alertBox.textContent = 'Account registered successfully! Redirecting…';
            alertBox.classList.add('success');
            alertBox.hidden = false;
          }
          // Redirect while preserving cart items
          setTimeout(() => {
            window.location.href = redirectTarget;
          }, 400);
        } else {
          showError(data.error || 'Registration failed. Please try again.');
        }
      } catch (err) {
        showError('Network connection error. Please try again.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'CREATE ACCOUNT';
        }
      }
    });

    function showError(msg: string) {
      if (alertBox) {
        alertBox.textContent = msg;
        alertBox.classList.add('error');
        alertBox.hidden = false;
      }
    }
  });
</script>

<style>
  .auth-page-wrapper {
    background-color: #FAF6F0;
    padding-block: clamp(2rem, 5vw, 4.5rem);
    min-height: 75vh;
    display: flex;
    align-items: center;
  }

  .auth-card-container {
    max-width: 520px;
    margin-inline: auto;
    width: 100%;
  }

  .auth-card {
    background: #ffffff;
    border: 1px solid rgba(138, 23, 75, 0.12);
    border-radius: 16px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 10px 35px rgba(138, 23, 75, 0.05);
  }

  .auth-header-group {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .auth-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--pink, #CD788F);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.35rem;
  }

  .auth-title {
    font-family: var(--serif, serif);
    font-size: clamp(1.5rem, 3.5vw, 1.95rem);
    color: var(--maroon, #8A174B);
    margin: 0 0 0.35rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .auth-sub {
    font-size: 0.844rem;
    color: var(--ink-soft, #7C6B6E);
    margin: 0;
  }

  .auth-alert-box {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.844rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .auth-alert-box.error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .auth-alert-box.success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-size: 0.813rem;
    font-weight: 600;
    color: var(--ink, #3E3336);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background: #FAF6F0;
    border: 1.5px solid rgba(138, 23, 75, 0.15);
    border-radius: 8px;
    padding-left: 0.85rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .input-wrapper:focus-within {
    border-color: var(--maroon, #8A174B);
    box-shadow: 0 0 0 3px rgba(138, 23, 75, 0.08);
  }

  .input-icon {
    color: var(--ink-soft, #7C6B6E);
    flex-shrink: 0;
  }

  .input-wrapper input {
    width: 100%;
    border: none;
    background: transparent;
    outline: none;
    padding: 0.75rem 0.85rem;
    font-size: 16px !important;
    color: var(--ink, #3E3336);
    font-family: var(--sans, sans-serif);
  }

  .auth-submit-btn {
    background: var(--maroon, #8A174B);
    color: #ffffff;
    border: 1.5px solid var(--maroon, #8A174B);
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    margin-top: 0.5rem;
    min-height: 46px;
    transition: all 0.2s ease;
    width: 100%;
  }

  .auth-submit-btn:hover:not(:disabled) {
    background: var(--maroon-2, #6B0E38);
    border-color: var(--maroon-2, #6B0E38);
  }

  .auth-submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin-block: 1.5rem;
    color: var(--ink-soft, #7C6B6E);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid rgba(138, 23, 75, 0.12);
  }

  .auth-divider span {
    padding-inline: 0.75rem;
  }

  .auth-footer-prompt {
    text-align: center;
  }

  .auth-secondary-btn {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: transparent;
    color: var(--maroon, #8A174B);
    border: 1.5px solid var(--maroon, #8A174B);
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    font-size: 0.813rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .auth-secondary-btn:hover {
    background: var(--maroon, #8A174B);
    color: #ffffff;
  }
</style>
