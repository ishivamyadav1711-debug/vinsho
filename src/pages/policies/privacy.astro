---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Privacy Policy — VINSHO";
---

<Base title={pageTitle}>
  <Nav />
  <main class="wrap policy-page-container">
    <header class="policy-header">
      <h1>Privacy Policy</h1>
      <p class="policy-meta">Last Updated: August 2026 &middot; VINSHO</p>
    </header>

    <article class="policy-content">
      <p class="intro-p">At VINSHO, we value your privacy and are committed to protecting your personal information.</p>

      <section class="policy-section">
        <ul class="privacy-list">
          <li>We only collect information necessary to process your orders, provide services, and improve your shopping experience.</li>
          <li>Your data will never be sold or rented to third parties.</li>
          <li>We may share information with trusted partners (like delivery or payment providers) only to complete your purchase.</li>
          <li>All personal data is stored securely with strict safeguards.</li>
          <li>By using our website, you agree to this Privacy Policy.</li>
        </ul>
      </section>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .policy-page-container { padding-block: clamp(2.5rem, 5vw, 5rem); max-width: 52rem; }
  .policy-header h1 { font-family: var(--display); font-size: clamp(2rem, 4vw, 3rem); color: var(--maroon-2); margin: 0 0 0.5rem 0; }
  .policy-meta { font-size: 0.813rem; color: var(--ink-soft); margin-bottom: 2rem; }
  .intro-p { font-size: 1.05rem; line-height: 1.7; color: var(--ink); margin-bottom: 1.5rem; font-weight: 500; }
  .policy-content { font-size: 0.95rem; line-height: 1.7; color: var(--ink); }
  .policy-section { margin-bottom: 2rem; }
  .privacy-list { padding-left: 1.25rem; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .privacy-list li { line-height: 1.7; }
</style>

