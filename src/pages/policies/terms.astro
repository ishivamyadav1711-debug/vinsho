---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Terms & Conditions — VINSHO";
---

<Base title={pageTitle}>
  <Nav />
  <main class="wrap policy-page-container">
    <header class="policy-header">
      <h1>Terms &amp; Conditions</h1>
      <p class="policy-meta">Last Updated: August 2026 &middot; VINSHO</p>
    </header>

    <article class="policy-content">
      <p class="intro-p">Welcome to VINSHO. By accessing or using our website, you agree to the following terms:</p>

      <section class="policy-section">
        <ol class="terms-list">
          <li>
            <strong>Products &amp; Services</strong> – We strive to display accurate details, but product colors, sizes, or availability may vary.
          </li>
          <li>
            <strong>Orders &amp; Payments</strong> – All orders are subject to acceptance and availability. Payments must be made through approved methods.
          </li>
          <li>
            <strong>Returns &amp; Refunds</strong> – Customers can return products within 30 days if unused and in original packaging (see <a href="/policies/returns">Return Policy</a>).
          </li>
          <li>
            <strong>Intellectual Property</strong> – All content, logos, and images on this site belong to VINSHO and cannot be used without permission.
          </li>
          <li>
            <strong>Liability</strong> – VINSHO is not responsible for delays or damages beyond our control (e.g., courier delays).
          </li>
          <li>
            <strong>Changes</strong> – We reserve the right to update these terms anytime, and continued use of our site means acceptance of changes.
          </li>
        </ol>
      </section>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .policy-page-container { padding-block: clamp(2.5rem, 5vw, 5rem); max-width: 52rem; }
  .policy-header h1 { font-family: var(--display); font-size: clamp(2rem, 4vw, 3rem); color: var(--maroon-2); margin: 0 0 0.5rem 0; }
  .policy-meta { font-size: 0.813rem; color: var(--ink-soft); margin-bottom: 2rem; }
  .intro-p { font-size: 1.05rem; line-height: 1.7; color: var(--ink); margin-bottom: 1.5rem; font-weight: 500; }
  .policy-content { font-size: 0.95rem; line-height: 1.7; color: var(--ink); }
  .policy-section { margin-bottom: 2rem; }
  .terms-list { padding-left: 1.25rem; margin: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .terms-list li { line-height: 1.7; }
  .terms-list a { color: var(--maroon); text-decoration: underline; font-weight: 500; }
  .terms-list a:hover { color: var(--pink); }
</style>

