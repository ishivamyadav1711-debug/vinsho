---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';
import { getSessionUser } from '../../lib/auth';

const user = getSessionUser(Astro.request);
if (!user) {
  return Astro.redirect('/crm/login');
}

const isSuperAdmin = user.role === 'SUPER_ADMIN';
const users = isSuperAdmin 
  ? db.prepare('SELECT id, email, name, role, created_at FROM admin_users ORDER BY name ASC').all() as any[]
  : [];
---

<AdminLayout title="CRM Settings & Security" activeNav="settings">
  <div class="settings-page-container">
    <div class="s-head">
      <h1 class="s-title">CRM Settings &amp; Security</h1>
      <p class="s-sub">Manage your CRM account security, password settings, and system access.</p>
    </div>

    <div class="settings-grid">
      <!-- Security / Change Password Card -->
      <div class="s-card">
        <h2>Security &amp; Password</h2>
        <p class="card-desc">Update your account password to keep your CRM portal access secure.</p>

        <form id="change-password-form" class="u-form" autocomplete="off">
          <div class="f-group">
            <label for="currentPassword">Current Password *</label>
            <div class="password-input-wrap">
              <input type="password" id="currentPassword" name="currentPassword" placeholder="••••••••••••" required autocomplete="current-password" />
              <button type="button" class="toggle-pw-btn" data-for="currentPassword" aria-label="Toggle password visibility" title="Show/Hide Password">
                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="f-group">
            <label for="newPassword">New Password *</label>
            <div class="password-input-wrap">
              <input type="password" id="newPassword" name="newPassword" placeholder="••••••••••••" required autocomplete="new-password" />
              <button type="button" class="toggle-pw-btn" data-for="newPassword" aria-label="Toggle password visibility" title="Show/Hide Password">
                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="f-group">
            <label for="confirmPassword">Confirm New Password *</label>
            <div class="password-input-wrap">
              <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••••••" required autocomplete="new-password" />
              <button type="button" class="toggle-pw-btn" data-for="confirmPassword" aria-label="Toggle password visibility" title="Show/Hide Password">
                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="pw-rules-box">
            <span class="pw-rules-title">Password Security Requirements:</span>
            <ul class="pw-rules-list">
              <li id="rule-len">At least 8 characters</li>
              <li id="rule-upper">At least 1 uppercase letter (A-Z)</li>
              <li id="rule-lower">At least 1 lowercase letter (a-z)</li>
              <li id="rule-num">At least 1 number (0-9)</li>
            </ul>
          </div>

          <p id="pw-form-success" class="success-msg" hidden></p>
          <p id="pw-form-error" class="error-msg" hidden></p>

          <div class="form-btn-row">
            <button type="submit" id="pw-submit-btn" class="submit-btn">Change Password</button>
            <button type="button" id="pw-reset-btn" class="cancel-btn">Cancel / Reset</button>
          </div>
        </form>
      </div>

      {isSuperAdmin && (
        <div class="s-card">
          <h2>Add Team Member</h2>
          <p class="card-desc">Create new staff or admin accounts for CRM access.</p>
          <form id="create-user-form" class="u-form">
            <div class="f-group">
              <label>Full Name *</label>
              <input type="text" name="name" placeholder="e.g. Kavita Roy" required />
            </div>

            <div class="f-group">
              <label>Email Address *</label>
              <input type="email" name="email" placeholder="user@vinsho.com" required />
            </div>

            <div class="f-group">
              <label>Password *</label>
              <input type="password" name="password" placeholder="••••••••••••" required />
            </div>

            <div class="f-group">
              <label>Role &amp; Access Level *</label>
              <select name="role" required>
                <option value="SALES">SALES — View/update leads, follow-ups &amp; activities</option>
                <option value="STAFF">STAFF — Limited CRM view</option>
                <option value="ADMIN">ADMIN — Full CRM control &amp; team management</option>
              </select>
            </div>

            <p id="user-form-error" class="error-msg" hidden></p>
            <button type="submit" class="submit-btn">+ Create Team User</button>
          </form>
        </div>
      )}

      {isSuperAdmin && users.length > 0 && (
        <div class="s-card full-width">
          <h2>Active Team Members ({users.length})</h2>
          <div class="users-list">
            {users.map((u) => (
              <div class="user-item-card">
                <div class="u-avatar">{u.name.charAt(0)}</div>
                <div class="u-info">
                  <span class="u-name">{u.name}</span>
                  <span class="u-email">{u.email}</span>
                  <span class="u-date">Created {new Date(u.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
                </div>
                <span class={`role-pill role-${u.role.toLowerCase()}`}>{u.role}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</AdminLayout>

<script>
  // ── Show/Hide Password Toggle ──────────────────────────────────────────
  document.querySelectorAll('.toggle-pw-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-for');
      if (!targetId) return;
      const input = document.getElementById(targetId) as HTMLInputElement | null;
      if (!input) return;

      if (input.type === 'password') {
        input.type = 'text';
        btn.classList.add('active');
      } else {
        input.type = 'password';
        btn.classList.remove('active');
      }
    });
  });

  // ── Live Password Requirements Checker ─────────────────────────────────
  const newPwInput = document.getElementById('newPassword') as HTMLInputElement | null;
  const ruleLen = document.getElementById('rule-len');
  const ruleUpper = document.getElementById('rule-upper');
  const ruleLower = document.getElementById('rule-lower');
  const ruleNum = document.getElementById('rule-num');

  newPwInput?.addEventListener('input', () => {
    const val = newPwInput.value;
    if (ruleLen) ruleLen.className = val.length >= 8 ? 'met' : '';
    if (ruleUpper) ruleUpper.className = /[A-Z]/.test(val) ? 'met' : '';
    if (ruleLower) ruleLower.className = /[a-z]/.test(val) ? 'met' : '';
    if (ruleNum) ruleNum.className = /[0-9]/.test(val) ? 'met' : '';
  });

  // ── Change Password Form Submission ────────────────────────────────────
  const pwForm = document.getElementById('change-password-form') as HTMLFormElement | null;
  const pwErr = document.getElementById('pw-form-error');
  const pwSuccess = document.getElementById('pw-form-success');
  const pwSubmitBtn = document.getElementById('pw-submit-btn') as HTMLButtonElement | null;
  const pwResetBtn = document.getElementById('pw-reset-btn');

  pwResetBtn?.addEventListener('click', () => {
    pwForm?.reset();
    if (pwErr) pwErr.hidden = true;
    if (pwSuccess) pwSuccess.hidden = true;
    [ruleLen, ruleUpper, ruleLower, ruleNum].forEach(r => r ? r.className = '' : null);
  });

  pwForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (pwErr) pwErr.hidden = true;
    if (pwSuccess) pwSuccess.hidden = true;
    if (pwSubmitBtn) pwSubmitBtn.disabled = true;

    const currentPassword = (document.getElementById('currentPassword') as HTMLInputElement).value;
    const newPassword = (document.getElementById('newPassword') as HTMLInputElement).value;
    const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement).value;

    if (newPassword !== confirmPassword) {
      if (pwErr) {
        pwErr.hidden = false;
        pwErr.textContent = 'New password and confirm password do not match.';
      }
      if (pwSubmitBtn) pwSubmitBtn.disabled = false;
      return;
    }

    try {
      const res = await fetch('/api/admin/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        if (pwErr) {
          pwErr.hidden = false;
          pwErr.textContent = data.message || 'Failed to update password.';
        }
        if (pwSubmitBtn) pwSubmitBtn.disabled = false;
        return;
      }

      if (pwSuccess) {
        pwSuccess.hidden = false;
        pwSuccess.textContent = 'Password changed successfully.';
      }

      pwForm.reset();
      [ruleLen, ruleUpper, ruleLower, ruleNum].forEach(r => r ? r.className = '' : null);

    } catch (err) {
      if (pwErr) {
        pwErr.hidden = false;
        pwErr.textContent = 'Network or server error.';
      }
    } finally {
      if (pwSubmitBtn) pwSubmitBtn.disabled = false;
    }
  });

  // ── Create User Form Submission (Super Admin) ──────────────────────────
  const createUserForm = document.getElementById('create-user-form') as HTMLFormElement | null;
  const userErr = document.getElementById('user-form-error');

  createUserForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (userErr) userErr.hidden = true;

    const formData = new FormData(createUserForm);
    const body = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();

      if (!res.ok || data.error) {
        if (userErr) {
          userErr.hidden = false;
          userErr.textContent = data.error || 'Failed to create user.';
        }
        return;
      }

      window.location.reload();
    } catch (err) {
      if (userErr) {
        userErr.hidden = false;
        userErr.textContent = 'Server connection error.';
      }
    }
  });
</script>

<style>
  .settings-page-container { display: flex; flex-direction: column; gap: 1.5rem; }
  .s-title { font-family: var(--display); font-size: 2rem; color: var(--maroon-2); margin: 0; }
  .s-sub { font-size: 0.88rem; color: var(--ink-soft); margin-top: 0.2rem; }

  .settings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; }
  .s-card { background: var(--paper-2); border: 1px solid var(--line); border-radius: 8px; padding: 1.5rem; }
  .s-card.full-width { grid-column: 1 / -1; }
  .s-card h2 { font-family: var(--display); font-size: 1.25rem; color: var(--maroon-2); margin: 0 0 0.25rem; }
  .card-desc { font-size: 0.813rem; color: var(--ink-soft); margin: 0 0 1.25rem; border-bottom: 1px solid var(--line); padding-bottom: 0.75rem; }

  .u-form { display: flex; flex-direction: column; gap: 1rem; }
  .f-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .f-group label { font-size: 0.781rem; font-weight: 600; color: var(--maroon-2); }
  
  .password-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .password-input-wrap input {
    width: 100%;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.6rem 2.5rem 0.6rem 0.75rem;
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .password-input-wrap input:focus {
    border-color: var(--maroon);
  }

  .toggle-pw-btn {
    position: absolute;
    right: 0.5rem;
    background: none;
    border: none;
    color: var(--ink-soft);
    cursor: pointer;
    padding: 0.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }
  .toggle-pw-btn:hover { color: var(--maroon); }
  .toggle-pw-btn.active { color: var(--maroon); }
  .eye-icon { width: 18px; height: 18px; }

  .pw-rules-box {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.75rem;
    font-size: 0.781rem;
  }
  .pw-rules-title { font-weight: 600; color: var(--maroon-2); display: block; margin-bottom: 0.35rem; }
  .pw-rules-list { margin: 0; padding-left: 1.2rem; color: var(--ink-soft); display: flex; flex-direction: column; gap: 0.2rem; }
  .pw-rules-list li.met { color: #166534; font-weight: 600; }
  .pw-rules-list li.met::marker { color: #166534; }

  .error-msg { color: #b91c1c; background: #fee2e2; border: 1px solid #fca5a5; padding: 0.6rem 0.8rem; border-radius: 4px; font-size: 0.813rem; margin: 0; }
  .success-msg { color: #166534; background: #dcfce7; border: 1px solid #86efac; padding: 0.6rem 0.8rem; border-radius: 4px; font-size: 0.813rem; margin: 0; }

  .form-btn-row { display: flex; gap: 0.75rem; align-items: center; margin-top: 0.5rem; }
  .submit-btn { background: var(--maroon); color: #ffffff; border: none; padding: 0.7rem 1.25rem; border-radius: 999px; font-weight: 600; font-size: 0.813rem; cursor: pointer; transition: background 0.2s ease; }
  .submit-btn:hover { background: var(--maroon-3, #450320); }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .cancel-btn { background: transparent; color: var(--ink-soft); border: 1px solid var(--line); padding: 0.65rem 1.1rem; border-radius: 999px; font-weight: 600; font-size: 0.813rem; cursor: pointer; transition: all 0.2s ease; }
  .cancel-btn:hover { background: #ffffff; color: var(--maroon-2); }

  .users-list { display: flex; flex-direction: column; gap: 0.85rem; }
  .user-item-card { display: flex; align-items: center; gap: 0.85rem; background: #ffffff; border: 1px solid var(--line); padding: 0.85rem; border-radius: 6px; }
  .u-avatar { width: 40px; height: 40px; background: var(--maroon-2); color: #ffffff; font-weight: 700; border-radius: 50%; display: grid; place-items: center; font-size: 1.1rem; }
  .u-info { display: flex; flex-direction: column; flex: 1; }
  .u-name { font-weight: 700; color: var(--maroon-2); font-size: 0.9rem; }
  .u-email { font-size: 0.781rem; color: var(--ink); }
  .u-date { font-size: 0.72rem; color: var(--ink-soft); margin-top: 0.15rem; }

  .role-pill { font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; letter-spacing: 0.06em; }
  .role-super_admin { background: #fef3c7; color: #92400e; }
  .role-admin { background: #fee2e2; color: #991b1b; }
  .role-sales { background: #dcfce7; color: #166534; }
  .role-staff { background: #e0f2fe; color: #075985; }

  @media (max-width: 900px) {
    .settings-grid { grid-template-columns: 1fr; }
  }
</style>
