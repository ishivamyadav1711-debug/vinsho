---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { prisma } from '../../../lib/db';
import { isProductPurchasable } from '../../../lib/purchasability';

const user = await getSessionUser(Astro.request);
if (!user) {
  return Astro.redirect('/crm/login');
}

const url = new URL(Astro.request.url);
const search = (url.searchParams.get('q') || '').trim();
const statusFilter = url.searchParams.get('status') || 'all';
const collectionFilter = url.searchParams.get('collection') || 'all';
const availabilityFilter = url.searchParams.get('availability') || 'all';
const sortBy = url.searchParams.get('sort') || 'name_asc';
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 20;

// Fetch collections for dropdown filter
const collections = await prisma.collections.findMany({
  where: { deleted_at: null },
  orderBy: { name: 'asc' }
});

// Fetch all active products with relations
const productsRaw = await prisma.products.findMany({
  where: { deleted_at: null },
  include: {
    collection: { select: { id: true, name: true, key: true } },
    subcategory: { select: { id: true, name: true, key: true } },
    ProductImages: {
      where: { is_primary: true },
      take: 1,
      select: { url: true }
    },
    ProductVariants: {
      orderBy: { position: 'asc' }
    }
  }
});

const lowStockThreshold = 5;

// Process and map product data
const processedProducts = productsRaw.map((p) => {
  const primaryVariant = p.ProductVariants[0];
  const totalStock = p.ProductVariants.reduce((sum, v) => sum + (v.stock ?? 0), 0);
  const sku = primaryVariant?.sku || p.sku || `PRD-${p.id}`;
  const price = primaryVariant?.selling_price ? Number(primaryVariant.selling_price) : 0;
  const collectionKey = p.collection?.key || p.collection?.name || '';
  const subcategoryKey = p.subcategory?.key || p.subcategory?.name || '';
  const isOnline = Boolean(p.sellable_online && isProductPurchasable({
    slug: p.slug,
    name: p.name,
    collectionKey,
    subcategoryKey
  }));

  let stockStatus: 'IN STOCK' | 'LOW STOCK' | 'OUT OF STOCK' = 'IN STOCK';
  if (totalStock <= 0) {
    stockStatus = 'OUT OF STOCK';
  } else if (totalStock <= lowStockThreshold) {
    stockStatus = 'LOW STOCK';
  }

  return {
    id: p.id,
    name: p.name,
    slug: p.slug,
    sku,
    sku_ref: p.sku_ref,
    collectionId: p.collection_id,
    collectionName: p.collection?.name || 'Uncategorized',
    subcategoryName: p.subcategory?.name || '',
    sellingPrice: price,
    stock: totalStock,
    stockStatus,
    isOnline,
    sellableOnline: p.sellable_online,
    shippingClass: p.shipping_class,
    imageUrl: p.ProductImages[0]?.url || '/placeholder-product.png',
    updatedAt: p.updated_at,
    variants: p.ProductVariants.map((v) => ({
      id: v.id,
      sku: v.sku,
      size: v.size,
      colour: v.colour,
      stock: v.stock ?? 0,
      sellingPrice: v.selling_price ? Number(v.selling_price) : 0
    }))
  };
});

// Global Summary Counts across all real products
const totalCount = processedProducts.length;
const inStockCount = processedProducts.filter((p) => p.stockStatus === 'IN STOCK').length;
const lowStockCount = processedProducts.filter((p) => p.stockStatus === 'LOW STOCK').length;
const outOfStockCount = processedProducts.filter((p) => p.stockStatus === 'OUT OF STOCK').length;

// Filter list
let filtered = processedProducts.filter((p) => {
  if (search) {
    const q = search.toLowerCase();
    const matchName = p.name.toLowerCase().includes(q);
    const matchSku = p.sku.toLowerCase().includes(q) || (p.sku_ref && p.sku_ref.toLowerCase().includes(q));
    const matchSlug = p.slug.toLowerCase().includes(q);
    if (!matchName && !matchSku && !matchSlug) return false;
  }

  if (statusFilter !== 'all') {
    if (statusFilter === 'in_stock' && p.stockStatus !== 'IN STOCK') return false;
    if (statusFilter === 'low_stock' && p.stockStatus !== 'LOW STOCK') return false;
    if (statusFilter === 'out_of_stock' && p.stockStatus !== 'OUT OF STOCK') return false;
  }

  if (collectionFilter !== 'all') {
    if (String(p.collectionId) !== collectionFilter) return false;
  }

  if (availabilityFilter !== 'all') {
    if (availabilityFilter === 'online' && !p.isOnline) return false;
    if (availabilityFilter === 'offline' && p.isOnline) return false;
  }

  return true;
});

// Sort list
filtered.sort((a, b) => {
  if (sortBy === 'name_asc') return a.name.localeCompare(b.name);
  if (sortBy === 'name_desc') return b.name.localeCompare(a.name);
  if (sortBy === 'price_asc') return a.sellingPrice - b.sellingPrice;
  if (sortBy === 'price_desc') return b.sellingPrice - a.sellingPrice;
  if (sortBy === 'stock_asc') return a.stock - b.stock;
  if (sortBy === 'stock_desc') return b.stock - a.stock;
  if (sortBy === 'updated_desc') return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime();
  return 0;
});

const totalFiltered = filtered.length;
const totalPages = Math.max(1, Math.ceil(totalFiltered / pageSize));
const currentPage = Math.min(page, totalPages);
const paginatedProducts = filtered.slice((currentPage - 1) * pageSize, currentPage * pageSize);
---

<AdminLayout title="Product & Inventory Management" activeNav="products">
  <div class="crm-products-page">
    
    <!-- Top Header -->
    <div class="page-head-row">
      <div>
        <h1 class="page-title">Products &amp; Inventory</h1>
        <p class="page-sub">Manage real product catalogue, stock levels, thresholds, and availability in real-time.</p>
      </div>
      <div class="head-actions">
        <a href="/api/admin/products/export-csv" class="btn-secondary" download>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Export CSV
        </a>
      </div>
    </div>

    <!-- Summary Metric KPI Cards -->
    <div class="summary-metrics-grid">
      <div class="metric-card">
        <span class="metric-label">TOTAL PRODUCTS</span>
        <span class="metric-val">{totalCount}</span>
        <span class="metric-sub">Active in Catalogue</span>
      </div>
      <div class="metric-card in-stock">
        <span class="metric-label">IN STOCK</span>
        <span class="metric-val text-green">{inStockCount}</span>
        <span class="metric-sub">&gt; {lowStockThreshold} units</span>
      </div>
      <div class="metric-card low-stock">
        <span class="metric-label">LOW STOCK</span>
        <span class="metric-val text-amber">{lowStockCount}</span>
        <span class="metric-sub">1 &ndash; {lowStockThreshold} units</span>
      </div>
      <div class="metric-card out-of-stock">
        <span class="metric-label">OUT OF STOCK</span>
        <span class="metric-val text-red">{outOfStockCount}</span>
        <span class="metric-sub">0 units available</span>
      </div>
    </div>

    <!-- Toolbar Filters -->
    <div class="filter-card">
      <form method="GET" class="filter-form" id="products-filter-form">
        <div class="search-input-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input 
            type="search" 
            name="q" 
            value={search} 
            placeholder="Search product name, SKU, slug..." 
            class="search-input" 
          />
        </div>

        <select name="status" class="filter-select" onchange="this.form.submit()">
          <option value="all" selected={statusFilter === 'all'}>All Stock Statuses</option>
          <option value="in_stock" selected={statusFilter === 'in_stock'}>In Stock</option>
          <option value="low_stock" selected={statusFilter === 'low_stock'}>Low Stock</option>
          <option value="out_of_stock" selected={statusFilter === 'out_of_stock'}>Out of Stock</option>
        </select>

        <select name="collection" class="filter-select" onchange="this.form.submit()">
          <option value="all" selected={collectionFilter === 'all'}>All Collections</option>
          {collections.map((c) => (
            <option value={String(c.id)} selected={collectionFilter === String(c.id)}>{c.name}</option>
          ))}
        </select>

        <select name="availability" class="filter-select" onchange="this.form.submit()">
          <option value="all" selected={availabilityFilter === 'all'}>All Channels</option>
          <option value="online" selected={availabilityFilter === 'online'}>Available Online</option>
          <option value="offline" selected={availabilityFilter === 'offline'}>Not Available Online</option>
        </select>

        <select name="sort" class="filter-select" onchange="this.form.submit()">
          <option value="name_asc" selected={sortBy === 'name_asc'}>Name (A-Z)</option>
          <option value="name_desc" selected={sortBy === 'name_desc'}>Name (Z-A)</option>
          <option value="price_asc" selected={sortBy === 'price_asc'}>Price (Low to High)</option>
          <option value="price_desc" selected={sortBy === 'price_desc'}>Price (High to Low)</option>
          <option value="stock_asc" selected={sortBy === 'stock_asc'}>Stock (Low to High)</option>
          <option value="stock_desc" selected={sortBy === 'stock_desc'}>Stock (High to Low)</option>
          <option value="updated_desc" selected={sortBy === 'updated_desc'}>Recently Updated</option>
        </select>

        <button type="submit" class="btn-filter">Filter</button>
        {(search || statusFilter !== 'all' || collectionFilter !== 'all' || availabilityFilter !== 'all' || sortBy !== 'name_asc') && (
          <a href="/crm/products" class="btn-reset">Reset</a>
        )}
      </form>
    </div>

    <!-- Products Table -->
    <div class="table-card">
      <div class="table-container">
        <table class="products-table">
          <thead>
            <tr>
              <th style="width: 60px;">Image</th>
              <th>Product Details</th>
              <th>Collection</th>
              <th>Selling Price</th>
              <th>Stock Quantity</th>
              <th>Stock Status</th>
              <th>Availability</th>
              <th>Last Updated</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {paginatedProducts.length === 0 ? (
              <tr>
                <td colspan="9" class="empty-state-cell">
                  <p class="empty-title">No products found</p>
                  <p class="empty-desc">Try clearing or adjusting your search filters.</p>
                </td>
              </tr>
            ) : (
              paginatedProducts.map((p) => (
                <tr id={`prod-row-${p.id}`}>
                  <td>
                    <img 
                      src={p.imageUrl} 
                      alt={p.name} 
                      class="product-thumb" 
                      loading="lazy" 
                      onerror="this.src='/placeholder-product.png'"
                    />
                  </td>
                  <td>
                    <div class="prod-identity">
                      <a href={`/crm/products/${p.id}`} class="prod-name-link">{p.name}</a>
                      <span class="prod-sku">SKU: {p.sku}</span>
                    </div>
                  </td>
                  <td>
                    <span class="category-tag">{p.collectionName}</span>
                    {p.subcategoryName && <small class="subcat-text">{p.subcategoryName}</small>}
                  </td>
                  <td>
                    <span class="price-val">{p.sellingPrice > 0 ? `₹${p.sellingPrice.toLocaleString('en-IN')}` : 'Price on Request'}</span>
                  </td>
                  <td>
                    <div class="stock-display">
                      <span class="stock-number" id={`stock-val-${p.id}`}>{p.stock}</span>
                      <small class="variant-info">{p.variants.length} variant(s)</small>
                    </div>
                  </td>
                  <td>
                    <span class={`status-pill ${p.stockStatus.toLowerCase().replace(/\s+/g, '-')}`} id={`status-pill-${p.id}`}>
                      {p.stockStatus}
                    </span>
                  </td>
                  <td>
                    {p.isOnline ? (
                      <span class="avail-badge online">● Available Online</span>
                    ) : (
                      <span class="avail-badge offline">○ Store / Gated</span>
                    )}
                  </td>
                  <td>
                    <span class="date-text">{new Date(p.updatedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
                  </td>
                  <td style="text-align: right;">
                    <div class="row-action-btns">
                      <button 
                        type="button" 
                        class="btn-manage-stock" 
                        data-product={JSON.stringify(p)}
                        onclick="openStockModal(this)"
                      >
                        Manage Stock
                      </button>
                      <a href={`/crm/products/${p.id}`} class="btn-edit-link" title="Full Product Editor">
                        Edit
                      </a>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      {totalPages > 1 && (
        <div class="pagination-bar">
          <span class="pagination-info">
            Showing {(currentPage - 1) * pageSize + 1} to {Math.min(currentPage * pageSize, totalFiltered)} of {totalFiltered} products
          </span>
          <div class="pagination-links">
            {currentPage > 1 && (
              <a href={`/crm/products?page=${currentPage - 1}&q=${search}&status=${statusFilter}&collection=${collectionFilter}&availability=${availabilityFilter}&sort=${sortBy}`} class="page-link">
                &larr; Previous
              </a>
            )}
            <span class="current-page-num">Page {currentPage} of {totalPages}</span>
            {currentPage < totalPages && (
              <a href={`/crm/products?page=${currentPage + 1}&q=${search}&status=${statusFilter}&collection=${collectionFilter}&availability=${availabilityFilter}&sort=${sortBy}`} class="page-link">
                Next &rarr;
              </a>
            )}
          </div>
        </div>
      )}
    </div>

    <!-- Manage Stock Modal / Drawer -->
    <div id="stock-modal" class="modal-overlay" hidden>
      <div class="modal-card">
        <div class="modal-head">
          <div>
            <h2 class="modal-title" id="modal-product-name">Product Name</h2>
            <span class="modal-sku" id="modal-product-sku">SKU: ---</span>
          </div>
          <button type="button" class="modal-close-btn" onclick="closeStockModal()">&times;</button>
        </div>

        <div class="modal-body">
          <div class="modal-status-overview">
            <div class="overview-item">
              <span class="lbl">Current Stock:</span>
              <span class="val" id="modal-current-stock">0</span>
            </div>
            <div class="overview-item">
              <span class="lbl">Stock Status:</span>
              <span class="val" id="modal-stock-status">IN STOCK</span>
            </div>
            <div class="overview-item">
              <span class="lbl">Low Stock Threshold:</span>
              <span class="val">5 units</span>
            </div>
            <div class="overview-item">
              <span class="lbl">Channel:</span>
              <span class="val" id="modal-channel-avail">Online</span>
            </div>
          </div>

          <!-- Variant Selector (if multi-variant) -->
          <div id="modal-variant-selector-wrap" class="variant-select-box" hidden>
            <label for="modal-variant-select" class="field-label">Select Variant to Adjust:</label>
            <select id="modal-variant-select" class="admin-select" onchange="onVariantChanged()">
            </select>
          </div>

          <!-- Interactive Actions Tabs -->
          <div class="action-tabs">
            <button type="button" class="tab-btn active" data-tab="adjust" onclick="switchTab('adjust')">Quick Adjust (±)</button>
            <button type="button" class="tab-btn" data-tab="set" onclick="switchTab('set')">Set Stock Quantity</button>
            <button type="button" class="tab-btn" data-tab="status-actions" onclick="switchTab('status-actions')">In/Out of Stock</button>
            <button type="button" class="tab-btn" data-tab="history" onclick="switchTab('history')">Audit History</button>
          </div>

          <!-- Tab 1: Quick Adjust -->
          <div id="tab-pane-adjust" class="tab-pane active">
            <div class="stepper-section">
              <span class="section-lead">Add or remove specific stock units:</span>
              <div class="stepper-controls">
                <button type="button" class="stepper-btn minus" onclick="stepQuantity(-1)">-</button>
                <input type="number" id="adjust-qty-input" value="1" min="1" class="stepper-input" />
                <button type="button" class="stepper-btn plus" onclick="stepQuantity(1)">+</button>
              </div>
              <div class="stepper-actions">
                <button type="button" class="btn-action-add" onclick="submitStockChange('ADD')">
                  + Add Stock
                </button>
                <button type="button" class="btn-action-remove" onclick="submitStockChange('REMOVE')">
                  - Remove Stock
                </button>
              </div>
            </div>
          </div>

          <!-- Tab 2: Set Quantity -->
          <div id="tab-pane-set" class="tab-pane" hidden>
            <div class="set-section">
              <label for="set-qty-input" class="field-label">Exact Inventory Count:</label>
              <div class="set-input-row">
                <input type="number" id="set-qty-input" min="0" placeholder="e.g. 25" class="admin-input" />
                <button type="button" class="btn-action-set" onclick="submitStockChange('SET')">
                  Set Exact Quantity
                </button>
              </div>
              <small class="helper-text">This will immediately overwrite the current stock balance and record a <code>STOCK_SET</code> audit entry.</small>
            </div>
          </div>

          <!-- Tab 3: Status Actions (Mark In / Out of Stock) -->
          <div id="tab-pane-status-actions" class="tab-pane" hidden>
            <div class="status-action-box">
              <div class="status-action-row">
                <div>
                  <strong>Mark Out of Stock</strong>
                  <p>Instantly sets stock quantity to 0 and flags item as Out of Stock.</p>
                </div>
                <button type="button" class="btn-action-danger" onclick="submitStockChange('MARK_OUT_OF_STOCK')">
                  Mark Out of Stock (0)
                </button>
              </div>

              <div class="status-action-divider"></div>

              <div class="status-action-row">
                <div>
                  <strong>Mark In Stock</strong>
                  <p>Restores item to In Stock with verified actual quantity.</p>
                </div>
                <div class="in-stock-entry-group">
                  <input type="number" id="in-stock-qty" min="1" value="10" placeholder="Qty" class="in-stock-input" />
                  <button type="button" class="btn-action-primary" onclick="submitStockChange('MARK_IN_STOCK')">
                    Confirm &amp; Set In Stock
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Tab 4: Audit History -->
          <div id="tab-pane-history" class="tab-pane" hidden>
            <div class="history-list-wrap">
              <div id="history-loading" class="history-loading" hidden>Loading inventory movement history...</div>
              <table class="history-table" id="history-table">
                <thead>
                  <tr>
                    <th>Date &amp; Time</th>
                    <th>Action / Reason</th>
                    <th>Change</th>
                    <th>Balance</th>
                    <th>Actor / Order</th>
                  </tr>
                </thead>
                <tbody id="history-tbody">
                  <tr><td colspan="5" style="text-align: center; color: var(--ink-soft);">Click tab to view transactions.</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Feedback alerts -->
          <div id="modal-error-alert" class="alert-error" hidden></div>
          <div id="modal-success-alert" class="alert-success" hidden></div>
        </div>

        <div class="modal-foot">
          <button type="button" class="btn-modal-done" onclick="closeStockModal()">Close</button>
        </div>
      </div>
    </div>

  </div>
</AdminLayout>

<script>
  let activeProduct: any = null;
  let activeVariantId: number | null = null;

  (window as any).openStockModal = (btn: HTMLElement) => {
    const raw = btn.getAttribute('data-product');
    if (!raw) return;
    activeProduct = JSON.parse(raw);
    
    // Populate header & overview
    (document.getElementById('modal-product-name') as HTMLElement).textContent = activeProduct.name;
    (document.getElementById('modal-product-sku') as HTMLElement).textContent = `SKU: ${activeProduct.sku}`;
    (document.getElementById('modal-current-stock') as HTMLElement).textContent = String(activeProduct.stock);
    (document.getElementById('modal-stock-status') as HTMLElement).textContent = activeProduct.stockStatus;
    (document.getElementById('modal-channel-avail') as HTMLElement).textContent = activeProduct.isOnline ? 'Available Online' : 'Store / Gated';

    // Variant selector setup
    const varSelectorWrap = document.getElementById('modal-variant-selector-wrap') as HTMLElement;
    const varSelect = document.getElementById('modal-variant-select') as HTMLSelectElement;
    varSelect.innerHTML = '';

    if (activeProduct.variants && activeProduct.variants.length > 0) {
      activeProduct.variants.forEach((v: any) => {
        const opt = document.createElement('option');
        opt.value = String(v.id);
        const label = [v.size, v.colour, v.sku ? `(${v.sku})` : ''].filter(Boolean).join(' - ') || `Variant #${v.id}`;
        opt.textContent = `${label} — Stock: ${v.stock}`;
        varSelect.appendChild(opt);
      });
      activeVariantId = activeProduct.variants[0].id;
      varSelectorWrap.hidden = activeProduct.variants.length <= 1;
    } else {
      activeVariantId = null;
      varSelectorWrap.hidden = true;
    }

    // Reset forms & alerts
    (document.getElementById('adjust-qty-input') as HTMLInputElement).value = '1';
    (document.getElementById('set-qty-input') as HTMLInputElement).value = String(activeProduct.stock);
    hideAlerts();
    (window as any).switchTab('adjust');

    (document.getElementById('stock-modal') as HTMLElement).hidden = false;
  };

  (window as any).closeStockModal = () => {
    (document.getElementById('stock-modal') as HTMLElement).hidden = true;
  };

  (window as any).onVariantChanged = () => {
    const varSelect = document.getElementById('modal-variant-select') as HTMLSelectElement;
    activeVariantId = parseInt(varSelect.value, 10);
    const selected = activeProduct.variants.find((v: any) => v.id === activeVariantId);
    if (selected) {
      (document.getElementById('modal-current-stock') as HTMLElement).textContent = String(selected.stock);
      (document.getElementById('set-qty-input') as HTMLInputElement).value = String(selected.stock);
    }
  };

  (window as any).stepQuantity = (delta: number) => {
    const inp = document.getElementById('adjust-qty-input') as HTMLInputElement;
    const current = Math.max(1, parseInt(inp.value || '1', 10) + delta);
    inp.value = String(current);
  };

  (window as any).switchTab = (tabName: string) => {
    document.querySelectorAll('.action-tabs .tab-btn').forEach((b) => {
      b.classList.toggle('active', b.getAttribute('data-tab') === tabName);
    });

    ['adjust', 'set', 'status-actions', 'history'].forEach((t) => {
      const pane = document.getElementById(`tab-pane-${t}`);
      if (pane) pane.hidden = t !== tabName;
    });

    if (tabName === 'history') {
      loadInventoryHistory();
    }
  };

  function hideAlerts() {
    const err = document.getElementById('modal-error-alert');
    const succ = document.getElementById('modal-success-alert');
    if (err) err.hidden = true;
    if (succ) succ.hidden = true;
  }

  function showError(msg: string) {
    const err = document.getElementById('modal-error-alert');
    if (err) {
      err.textContent = msg;
      err.hidden = false;
    }
  }

  function showSuccess(msg: string) {
    const succ = document.getElementById('modal-success-alert');
    if (succ) {
      succ.textContent = msg;
      succ.hidden = false;
    }
  }

  (window as any).submitStockChange = async (mode: string) => {
    if (!activeProduct) return;
    hideAlerts();

    let quantity: number | undefined;

    if (mode === 'ADD' || mode === 'REMOVE') {
      quantity = parseInt((document.getElementById('adjust-qty-input') as HTMLInputElement).value || '1', 10);
      if (isNaN(quantity) || quantity <= 0) {
        showError('Please enter a valid positive quantity.');
        return;
      }
    } else if (mode === 'SET') {
      quantity = parseInt((document.getElementById('set-qty-input') as HTMLInputElement).value || '0', 10);
      if (isNaN(quantity) || quantity < 0) {
        showError('Stock quantity cannot be negative.');
        return;
      }
      if (quantity === 0 && !confirm('Are you sure you want to set stock to 0 (Out of Stock)?')) {
        return;
      }
    } else if (mode === 'MARK_OUT_OF_STOCK') {
      if (!confirm(`Are you sure you want to mark '${activeProduct.name}' out of stock?`)) {
        return;
      }
      quantity = 0;
    } else if (mode === 'MARK_IN_STOCK') {
      quantity = parseInt((document.getElementById('in-stock-qty') as HTMLInputElement).value || '10', 10);
      if (isNaN(quantity) || quantity <= 0) {
        showError('Please enter a positive stock quantity to mark in stock.');
        return;
      }
    }

    try {
      const res = await fetch(`/api/admin/products/${activeProduct.id}/inventory`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          variantId: activeVariantId,
          mode,
          quantity
        })
      });

      const data = await res.json();
      if (!res.ok || data.error) {
        showError(data.error || 'Failed to update inventory.');
        return;
      }

      showSuccess(`Stock successfully updated! New stock: ${data.newStock}`);
      
      // Update modal display
      activeProduct.stock = data.newStock;
      (document.getElementById('modal-current-stock') as HTMLElement).textContent = String(data.newStock);

      let newStatus = 'IN STOCK';
      if (data.newStock <= 0) newStatus = 'OUT OF STOCK';
      else if (data.newStock <= 5) newStatus = 'LOW STOCK';

      activeProduct.stockStatus = newStatus;
      (document.getElementById('modal-stock-status') as HTMLElement).textContent = newStatus;

      // Update background table row
      const stockEl = document.getElementById(`stock-val-${activeProduct.id}`);
      if (stockEl) stockEl.textContent = String(data.newStock);

      const pillEl = document.getElementById(`status-pill-${activeProduct.id}`);
      if (pillEl) {
        pillEl.textContent = newStatus;
        pillEl.className = `status-pill ${newStatus.toLowerCase().replace(/\s+/g, '-')}`;
      }

    } catch (err: any) {
      showError(err.message || 'Network error updating stock.');
    }
  };

  async function loadInventoryHistory() {
    if (!activeProduct) return;
    const loader = document.getElementById('history-loading');
    const tbody = document.getElementById('history-tbody');
    if (loader) loader.hidden = false;
    if (tbody) tbody.innerHTML = '';

    try {
      const res = await fetch(`/api/admin/products/${activeProduct.id}/inventory-history`);
      const data = await res.json();
      if (loader) loader.hidden = true;

      if (!res.ok || !data.success || !data.history || data.history.length === 0) {
        if (tbody) tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: var(--ink-soft); padding: 1.5rem;">No inventory history recorded yet.</td></tr>';
        return;
      }

      if (tbody) {
        tbody.innerHTML = data.history.map((h: any) => `
          <tr>
            <td><small>${new Date(h.createdAt).toLocaleString('en-IN')}</small></td>
            <td><code>${h.reason}</code></td>
            <td style="font-weight: 700; color: ${h.delta > 0 ? '#15803d' : '#b91c1c'};">${h.delta > 0 ? `+${h.delta}` : h.delta}</td>
            <td><strong>${h.balanceAfter}</strong></td>
            <td><small>${h.orderNumber || h.actorName || 'System'}</small></td>
          </tr>
        `).join('');
      }
    } catch (err) {
      if (loader) loader.hidden = true;
      if (tbody) tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #b91c1c;">Failed to load history.</td></tr>';
    }
  }
</script>

