---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { prisma } from '../../lib/db';
import { getSessionUser } from '../../lib/auth';

const user = await getSessionUser(Astro.request);
if (!user) {
  return Astro.redirect('/crm/login');
}

const now = new Date();
const nowIso = now.toISOString();
const currentMonthStart = new Date(now.getFullYear(), now.getMonth(), 1);
const nextMonthStart = new Date(now.getFullYear(), now.getMonth() + 1, 1);
const currentMonth = nowIso.substring(0, 7); // Keep for template display

// Parallelize all main CRM data fetching
const metricsStart = Date.now();
const [
  [
    totalCustomers,
    newCustomersMonth,
    totalEnquiries,
    openEnquiries,
    convertedMonth,
    overdueFollowups
  ],
  productDemandRaw,
  recentEnquiriesRaw,
  upcomingFollowupsRaw
] = await Promise.all([
  Promise.all([
    prisma.customers.count({ where: { deleted_at: null } }),
    prisma.customers.count({ where: { deleted_at: null, created_at: { gte: currentMonthStart, lt: nextMonthStart } } }),
    prisma.enquiries.count(),
    prisma.enquiries.count({ where: { status: { notIn: ['Converted', 'Lost'] } } }),
    prisma.enquiries.count({ where: { status: 'Converted', closed_at: { gte: currentMonthStart.toISOString(), lt: nextMonthStart.toISOString() } } }),
    prisma.followUps.count({ where: { status: 'PENDING', due_at: { lt: nowIso } } })
  ]),
  prisma.enquiries.groupBy({
    by: ['product_id'],
    _count: { id: true },
    orderBy: { _count: { id: 'desc' } },
    take: 5,
    where: { product_id: { not: null } }
  }),
  prisma.enquiries.findMany({
    orderBy: { created_at: 'desc' },
    take: 10,
    include: {
      customer: { select: { name: true, phone: true, email: true } }
    }
  }),
  prisma.followUps.findMany({
    where: { status: 'PENDING' },
    orderBy: { due_at: 'asc' },
    take: 5,
    include: { assignee: { select: { name: true } } }
  })
]);
console.log(`[PERF-CRM] main queries: ${Date.now() - metricsStart}ms`);

const productDemand = await Promise.all(
  productDemandRaw.map(async (pd) => {
    const product = await prisma.products.findUnique({ where: { id: pd.product_id! } });
    return {
      name: product?.name || 'Unknown',
      slug: product?.slug || '',
      shipping_class: product?.shipping_class || '',
      enquiry_count: pd._count.id
    };
  })
);

const prodIds = recentEnquiriesRaw.map((e: any) => e.product_id).filter(Boolean);
const dashProducts = await prisma.products.findMany({ where: { id: { in: prodIds as number[] } }, select: { id: true, name: true }});
const dashProductsMap = new Map(dashProducts.map((p: any) => [p.id, p]));

const recentEnquiries = recentEnquiriesRaw.map((e: any) => ({
  ...e,
  customer_name: e.customer?.name || '',
  phone: e.customer?.phone || '',
  customer_email: e.customer?.email || '',
  product_name: e.product_id ? dashProductsMap.get(e.product_id)?.name : null
}));

const upcomingFollowups = upcomingFollowupsRaw.map((f: any) => ({
  ...f,
  assignee_name: f.assignee?.name || null
}));
---

<AdminLayout title="CRM Lead & Enquiry Dashboard" activeNav="crm">
  <div class="crm-dashboard-container">
    <div class="dash-head">
      <div>
        <h1 class="dash-title">CRM Lead &amp; Enquiry Dashboard</h1>
        <p class="dash-sub">Welcome back, <b>{user.name}</b> ({user.role}). Tracking customer enquiries, demand rankings &amp; DPDP compliance.</p>
      </div>
    </div>

    <!-- 1. Real Data Metric Summary Cards Grid -->
    <div class="metrics-grid">
      <div class="metric-card">
        <span class="m-label">TOTAL CUSTOMERS</span>
        <span class="m-val">{totalCustomers > 0 ? totalCustomers : '0'}</span>
        <span class="m-sub">{totalCustomers === 0 ? 'No data available yet' : 'Deduplicated lead profiles'}</span>
      </div>

      <div class="metric-card highlight-new">
        <span class="m-label">OPEN ENQUIRIES</span>
        <span class="m-val">{openEnquiries > 0 ? openEnquiries : '0'}</span>
        <span class="m-sub">{openEnquiries === 0 ? 'No data available yet' : 'Requires sales response'}</span>
      </div>

      <div class="metric-card">
        <span class="m-label">NEW THIS MONTH</span>
        <span class="m-val">{newCustomersMonth > 0 ? newCustomersMonth : '0'}</span>
        <span class="m-sub">{newCustomersMonth === 0 ? 'No data available yet' : `Captured in ${currentMonth}`}</span>
      </div>

      <div class="metric-card">
        <span class="m-label">CONVERTED (THIS MONTH)</span>
        <span class="m-val">{convertedMonth > 0 ? convertedMonth : '0'}</span>
        <span class="m-sub">{convertedMonth === 0 ? 'No data available yet' : 'Closed opportunities'}</span>
      </div>

      <div class={`metric-card ${overdueFollowups > 0 ? 'highlight-alert' : ''}`}>
        <span class="m-label">OVERDUE FOLLOW-UPS</span>
        <span class="m-val">{overdueFollowups > 0 ? overdueFollowups : '0'}</span>
        <span class="m-sub">{overdueFollowups === 0 ? 'No data available yet' : 'Action required urgently'}</span>
      </div>
    </div>

    <!-- 2. Section: Product Demand Ranking (Client Homework Priority §6) -->
    <div class="demand-section-card">
      <div class="card-head">
        <h2>🔥 Enquiries by Product (Client Pricing Priority Ranking)</h2>
        <p>Highlights which products customers are actively requesting quotes for — directly informs pricing priority!</p>
      </div>
      {productDemand.length > 0 ? (
        <div class="demand-list">
          {productDemand.map((pd, idx) => (
            <div class="demand-item">
              <span class="demand-rank">#{idx + 1}</span>
              <div class="demand-info">
                <strong>{pd.name}</strong>
                <small>/{pd.slug} &middot; Class: {pd.shipping_class}</small>
              </div>
              <span class="demand-count">{pd.enquiry_count} Enquiries</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="empty-state-msg">No data available yet. Product demand rankings will appear as customers submit enquiries.</p>
      )}
    </div>

    <!-- 3. Section: Pipeline & Follow-ups Layout -->
    <div class="dash-grid-2">
      <!-- Enquiries Pipeline Table -->
      <div class="content-card">
        <div class="card-head">
          <h2>Recent Enquiries Pipeline</h2>
        </div>
        {recentEnquiries.length > 0 ? (
          <div class="table-scroll-container">
            <table class="crm-table">
              <thead>
                <tr>
                  <th>Customer</th>
                  <th>Product</th>
                  <th>Source</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                {recentEnquiries.map(e => (
                  <tr>
                    <td>
                      <strong>{e.customer_name}</strong>
                      <small>{e.phone}</small>
                    </td>
                    <td>{e.product_name || 'General Inquiry'}</td>
                    <td><span class="source-pill">{e.source}</span></td>
                    <td><span class="status-badge" data-status={e.status}>{e.status}</span></td>
                    <td>
                      <button class="btn-sm-action" data-enquiry-id={e.id} onclick={`updateEnquiryStatus(${e.id})`}>
                        Update &rarr;
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="empty-state-msg">No data available yet. Public quote requests will populate here automatically.</p>
        )}
      </div>

      <!-- Pending Follow-ups -->
      <div class="content-card">
        <div class="card-head">
          <h2>Pending &amp; Overdue Follow-ups</h2>
        </div>
        {upcomingFollowups.length > 0 ? (
          <div class="followup-list">
            {upcomingFollowups.map(f => (
              <div class="followup-item">
                <div class="fu-info">
                  <strong>Priority: {f.priority}</strong>
                  <p>{f.outcome || 'Follow-up with lead regarding quote proposal.'}</p>
                  <small>Due: {new Date(f.due_at).toLocaleString()}</small>
                </div>
                <button class="btn-complete-fu" onclick={`completeFollowup(${f.id})`}>Done</button>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-state-msg">No data available yet. No pending follow-up reminders.</p>
        )}
      </div>
    </div>
  </div>

  <dialog id="status-dialog" class="crm-dialog">
    <div class="dialog-content">
      <h3 class="dialog-title">Update Pipeline Status</h3>
      <p class="dialog-desc">Select the new status for this enquiry.</p>
      
      <div class="form-group">
        <label for="new-status-select">Status</label>
        <select id="new-status-select" class="crm-select">
          <option value="New">New</option>
          <option value="Contacted">Contacted</option>
          <option value="Qualified">Qualified</option>
          <option value="Quotation Sent">Quotation Sent</option>
          <option value="Negotiation">Negotiation</option>
          <option value="Converted">Converted</option>
          <option value="Lost">Lost</option>
        </select>
      </div>
      
      <div class="form-group" id="lost-reason-group" style="display: none;">
        <label for="lost-reason-input">Lost Reason <span class="req">*</span></label>
        <input type="text" id="lost-reason-input" class="crm-input" placeholder="Why was this lost?" />
      </div>

      <div class="dialog-actions">
        <button type="button" id="btn-cancel-status" class="btn-cancel">Cancel</button>
        <button type="button" id="btn-save-status" class="btn-save">Save Status</button>
      </div>
    </div>
  </dialog>

  <script is:inline>
    let currentEnquiryId = null;
    const dialog = document.getElementById('status-dialog');
    const select = document.getElementById('new-status-select');
    const lostGroup = document.getElementById('lost-reason-group');
    const lostInput = document.getElementById('lost-reason-input');

    select?.addEventListener('change', (e) => {
      if (e.target.value === 'Lost') {
        lostGroup.style.display = 'block';
      } else {
        lostGroup.style.display = 'none';
      }
    });

    window.updateEnquiryStatus = function(id) {
      currentEnquiryId = id;
      select.value = 'New';
      lostGroup.style.display = 'none';
      lostInput.value = '';
      dialog?.showModal();
    };

    document.getElementById('btn-cancel-status')?.addEventListener('click', () => {
      dialog?.close();
      currentEnquiryId = null;
    });

    document.getElementById('btn-save-status')?.addEventListener('click', async () => {
      if (!currentEnquiryId) return;
      const status = select.value;
      let lostReason = null;
      
      if (status === 'Lost') {
        lostReason = lostInput.value.trim();
        if (!lostReason) {
          alert('Transition to Lost cancelled: lost_reason is mandatory.');
          return;
        }
      }

      try {
        const res = await fetch(`/api/admin/enquiries/${currentEnquiryId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status, lostReason })
        });

        const json = await res.json();
        if (json.success) {
          dialog?.close();
          window.location.reload();
        } else {
          alert(`Error: ${json.error}`);
        }
      } catch (err) {
        alert('Network error occurred.');
      }
    });
  </script>
</AdminLayout>

<style>
  .crm-dashboard-container { padding: 0; font-family: var(--sans); color: var(--ink); }
  .dash-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
  .dash-title { font-family: var(--display); font-size: 1.6rem; font-weight: 700; color: var(--maroon-2); margin: 0 0 0.25rem 0; }
  .dash-sub { font-size: 0.88rem; color: var(--ink-soft); margin: 0; }

  .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .metric-card { background: var(--paper-2); border: 1px solid var(--line); border-radius: 6px; padding: 1.1rem; display: flex; flex-direction: column; }
  .metric-card.highlight-new { border-left: 4px solid var(--maroon); }
  .metric-card.highlight-alert { border-left: 4px solid var(--pink); background: var(--paper-3); }
  .m-label { font-size: 0.72rem; font-weight: 700; color: var(--ink-soft); letter-spacing: 0.05em; }
  .m-val { font-size: 1.8rem; font-weight: 800; color: var(--maroon-2); margin-block: 0.25rem; }
  .m-sub { font-size: 0.75rem; color: var(--ink-soft); }

  .demand-section-card { background: var(--paper-2); border: 1px solid var(--line); border-radius: 6px; padding: 1.25rem; margin-bottom: 1.5rem; }
  .card-head h2 { font-size: 1.1rem; font-weight: 700; color: var(--maroon-2); margin: 0 0 0.25rem 0; }
  .card-head p { font-size: 0.813rem; color: var(--ink-soft); margin: 0 0 1rem 0; }

  .demand-list { display: flex; flex-direction: column; gap: 0.6rem; }
  .demand-item { display: flex; align-items: center; justify-content: space-between; background: var(--paper-3); padding: 0.65rem 1rem; border-radius: 4px; border: 1px solid var(--line); }
  .demand-rank { font-weight: 800; font-size: 1.1rem; color: var(--maroon-2); margin-right: 1rem; }
  .demand-info { flex: 1; }
  .demand-info strong { display: block; font-size: 0.88rem; color: var(--ink); }
  .demand-info small { font-size: 0.75rem; color: var(--ink-soft); }
  .demand-count { background: var(--maroon); color: #fff; font-size: 0.781rem; font-weight: 600; padding: 0.25rem 0.65rem; border-radius: 999px; }

  .dash-grid-2 { display: grid; grid-template-columns: 1fr 380px; gap: 1.5rem; }
  .content-card { background: var(--paper-2); border: 1px solid var(--line); border-radius: 6px; padding: 1.25rem; }

  .empty-state-msg { text-align: center; color: var(--ink-soft); font-size: 0.88rem; padding: 2rem; background: var(--paper-3); border-radius: 4px; border: 1px dashed var(--line); }

  .crm-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-top: 0.75rem; }
  .crm-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--paper-3); color: var(--ink-soft); border-bottom: 1px solid var(--line); font-weight: 600; }
  .crm-table td { padding: 0.65rem 0.75rem; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .crm-table td strong { display: block; color: var(--ink); }
  .crm-table td small { font-size: 0.75rem; color: var(--ink-soft); }

  .source-pill { font-size: 0.72rem; background: var(--paper-3); color: var(--ink); padding: 0.2rem 0.5rem; border-radius: 3px; }
  .status-badge { font-size: 0.72rem; font-weight: 600; padding: 0.2rem 0.5rem; border-radius: 3px; background: var(--paper-3); color: var(--ink); }
  .status-badge[data-status="Converted"] { background: var(--maroon); color: #fff; }
  .status-badge[data-status="Lost"] { background: var(--pink); color: #fff; }

  .btn-sm-action { background: transparent; color: var(--maroon); border: 1px solid var(--line); font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 3px; cursor: pointer; }
  .btn-sm-action:hover { background: var(--paper-3); }

  /* Dialog Styles */
  .crm-dialog {
    border: none;
    border-radius: 12px;
    padding: 24px;
    width: 90%;
    max-width: 400px;
    background: var(--paper-2);
    color: var(--ink);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }
  .crm-dialog::backdrop {
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(2px);
  }
  .dialog-title {
    font-family: var(--display);
    font-size: 20px;
    margin: 0 0 8px 0;
    color: var(--maroon-2);
  }
  .dialog-desc {
    font-size: 14px;
    color: var(--ink-soft);
    margin: 0 0 20px 0;
  }
  .form-group {
    margin-bottom: 16px;
  }
  .form-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--ink);
  }
  .crm-select, .crm-input {
    width: 100%;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 14px;
  }
  .crm-select:focus, .crm-input:focus {
    outline: 2px solid var(--maroon);
    border-color: transparent;
  }
  .dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
  }
  .btn-cancel {
    padding: 8px 16px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .btn-cancel:hover {
    background: var(--paper-3);
    color: var(--ink);
  }
  .btn-save {
    padding: 8px 16px;
    background: var(--maroon);
    border: none;
    border-radius: 6px;
    color: #fff;
    font-weight: 500;
  }
  .btn-save:hover {
    background: var(--maroon-2);
  }
  .req { color: var(--pink); }

  /* Tablet */
  @media (max-width: 1023px) {
    .dash-grid-2 { grid-template-columns: 1fr; }
    .metrics-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .dash-head { flex-direction: column; gap: 0.35rem; }
    .dash-title { font-size: 1.5rem; }
    .metrics-grid { grid-template-columns: repeat(2, 1fr); gap: 0.65rem; }
    .metric-card { padding: 0.85rem; }
    .m-val { font-size: 1.5rem; }
    .content-card, .demand-section-card { padding: 1rem; }
    .demand-item { flex-wrap: wrap; gap: 0.5rem; }
    .demand-rank { font-size: 0.95rem; margin-right: 0.5rem; }
    .crm-table { min-width: 650px; }
  }

  @media (max-width: 440px) {
    .metrics-grid { grid-template-columns: 1fr; }
  }
</style>
