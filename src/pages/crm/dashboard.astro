---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { prisma } from '../../lib/db';
import { getSessionUser } from '../../lib/auth';

const userStart = Date.now();
const user = await getSessionUser(Astro.request);
console.log(`[PERF] getSessionUser: ${Date.now() - userStart}ms`);
if (!user) {
  return Astro.redirect('/crm/login');
}

import DashboardMetrics from '../../components/crm/DashboardMetrics.astro';
---

<AdminLayout title="CRM Lead & Enquiry Dashboard" activeNav="crm">
  <div class="crm-dashboard-container">
    <div class="dash-head">
      <div>
        <h1 class="dash-title">CRM Lead &amp; Enquiry Dashboard</h1>
        <p class="dash-sub">Welcome back, <b>{user.name}</b> ({user.role}). Tracking customer enquiries, demand rankings &amp; DPDP compliance.</p>
      </div>
    </div>

    <DashboardMetrics server:defer>
      <div slot="fallback" class="dashboard-loading">
        <svg class="spinner" viewBox="0 0 50 50">
          <circle cx="25" cy="25" r="20" fill="none" stroke="currentColor" stroke-width="4" stroke-dasharray="90, 150" stroke-dashoffset="0"></circle>
        </svg>
        <p>Loading dashboard metrics...</p>
      </div>
    </DashboardMetrics>
  </div>

  <dialog id="status-dialog" class="crm-dialog">
    <div class="dialog-content">
      <h3 class="dialog-title">Update Pipeline Status</h3>
      <p class="dialog-desc">Select the new status for this enquiry.</p>
      
      <div class="form-group">
        <label for="new-status-select">Status</label>
        <select id="new-status-select" class="crm-select">
          <option value="New">New</option>
          <option value="Contacted">Contacted</option>
          <option value="Qualified">Qualified</option>
          <option value="Quotation Sent">Quotation Sent</option>
          <option value="Negotiation">Negotiation</option>
          <option value="Converted">Converted</option>
          <option value="Lost">Lost</option>
        </select>
      </div>
      
      <div class="form-group" id="lost-reason-group" style="display: none;">
        <label for="lost-reason-input">Lost Reason <span class="req">*</span></label>
        <input type="text" id="lost-reason-input" class="crm-input" placeholder="Why was this lost?" />
      </div>

      <div class="dialog-actions">
        <button type="button" id="btn-cancel-status" class="btn-cancel">Cancel</button>
        <button type="button" id="btn-save-status" class="btn-save">Save Status</button>
      </div>
    </div>
  </dialog>

  <script is:inline>
    let currentEnquiryId = null;
    const dialog = document.getElementById('status-dialog');
    const select = document.getElementById('new-status-select');
    const lostGroup = document.getElementById('lost-reason-group');
    const lostInput = document.getElementById('lost-reason-input');

    select?.addEventListener('change', (e) => {
      if (e.target.value === 'Lost') {
        lostGroup.style.display = 'block';
      } else {
        lostGroup.style.display = 'none';
      }
    });

    window.updateEnquiryStatus = function(id) {
      currentEnquiryId = id;
      select.value = 'New';
      lostGroup.style.display = 'none';
      lostInput.value = '';
      dialog?.showModal();
    };

    document.getElementById('btn-cancel-status')?.addEventListener('click', () => {
      dialog?.close();
      currentEnquiryId = null;
    });

    document.getElementById('btn-save-status')?.addEventListener('click', async () => {
      if (!currentEnquiryId) return;
      const status = select.value;
      let lostReason = null;
      
      if (status === 'Lost') {
        lostReason = lostInput.value.trim();
        if (!lostReason) {
          alert('Transition to Lost cancelled: lost_reason is mandatory.');
          return;
        }
      }

      try {
        const res = await fetch(`/api/admin/enquiries/${currentEnquiryId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status, lostReason })
        });

        const json = await res.json();
        if (json.success) {
          dialog?.close();
          window.location.reload();
        } else {
          alert(`Error: ${json.error}`);
        }
      } catch (err) {
        alert('Network error occurred.');
      }
    });
  </script>
</AdminLayout>

<style is:global>
  /* Global Dashboard Shell Overrides */
  .crm-dashboard-container { 
    padding: 24px;
    font-family: var(--sans);
    color: var(--ink);
    max-width: var(--max-w);
    margin: 0 auto;
    width: 100%;
  }
  
  .dash-head { 
    margin-bottom: 24px;
  }
  
  .dash-title { 
    font-family: var(--display);
    font-size: 28px; 
    font-weight: 700; 
    color: var(--maroon-2); 
    margin: 0 0 4px 0; 
    letter-spacing: -0.01em;
  }
  
  .dash-sub { 
    font-size: 14px; 
    color: var(--ink-soft); 
    margin: 0; 
  }

  /* Loading State */
  .dashboard-loading {
    padding: 40px;
    text-align: center;
    color: var(--ink-soft);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  
  /* Dialog Styles */
  .crm-dialog {
    border: none;
    border-radius: 12px;
    padding: 24px;
    width: 90%;
    max-width: 400px;
    background: var(--paper-2);
    color: var(--ink);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }
  .crm-dialog::backdrop {
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(2px);
  }
  .dialog-title {
    font-family: var(--display);
    font-size: 20px;
    margin: 0 0 8px 0;
    color: var(--maroon-2);
  }
  .dialog-desc {
    font-size: 14px;
    color: var(--ink-soft);
    margin: 0 0 20px 0;
  }
  .form-group {
    margin-bottom: 16px;
  }
  .form-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--ink);
  }
  .crm-select, .crm-input {
    width: 100%;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 14px;
  }
  .crm-select:focus, .crm-input:focus {
    outline: 2px solid var(--maroon);
    border-color: transparent;
  }
  .dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
  }
  .btn-cancel {
    padding: 8px 16px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .btn-cancel:hover {
    background: var(--paper-3);
    color: var(--ink);
  }
  .btn-save {
    padding: 8px 16px;
    background: var(--maroon);
    border: none;
    border-radius: 6px;
    color: #fff;
    font-weight: 500;
  }
  .btn-save:hover {
    background: var(--maroon-2);
  }
  .req { color: var(--pink); }
  .spinner {
    width: 32px;
    height: 32px;
    animation: rotate 2s linear infinite;
    color: var(--maroon-2);
  }
  .spinner circle {
    stroke-linecap: round;
    animation: dash 1.5s ease-in-out infinite;
  }
  @keyframes rotate { 100% { transform: rotate(360deg); } }
  @keyframes dash {
    0% { stroke-dasharray: 1, 150; stroke-dashoffset: 0; }
    50% { stroke-dasharray: 90, 150; stroke-dashoffset: -35; }
    100% { stroke-dasharray: 90, 150; stroke-dashoffset: -124; }
  }

  @media (max-width: 767px) {
    .crm-dashboard-container { padding: 16px; }
    .dash-head { margin-bottom: 16px; }
  }
</style>
