---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { prisma } from '../../lib/db';
import { getSessionUser } from '../../lib/auth';

const userStart = Date.now();
const user = await getSessionUser(Astro.request);
console.log(`[PERF] getSessionUser: ${Date.now() - userStart}ms`);
if (!user) {
  return Astro.redirect('/crm/login');
}

import DashboardMetrics from '../../components/crm/DashboardMetrics.astro';
---

<AdminLayout title="CRM Lead & Enquiry Dashboard" activeNav="crm">
  <div class="crm-dashboard-container">
    <div class="dash-head">
      <div>
        <h1 class="dash-title">CRM Lead &amp; Enquiry Dashboard</h1>
        <p class="dash-sub">Welcome back, <b>{user.name}</b> ({user.role}). Tracking customer enquiries, demand rankings &amp; DPDP compliance.</p>
      </div>
    </div>

    <DashboardMetrics server:defer>
      <div slot="fallback" class="dashboard-loading">
        <svg class="spinner" viewBox="0 0 50 50">
          <circle cx="25" cy="25" r="20" fill="none" stroke="currentColor" stroke-width="4" stroke-dasharray="90, 150" stroke-dashoffset="0"></circle>
        </svg>
        <p>Loading dashboard metrics...</p>
      </div>
    </DashboardMetrics>
  </div>
</AdminLayout>

<script is:inline>
  async function updateEnquiryStatus(id) {
    const status = prompt('Enter new pipeline status (New, Contacted, Qualified, Quotation Sent, Negotiation, Converted, Lost):');
    if (!status) return;
    
    let lostReason = null;
    if (status === 'Lost') {
      lostReason = prompt('Lost Reason is mandatory when marking Lost:');
      if (!lostReason) {
        alert('Transition to Lost cancelled: lost_reason is mandatory.');
        return;
      }
    }

    const res = await fetch(`/api/admin/enquiries/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status, lostReason })
    });

    const json = await res.json();
    if (json.success) {
      alert('Status updated successfully!');
      window.location.reload();
    } else {
      alert(`Error: ${json.error}`);
    }
  }
</script>

<style is:global>
  /* Global Dashboard Shell Overrides */
  .crm-dashboard-container { 
    padding: 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #1e293b;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }
  
  .dash-head { 
    margin-bottom: 24px;
  }
  
  .dash-title { 
    font-size: 24px; 
    font-weight: 600; 
    color: #0f172a; 
    margin: 0 0 4px 0; 
    letter-spacing: -0.01em;
  }
  
  .dash-sub { 
    font-size: 14px; 
    color: #64748b; 
    margin: 0; 
  }

  /* Loading State */
  .dashboard-loading {
    padding: 40px;
    text-align: center;
    color: #94a3b8;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }
  .spinner {
    width: 32px;
    height: 32px;
    animation: rotate 2s linear infinite;
    color: #cbd5e1;
  }
  .spinner circle {
    stroke-linecap: round;
    animation: dash 1.5s ease-in-out infinite;
  }
  @keyframes rotate { 100% { transform: rotate(360deg); } }
  @keyframes dash {
    0% { stroke-dasharray: 1, 150; stroke-dashoffset: 0; }
    50% { stroke-dasharray: 90, 150; stroke-dashoffset: -35; }
    100% { stroke-dasharray: 90, 150; stroke-dashoffset: -124; }
  }

  @media (max-width: 767px) {
    .crm-dashboard-container { padding: 16px; }
    .dash-head { margin-bottom: 16px; }
  }
</style>
