---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import Modal from '../../components/Modal.astro';
import VariantSelector from '../../components/VariantSelector.astro';
import CandleCraftsmanship from '../../components/CandleCraftsmanship.astro';
import DesignCraftsmanshipHighlights from '../../components/DesignCraftsmanshipHighlights.astro';
import content from '../../../vinsho-content.json';
import { getAllProducts, getProductBySlug, getCollectionByKey, getSubcategoryByKey } from '../../utils/taxonomy';
import { getCommerceProductBySlug, evaluateProductPurchasability } from '../../lib/commerce';
import { isProductPurchasable } from '../../lib/purchasability';

export function getStaticPaths() {
  const products = getAllProducts();
  return products.map((product) => ({
    params: { slug: product.slug }
  }));
}

const { slug } = Astro.params;
const baseProduct = getProductBySlug(slug);

if (!baseProduct) {
  throw new Error(`Product not found: ${slug}`);
}

const commerceProduct = getCommerceProductBySlug(slug) || {
  ...baseProduct,
  collectionKey: baseProduct.collectionKey || 'decor',
  subcategoryKey: baseProduct.subcategoryKey || 'general',
  shippingClass: 'standard' as const,
  launchPhase: 1,
  sellableOnline: true,
  returnable: true,
  sku: null,
  mrp: null,
  sellingPrice: null,
  currency: 'INR',
  hsnCode: null,
  gstRate: null,
  netQuantity: null,
  packedWeightKg: null,
  packedDimensionsCm: { l: null, b: null, h: null },
  stock: null,
  variants: [],
  countryOfOrigin: 'India',
  manufacturerOrPacker: null,
  consumerCareContact: null,
  leadTimeDays: null,
  careInstructions: null
};

const isPurchasable = isProductPurchasable(baseProduct);
const isCandleProduct = 
  baseProduct.subcategoryKey === 'candles' || 
  baseProduct.collectionKey === 'candles' ||
  baseProduct.slug.includes('candle') || 
  baseProduct.name.toLowerCase().includes('candle');

const collection = getCollectionByKey(baseProduct.collectionKey);
const subcategory = getSubcategoryByKey(baseProduct.collectionKey, baseProduct.subcategoryKey);

const whatsappText = encodeURIComponent(`Hi VINSHO, I would like to enquire about "${baseProduct.name}" (${baseProduct.subcategory || baseProduct.subCategory || baseProduct.collection}).`);
const whatsappUrl = `https://wa.me/${content.brand.whatsapp}?text=${whatsappText}`;

const priceVal = baseProduct.price || commerceProduct.sellingPrice;
const formattedSellingPrice = isPurchasable && priceVal 
  ? `₹${priceVal.toLocaleString('en-IN')}`
  : 'Price on request';

const formattedMrp = isPurchasable && commerceProduct.mrp 
  ? `MRP: ₹${commerceProduct.mrp.toLocaleString('en-IN')}`
  : null;

// Dynamic watermark text calculation
const rawNameWords = baseProduct.name.toUpperCase().split(/\s+/);
const watermarkWords = rawNameWords.length >= 2 
  ? [rawNameWords[0], rawNameWords.slice(1).join(' ')]
  : [rawNameWords[0], (baseProduct.collection || baseProduct.mainCategory || 'VINSHO').toUpperCase()];

// Related products
const allProducts = getAllProducts();
const relatedProducts = allProducts
  .filter(p => p.slug !== slug && (p.collectionKey === baseProduct.collectionKey || p.subcategoryKey === baseProduct.subcategoryKey))
  .slice(0, 3);

// Category label
const categoryLabel = (baseProduct.subcategory || baseProduct.subCategory || baseProduct.collection || baseProduct.mainCategory || 'HOME DÉCOR').toUpperCase();

const displayHighlights = ((baseProduct as any).highlights && (baseProduct as any).highlights.length > 0)
  ? (baseProduct as any).highlights
  : (baseProduct.features || []);

const displayHighlightsTagline = (baseProduct as any).highlightsTagline || baseProduct.closing_line || baseProduct.closingLine || '';

const isHomeDecorOrFurnishing = 
  baseProduct.collectionKey === 'home-decor' || 
  baseProduct.collectionKey === 'home-furnishing' ||
  baseProduct.collection === 'Home Decor' ||
  baseProduct.collection === 'Home Furnishing' ||
  baseProduct.mainCategory === 'Home Decor' ||
  baseProduct.mainCategory === 'Home Furnishing' ||
  (baseProduct.collectionKey && baseProduct.collectionKey.includes('decor')) ||
  (baseProduct.collectionKey && baseProduct.collectionKey.includes('furnish'));

const showShippingDelivery = !isHomeDecorOrFurnishing;

const productImages = (baseProduct.images && baseProduct.images.length > 0)
  ? baseProduct.images
  : [baseProduct.image];
---

<Base title={`${baseProduct.name} — VINSHO Editorial`} description={baseProduct.description}>
  <div class="editorial-pdp-outer">
    <div class="editorial-pdp-canvas">
      
      <!-- Editorial Minimal Header -->
      <header class="pdp-editorial-header">
        <div class="pdp-header-left">
          <a href="/" class="pdp-brand-link" aria-label="VINSHO Home">
            <img src="/vinsho-logo-transparent.png" alt="VINSHO" class="pdp-header-logo" />
          </a>
        </div>
        <nav class="pdp-header-nav">
          <a href="/" class="pdp-nav-item">Home</a>
          <a href="/about" class="pdp-nav-item">About Us</a>
          <a href="/products" class="pdp-nav-item">Products</a>
          <a href="/collections" class="pdp-nav-item">Collections</a>
          <a href="/blog" class="pdp-nav-item">Blog</a>
          <a href="/contact" class="pdp-nav-item">Contact Us</a>
        </nav>
        <div class="pdp-header-right">
          <a href="/products" class="pdp-util-btn" aria-label="Search">
            <svg class="ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7"/>
              <path d="m20 20-3.5-3.5"/>
            </svg>
            <span class="util-txt">Search</span>
          </a>
          <button class="pdp-util-btn" id="pdp-cart-btn" aria-label="View Cart" type="button">
            <svg class="ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 7h12l-1 13H7L6 7Z"/>
              <path d="M9 7a3 3 0 0 1 6 0"/>
            </svg>
            <span class="util-txt">Cart</span>
            <span class="pdp-cart-badge" id="pdpCartN">0</span>
          </button>
          <a class="pdp-header-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            Enquire
          </a>
        </div>
      </header>

      <!-- Category Label Header -->
      <div class="pdp-category-breadcrumb">
        <span class="lbl-prefix">COLLECTION</span>
        <span class="lbl-divider">&bull;</span>
        <span class="lbl-cat">{categoryLabel}</span>
      </div>

      <!-- Main 3-Column Editorial Hero Stage -->
      <section class="pdp-hero-stage">
        
        <!-- Large Background Watermark Typography -->
        <div class="pdp-watermark-bg" aria-hidden="true">
          <span class="wm-line1">{watermarkWords[0]}</span>
          {watermarkWords[1] && <span class="wm-line2">{watermarkWords[1]}</span>}
        </div>

        <div class="pdp-hero-grid">
          
          <!-- LEFT COLUMN: Product Primary Info & Buy Controls -->
          <div class="pdp-col-left">
            <div class="pdp-eyebrow">
              {baseProduct.subcategory || baseProduct.subCategory || 'CURATED ACCENT'}
            </div>

            <h1 class="pdp-title">{baseProduct.name}</h1>

            {baseProduct.tagline && baseProduct.tagline.trim() !== '' && (
              <p class="pdp-tagline">{baseProduct.tagline}</p>
            )}

            <div class="pdp-price-box">
              <div class="pdp-price-row">
                <span class="pdp-price" id="pdp-selling-price">{formattedSellingPrice}</span>
                {formattedMrp && <span class="pdp-mrp">{formattedMrp}</span>}
              </div>
              {isPurchasable && <span class="pdp-tax-note">Inclusive of all taxes &amp; GST</span>}
            </div>

            <!-- Multi-Variant Selector if purchasable -->
            {isPurchasable && commerceProduct.variants && commerceProduct.variants.length > 0 && (
              <VariantSelector 
                variants={commerceProduct.variants}
                defaultPrice={commerceProduct.sellingPrice}
                defaultMrp={commerceProduct.mrp}
              />
            )}

            <!-- Purchase / Quantity Controls -->
            {isPurchasable ? (
              <div class="pdp-buy-controls">
                <div class="pdp-qty-stepper">
                  <button type="button" class="qty-btn" id="pdp-qty-minus" aria-label="Decrease quantity">&minus;</button>
                  <span class="qty-val" id="pdp-qty-val">1</span>
                  <button type="button" class="qty-btn" id="pdp-qty-plus" aria-label="Increase quantity">+</button>
                </div>

                <div class="pdp-btn-stack">
                  <button class="pdp-btn-primary" id="pdp-add-cart-btn" data-slug={baseProduct.slug}>
                    ADD TO CART
                  </button>
                  <button class="pdp-btn-secondary" id="pdp-buy-now-btn" data-slug={baseProduct.slug}>
                    BUY NOW
                  </button>
                </div>
              </div>
            ) : (
              <div class="pdp-enquiry-controls">
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="pdp-btn-whatsapp">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                  </svg>
                  <span>Enquire on WhatsApp</span>
                </a>
                <button class="pdp-btn-quote" data-open={baseProduct.slug}>
                  Request Custom Quote
                </button>
              </div>
            )}
          </div>

          <!-- CENTER COLUMN: Floating Main Hero Product Image -->
          <div class="pdp-col-center">
            <div class="pdp-img-frame" id="pdp-gallery-frame">
              {productImages.length > 1 && (
                <button type="button" class="gallery-nav-btn prev-btn" id="pdp-prev-img" aria-label="Previous image">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
              )}

              <div class="pdp-slides-container">
                {productImages.map((imgUrl, index) => (
                  <img 
                    src={imgUrl} 
                    alt={`${baseProduct.name} - Image ${index + 1}`} 
                    class={`pdp-hero-img slide-img ${index === 0 ? 'active' : ''}`}
                    data-index={index}
                    id={index === 0 ? 'pdp-main-image' : undefined}
                    onerror="this.onerror=null; this.src='/images/candles/placeholder.svg';" 
                  />
                ))}
              </div>

              {productImages.length > 1 && (
                <button type="button" class="gallery-nav-btn next-btn" id="pdp-next-img" aria-label="Next image">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              )}
            </div>

            <div class="pdp-gallery-counter">
              <span id="pdp-gallery-counter-txt">
                01 &mdash; {String(productImages.length).padStart(2, '0')}
              </span>
            </div>

            {productImages.length > 1 && (
              <div class="pdp-thumb-strip">
                {productImages.map((imgUrl, index) => (
                  <button 
                    type="button" 
                    class={`pdp-thumb-btn ${index === 0 ? 'active' : ''}`} 
                    data-index={index}
                    aria-label={`View image ${index + 1}`}
                  >
                    <img src={imgUrl} alt={`Thumbnail ${index + 1}`} />
                  </button>
                ))}
              </div>
            )}
          </div>

          <!-- RIGHT COLUMN: DESIGN & CRAFTSMANSHIP HIGHLIGHTS -->
          <div class="pdp-col-right">
            <DesignCraftsmanshipHighlights 
              highlights={displayHighlights} 
              quote={displayHighlightsTagline} 
            />
          </div>
        </div>
      </section>

      <!-- Candle Craftsmanship & Care Section for Candle Products -->
      {isCandleProduct && (
        <CandleCraftsmanship />
      )}

      <!-- FULL-WIDTH PRODUCT INFORMATION SECTION (Description, Material & Details, Shipping & Delivery) -->
      <section class="pdp-full-info-section">
        <div class="pdp-info-accordions">
          {baseProduct.description && baseProduct.description.trim() !== '' && (
            <details class="pdp-acc-item" open>
              <summary class="pdp-acc-summary">
                <span>DESCRIPTION</span>
                <svg class="acc-ico" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <div class="pdp-acc-body">
                <p>{baseProduct.description}</p>
              </div>
            </details>
          )}

          <details class="pdp-acc-item">
            <summary class="pdp-acc-summary">
              <span>MATERIAL &amp; DETAILS</span>
              <svg class="acc-ico" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="pdp-acc-body">
              <div class="spec-grid">
                <div class="spec-row"><span>Material:</span> <strong>{baseProduct.material || 'Crafted Luxury Material'}</strong></div>
                <div class="spec-row"><span>Category:</span> <strong>{baseProduct.subcategory || baseProduct.subCategory}</strong></div>
                <div class="spec-row"><span>Shipping Class:</span> <strong style="text-transform: capitalize;">{commerceProduct.shippingClass}</strong></div>
                {commerceProduct.countryOfOrigin && (
                  <div class="spec-row"><span>Country of Origin:</span> <strong>{commerceProduct.countryOfOrigin}</strong></div>
                )}
                {commerceProduct.manufacturerOrPacker && (
                  <div class="spec-row"><span>Manufacturer / Packer:</span> <strong>{commerceProduct.manufacturerOrPacker}</strong></div>
                )}
              </div>
            </div>
          </details>

          {isCandleProduct && (
            <details class="pdp-acc-item">
              <summary class="pdp-acc-summary">
                <span>WAX &amp; FRAGRANCE CRAFTSMANSHIP</span>
                <svg class="acc-ico" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <div class="pdp-acc-body">
                <div class="spec-grid">
                  <div class="spec-row"><span>Wax Blend:</span> <strong>Pure Coconut-Soy / Soy-Beeswax</strong></div>
                  <div class="spec-row"><span>Fragrance:</span> <strong>Floral &amp; Botanical Compositions</strong></div>
                  <div class="spec-row"><span>Scent Throw:</span> <strong>Balanced Ambient Throw</strong></div>
                  <div class="spec-row"><span>Ambience:</span> <strong>Soothing &amp; Relaxing Atmosphere</strong></div>
                </div>
              </div>
            </details>
          )}

          {showShippingDelivery && (
            <details class="pdp-acc-item">
              <summary class="pdp-acc-summary">
                <span>SHIPPING &amp; DELIVERY</span>
                <svg class="acc-ico" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <div class="pdp-acc-body">
                <p>Complimentary shipping across India. Carefully packaged and dispatched with real-time tracking.</p>
              </div>
            </details>
          )}
        </div>
      </section>

      <!-- Related Products Strip -->
      {relatedProducts && relatedProducts.length > 0 && (
        <section class="pdp-related-section">
          <div class="related-header">
            <h3>MORE FROM THIS CURATION</h3>
            <a href={`/collections/${baseProduct.collectionKey}`} class="related-link">Explore Collection &rarr;</a>
          </div>
          <div class="related-grid">
            {relatedProducts.map((rel) => (
              <a href={`/product/${rel.slug}`} class="rel-card">
                <div class="rel-img-frame">
                  <img src={rel.image} alt={rel.name} class="rel-img" onerror="this.onerror=null; this.src='/images/candles/placeholder.svg';" />
                </div>
                <div class="rel-info">
                  <span class="rel-cat">{rel.subcategory || rel.subCategory || rel.collection}</span>
                  <h4 class="rel-title">{rel.name}</h4>
                  <span class="rel-price">{rel.price ? `₹${rel.price.toLocaleString('en-IN')}` : 'Price on request'}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </div>

  <!-- Mobile Fixed Bottom Action Bar (<= 767px) -->
  {isPurchasable ? (
    <div class="pdp-mobile-sticky-bar" id="pdp-mobile-sticky-bar">
      <button type="button" class="pdp-mobile-btn-primary" id="pdp-mobile-add-cart-btn" data-slug={baseProduct.slug}>
        ADD TO CART
      </button>
      <button type="button" class="pdp-mobile-btn-secondary" id="pdp-mobile-buy-now-btn" data-slug={baseProduct.slug}>
        BUY NOW
      </button>
    </div>
  ) : (
    <div class="pdp-mobile-sticky-bar pdp-mobile-sticky-bar-enquiry" id="pdp-mobile-sticky-bar">
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="pdp-mobile-btn-whatsapp">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
      <button type="button" class="pdp-mobile-btn-quote" data-open={baseProduct.slug}>
        Request Custom Quote
      </button>
    </div>
  )}

  <Footer />
  <Modal />
</Base>

<script>
  import { trackViewItem, trackAddToCart } from '../../lib/analytics';
  import { addLocalCartItem, openCartDrawer, getCartCount } from '../../scripts/cart-store';
  import { createWhatsAppOrderUrl } from '../../utils/whatsapp-order';

  document.addEventListener('DOMContentLoaded', () => {
    const slug = window.location.pathname.split('/').pop() || '';
    const nameEl = document.querySelector('.pdp-title');
    const name = nameEl?.textContent || 'Product';
    const img = (document.getElementById('pdp-main-image') as HTMLImageElement)?.src || '';
    const priceText = document.getElementById('pdp-selling-price')?.textContent || '0';
    const price = parseInt(priceText.replace(/[^\d]/g, ''), 10) || 0;

    trackViewItem({ slug, name });

    // Multi-Image Gallery Slider Logic
    const slides = document.querySelectorAll('.slide-img');
    const thumbs = document.querySelectorAll('.pdp-thumb-btn');
    const counterTxt = document.getElementById('pdp-gallery-counter-txt');
    const prevBtn = document.getElementById('pdp-prev-img');
    const nextBtn = document.getElementById('pdp-next-img');

    if (slides.length > 1) {
      let currentIndex = 0;

      const updateGallery = (newIndex: number) => {
        currentIndex = (newIndex + slides.length) % slides.length;
        
        slides.forEach((slide, idx) => {
          if (idx === currentIndex) {
            slide.classList.add('active');
          } else {
            slide.classList.remove('active');
          }
        });

        thumbs.forEach((thumb, idx) => {
          if (idx === currentIndex) {
            thumb.classList.add('active');
          } else {
            thumb.classList.remove('active');
          }
        });

        if (counterTxt) {
          const currentPadded = String(currentIndex + 1).padStart(2, '0');
          const totalPadded = String(slides.length).padStart(2, '0');
          counterTxt.innerHTML = `${currentPadded} &mdash; ${totalPadded}`;
        }
      };

      prevBtn?.addEventListener('click', () => updateGallery(currentIndex - 1));
      nextBtn?.addEventListener('click', () => updateGallery(currentIndex + 1));

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const index = parseInt(target.dataset.slideIndex || '0', 10);
          updateGallery(index);
        });
      });
    }

    // Quantity Stepper
    let qty = 1;
    const qtyMinusBtn = document.getElementById('pdp-qty-minus');
    const qtyPlusBtn = document.getElementById('pdp-qty-plus');
    const qtyValEl = document.getElementById('pdp-qty-val');
    const pdpCartBadge = document.getElementById('pdp-cart-badge');

    qtyMinusBtn?.addEventListener('click', () => {
      if (qty > 1) {
        qty--;
        if (qtyValEl) qtyValEl.textContent = String(qty);
      }
    });

    qtyPlusBtn?.addEventListener('click', () => {
      if (qty < 10) {
        qty++;
        if (qtyValEl) qtyValEl.textContent = String(qty);
      }
    });

    // Add To Cart
    const addCartBtn = document.getElementById('pdp-add-cart-btn');
    addCartBtn?.addEventListener('click', () => {
      trackAddToCart({ slug, name, quantity: qty });
      addLocalCartItem({
        slug,
        name,
        image: img,
        price,
        quantity: qty
      });
      if (pdpCartBadge) {
        pdpCartBadge.textContent = String(getCartCount());
      }
      openCartDrawer();
    });

    // Buy Now
    const buyNowBtn = document.getElementById('pdp-buy-now-btn');
    buyNowBtn?.addEventListener('click', () => {
      addLocalCartItem({
        slug,
        name,
        image: img,
        price,
        quantity: qty
      });
      if (pdpCartBadge) {
        pdpCartBadge.textContent = String(getCartCount());
      }
      const waUrl = createWhatsAppOrderUrl([{ name, price, quantity: qty }]);
      window.open(waUrl, '_blank');
    });

    // Mobile Sticky Add To Cart
    const mobileAddCartBtn = document.getElementById('pdp-mobile-add-cart-btn');
    mobileAddCartBtn?.addEventListener('click', () => {
      trackAddToCart({ slug, name, quantity: qty });
      addLocalCartItem({
        slug,
        name,
        image: img,
        price,
        quantity: qty
      });
      if (pdpCartBadge) {
        pdpCartBadge.textContent = String(getCartCount());
      }
      openCartDrawer();
    });

    // Mobile Sticky Buy Now
    const mobileBuyNowBtn = document.getElementById('pdp-mobile-buy-now-btn');
    mobileBuyNowBtn?.addEventListener('click', () => {
      addLocalCartItem({
        slug,
        name,
        image: img,
        price,
        quantity: qty
      });
      if (pdpCartBadge) {
        pdpCartBadge.textContent = String(getCartCount());
      }
      const waUrl = createWhatsAppOrderUrl([{ name, price, quantity: qty }]);
      window.open(waUrl, '_blank');
    });
  });
</script>

<style>
  /* ---------- OUTER MAROON BACKDROP (#8A174B) ---------- */
  .editorial-pdp-outer {
    background-color: #8A174B;
    background-image: none;
    padding: clamp(1rem, 2.5vw, 2.5rem);
    min-height: 100vh;
    width: 100%;
    box-sizing: border-box;
  }

  /* ---------- FLOATING LIGHT LUXURY CANVAS ---------- */
  .editorial-pdp-canvas {
    background: #FAF6F0;
    border-radius: clamp(16px, 2.5vw, 32px);
    border: 1px solid rgba(138, 23, 75, 0.12);
    box-shadow: 0 30px 90px rgba(50, 10, 20, 0.28);
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    position: relative;
    overflow: hidden;
  }

  /* ---------- EDITORIAL MINIMAL HEADER ---------- */
  .pdp-editorial-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(138, 23, 75, 0.08);
    margin-bottom: 1.5rem;
  }

  .pdp-header-left {
    display: flex;
    align-items: center;
  }

  .pdp-header-logo {
    height: 38px;
    width: auto;
    object-fit: contain;
  }

