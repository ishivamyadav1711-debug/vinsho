---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { cachePublicPage } from '../lib/http-cache';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import ShopCandlesGifts from '../components/ShopCandlesGifts.astro';
import CollectionsList from '../components/CollectionsList.astro';
import Lookbook from '../components/Lookbook.astro';
import UspStrip from '../components/UspStrip.astro';
import Statement from '../components/Statement.astro';
import NewsSection from '../components/NewsSection.astro';
import Footer from '../components/Footer.astro';
import Modal from '../components/Modal.astro';
import CustomCursor from '../components/motion/CustomCursor.astro';

// Public, nothing per-visitor on the server: let Vercel's edge cache it briefly.
cachePublicPage(Astro.response);
---

<Base>
  <CustomCursor />
  <Nav />
  <main id="main-content">
    <Hero />
    <Ticker />
    <ShopCandlesGifts />
    <CollectionsList />
    <Lookbook />
    <UspStrip />
    <Statement />
    <NewsSection />
  </main>
  <Footer />
  <Modal />
</Base>
