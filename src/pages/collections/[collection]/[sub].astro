---
export const prerender = true;

import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import TextReveal from '../../../components/motion/TextReveal.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Modal from '../../../components/Modal.astro';
import CandleCraftsmanship from '../../../components/CandleCraftsmanship.astro';
import { getCollections, getCollectionByKey, getSubcategoryByKey, getProductsBySubcategory, getSubcategoryProductCount } from '../../../utils/taxonomy';

export function getStaticPaths() {
  const collections = getCollections();
  const paths: { params: { collection: string; sub: string } }[] = [];

  collections.forEach((col) => {
    col.subcategories.forEach((sub) => {
      paths.push({
        params: { collection: col.key, sub: sub.key }
      });
      if (col.key === 'gifting-collection') {
        paths.push({ params: { collection: 'gifting', sub: sub.key } });
      }
      if (col.key === 'home-furnishing') {
        paths.push({ params: { collection: 'home-furnishings', sub: sub.key } });
      }
    });
  });

  return paths;
}

const { collection: collectionKey, sub: subKey } = Astro.params;

const collection = getCollectionByKey(collectionKey);
const subcategory = getSubcategoryByKey(collectionKey, subKey);

if (!collection || !subcategory) {
  throw new Error(`Subcategory not found: ${collectionKey}/${subKey}`);
}

const products = getProductsBySubcategory(collection.key, subcategory.key);
const totalCount = getSubcategoryProductCount(collection.key, subcategory.key);

const isCandleSub = subKey === 'candles' || collectionKey === 'candles' || subcategory.name.toLowerCase().includes('candle');

const breadcrumbItems = [
  { label: 'Home', url: '/' },
  { label: 'Collections', url: '/collections' },
  { label: collection.name, url: `/collections/${collection.key}` },
  { label: subcategory.name }
];
---

<Base title={`${subcategory.name} — ${collection.name} — VINSHO`} description={`Browse ${totalCount} pieces in ${subcategory.name} under ${collection.name} from VINSHO.`}>
  <Nav />
  <main id="main-content" class="wrap subcategory-single-page">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="subcategory-hero">
      <div class="sub-hero-top">
        <TextReveal as="h1">{subcategory.name}</TextReveal>
        <span class="sub-count-tag">{totalCount} pieces</span>
      </div>
      <p class="sub-blurb">{subcategory.blurb || collection.blurb}</p>

      <nav class="subcat-nav-bar" aria-label="Sub-categories">
        {collection.subcategories.map((sub) => {
          const subCount = getSubcategoryProductCount(collection.key, sub.key);
          const isActive = sub.key === subcategory.key;
          return (
            <a 
              href={`/collections/${collection.key}/${sub.key}`} 
              class={`sub-nav-pill ${isActive ? 'active' : ''}`}
            >
              {sub.name} <span class="sub-pill-num">({subCount})</span>
            </a>
          );
        })}
      </nav>
    </header>

    {products.length > 0 ? (
      <div class="grid">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    ) : (
      <div class="no-products-box">
        <p>No products currently found in {subcategory.name}.</p>
        <a href={`/collections/${collection.key}`} class="btn">View All {collection.name} &rarr;</a>
      </div>
    )}

    {isCandleSub && (
      <CandleCraftsmanship />
    )}
  </main>
  <Footer />
  <Modal />
</Base>

<style>
  .subcategory-single-page {
    padding-block: clamp(2rem, 4vw, 4rem);
  }

  .subcategory-hero {
    margin-block: 1rem 2.5rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 1.75rem;
  }

  .sub-hero-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .sub-hero-top h1 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    color: var(--maroon-2);
    margin: 0;
  }

  .sub-count-tag {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pink);
    font-weight: 600;
  }

  .sub-blurb {
    font-size: 1rem;
    color: var(--ink-soft);
    max-width: 44rem;
    margin: 0.5rem 0 1.5rem;
  }

  .subcat-nav-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .sub-nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--paper-3);
    color: var(--maroon-2);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.4rem 1rem;
    min-height: 44px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.22s ease;
  }

  .sub-nav-pill:hover,
  .sub-nav-pill.active {
    background: var(--maroon);
    color: #fff;
  }

  .sub-pill-num {
    opacity: 0.75;
    font-size: 0.781rem;
  }

  .no-products-box {
    text-align: center;
    padding: 3rem;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
</style>
