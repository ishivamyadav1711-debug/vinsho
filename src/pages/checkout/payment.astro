---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Modal from '../../components/Modal.astro';
import CustomCursor from '../../components/motion/CustomCursor.astro';
import { getCustomerFromSession } from '../../lib/customerAuth';

// Server-side Authentication Gate for Payment & Order Review (§2)
const customer = await getCustomerFromSession(Astro.request);
if (!customer) {
  return Astro.redirect('/login?redirect=/checkout/payment');
}
---

<Base 
  title="Checkout &mdash; Payment | VINSHO" 
  description="Review order details and pay securely with VINSHO."
>
  <CustomCursor />
  <Nav />

  <main id="main-content" class="v-checkout-page">
    <div class="v-checkout-container">
      <h1 class="v-checkout-title">REVIEW &amp; PLACE ORDER</h1>

      <div class="v-checkout-grid">
        <div class="v-checkout-left">
          <div class="v-summary-box">
            <h3>DELIVERY ADDRESS</h3>
            <div id="v-address-summary" class="v-box-body"></div>
          </div>

          <div class="v-summary-box">
            <h3>PAYMENT METHOD</h3>
            <div class="v-box-body">
              <strong>Online Payment (Razorpay)</strong>
              <p style="font-size: 0.813rem; color: #4b5563; margin-top: 0.25rem; margin-bottom: 0;">
                UPI, Credit/Debit Cards, NetBanking, and Wallets supported. 256-bit encrypted &amp; secure.
              </p>
            </div>
          </div>
        </div>

        <div class="v-checkout-right">
          <div class="v-summary-card">
            <h3>ORDER SUMMARY</h3>
            <div id="v-items-list" class="v-items-list"></div>

            <div class="v-divider"></div>

            <div class="v-total-row">
              <span>Total Amount:</span>
              <strong id="v-grand-total">₹0</strong>
            </div>

            <div id="v-pay-error" class="v-error-banner" hidden></div>

            <button type="button" id="v-place-order-btn" class="v-btn-place-order">
              PAY NOW &mdash; <span id="v-btn-amount">₹0</span>
            </button>
            <p class="v-support-text" style="font-size: 0.813rem; color: #6b7280; text-align: center; margin-top: 0.5rem; margin-bottom: 0;">
              🔒 100% Safe &amp; Secure Payment
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
  <Modal />
</Base>

<script>
  import { getLocalCartState, clearCart } from '../../scripts/cart-store';

  function loadRazorpayScript(): Promise<boolean> {
    return new Promise((resolve) => {
      if ((window as any).Razorpay) return resolve(true);
      const script = document.createElement('script');
      script.src = 'https://checkout.razorpay.com/v1/checkout.js';
      script.async = true;
      script.onload = () => resolve(true);
      script.onerror = () => resolve(false);
      document.body.appendChild(script);
    });
  }

  document.addEventListener('DOMContentLoaded', async () => {
    // Preload checkout script
    loadRazorpayScript().catch(() => {});

    const addrBox = document.getElementById('v-address-summary');
    const itemsBox = document.getElementById('v-items-list');
    const totalBox = document.getElementById('v-grand-total');
    const btnAmount = document.getElementById('v-btn-amount');
    const placeOrderBtn = document.getElementById('v-place-order-btn') as HTMLButtonElement | null;
    const errorBanner = document.getElementById('v-pay-error');

    function showError(msg: string) {
      if (errorBanner) {
        errorBanner.hidden = false;
        errorBanner.textContent = msg;
      }
      if (placeOrderBtn) {
        placeOrderBtn.disabled = false;
        placeOrderBtn.textContent = 'RETRY PAYMENT';
      }
    }

    let addressData: any = null;
    try {
      const raw = sessionStorage.getItem('vinsho_shipping_address');
      if (raw) addressData = JSON.parse(raw);
    } catch {
      addressData = null;
    }

    if (!addressData) {
      window.location.href = '/checkout/address';
      return;
    }

    if (addrBox) {
      addrBox.innerHTML = `
        <strong>${addressData.name}</strong> &middot; ${addressData.phone}<br/>
        ${addressData.line1}${addressData.line2 ? ', ' + addressData.line2 : ''}<br/>
        ${addressData.city}, ${addressData.state} &mdash; <strong>${addressData.pincode}</strong>
      `;
    }

    const state = getLocalCartState();

    if (state.items.length === 0) {
      window.location.href = '/cart';
      return;
    }

    if (itemsBox) {
      itemsBox.innerHTML = state.items.map(item => `
        <div class="v-item-row">
          <span>${item.name} &times; ${item.quantity}</span>
          <strong>₹${(item.price * item.quantity).toLocaleString('en-IN')}</strong>
        </div>
      `).join('');
    }

    const formattedTotal = `₹${state.subtotal.toLocaleString('en-IN')}`;
    if (totalBox) totalBox.textContent = formattedTotal;
    if (btnAmount) btnAmount.textContent = formattedTotal;

    placeOrderBtn?.addEventListener('click', async () => {
      const currentState = getLocalCartState();
      if (!currentState.items || currentState.items.length === 0) {
        window.location.href = '/cart';
        return;
      }

      if (errorBanner) errorBanner.hidden = true;
      placeOrderBtn.disabled = true;
      placeOrderBtn.textContent = 'INITIALIZING SECURE CHECKOUT...';

      const scriptLoaded = await loadRazorpayScript();
      if (!scriptLoaded || !(window as any).Razorpay) {
        showError('Could not load payment gateway. Please check your internet connection.');
        return;
      }

      const idempotencyKey = 'key_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);

      try {
        const orderPayload = {
          sessionToken: currentState.sessionToken,
          name: addressData.name,
          phone: addressData.phone,
          email: addressData.email,
          line1: addressData.line1,
          line2: addressData.line2 || '',
          city: addressData.city,
          state: addressData.state,
          pincode: addressData.pincode,
          country: addressData.country || 'India',
          idempotencyKey,
          couponCode: currentState.couponCode || null,
          items: currentState.items.map(i => ({
            variantId: i.variantId || 0,
            qty: i.quantity,
            sellingPrice: i.price,
            productName: i.name,
            size: i.variantTitle,
            sku: i.slug
          }))
        };

        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(orderPayload)
        });

        const checkoutData = await res.json();

        if (!res.ok || !checkoutData.success) {
          showError(checkoutData.error || 'Failed to create order. Please try again.');
          return;
        }

        placeOrderBtn.textContent = 'OPENING PAYMENT MODAL...';

        const rzpOptions = {
          key: checkoutData.razorpayKeyId,
          amount: Math.round(Number(checkoutData.grandTotal) * 100),
          currency: checkoutData.currency || 'INR',
          name: 'VINSHO',
          description: `Order #${checkoutData.orderNumber}`,
          order_id: checkoutData.razorpayOrderId,
          prefill: {
            name: addressData.name,
            contact: addressData.phone,
            email: addressData.email || ''
          },
          theme: {
            color: '#8A174B'
          },
          handler: async function (response: any) {
            placeOrderBtn.textContent = 'VERIFYING PAYMENT...';
            try {
              const verifyRes = await fetch('/api/checkout/verify-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  orderId: checkoutData.orderId,
                  orderNumber: checkoutData.orderNumber,
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_signature: response.razorpay_signature
                })
              });

              const verifyData = await verifyRes.json();

              if (verifyRes.ok && verifyData.success) {
                // Save confirmed order data for confirmation page
                sessionStorage.setItem('vinsho_last_placed_order', JSON.stringify({
                  orderNumber: checkoutData.orderNumber,
                  address: addressData,
                  items: currentState.items,
                  grandTotal: checkoutData.grandTotal
                }));

                // Clear cart state
                clearCart();

                window.location.href = `/checkout/confirmation?orderNumber=${encodeURIComponent(checkoutData.orderNumber)}`;
              } else {
                showError(verifyData.error || 'Payment verification failed. Please contact customer support.');
              }
            } catch (err: any) {
              showError('Network error while verifying payment. Please do not re-pay.');
            }
          },
          modal: {
            ondismiss: function () {
              placeOrderBtn.disabled = false;
              placeOrderBtn.innerHTML = `PAY NOW &mdash; ₹${Number(state.subtotal).toLocaleString('en-IN')}`;
            }
          }
        };

        const rzp = new (window as any).Razorpay(rzpOptions);
        rzp.on('payment.failed', function (resp: any) {
          showError(`Payment Failed: ${resp.error?.description || 'Transaction declined.'}`);
        });
        rzp.open();

      } catch (err: any) {
        showError(err.message || 'An unexpected error occurred. Please try again.');
      }
    });
  });
</script>

<style>
  .v-checkout-page {
    background-color: #FAF6F0;
    color: #3E3336;
    padding-block: clamp(2rem, 4vw, 4.5rem);
    min-height: 80vh;
  }

  .v-checkout-container {
    max-width: 900px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .v-checkout-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: #8A174B;
    margin-bottom: 1.5rem;
  }

  .v-checkout-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .v-checkout-grid {
      grid-template-columns: 1fr;
    }
  }

  .v-summary-box {
    background: #ffffff;
    border: 1px solid rgba(138, 23, 75, 0.12);
    border-radius: 8px;
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .v-summary-box h3 {
    font-size: 0.813rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #8A174B;
    margin: 0 0 0.75rem;
  }

  .v-box-body {
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .v-summary-card {
    background: #ffffff;
    border: 1px solid rgba(138, 23, 75, 0.12);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .v-summary-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    color: #8A174B;
    margin: 0 0 1rem;
  }

  .v-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .v-item-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
  }

  .v-divider {
    height: 1px;
    background: rgba(138, 23, 75, 0.12);
    margin-block: 1rem;
  }

  .v-total-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
  }

  .v-total-row strong {
    color: #8A174B;
  }

  .v-error-banner {
    background: #fee2e2;
    color: #991b1b;
    padding: 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .v-btn-place-order {
    width: 100%;
    padding: 0.95rem;
    background: #8A174B;
    color: #ffffff;
    border: none;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .v-btn-place-order:hover:not(:disabled) {
    background: #6e123b;
  }

  .v-btn-place-order:disabled {
    background: #9ca3af;
    cursor: not-allowed;
  }
</style>
