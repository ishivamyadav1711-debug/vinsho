  .order-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px dashed rgba(138, 23, 75, 0.12);
    padding-top: 0.85rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

