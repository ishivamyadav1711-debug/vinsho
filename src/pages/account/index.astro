    display: flex;
    flex-direction: column;
  }

  .total-lbl {
    font-size: 0.72rem;
    color: var(--ink-soft, #7C6B6E);
    text-transform: uppercase;
  }

  .total-val {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--maroon, #8A174B);
  }

  .view-ord-btn {
    background: #FAF6F0;
    color: #8A174B;
    border: 1px solid rgba(138, 23, 75, 0.15);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.781rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .view-ord-btn:hover {
    background: #8A174B;
    color: #ffffff;
  }

  /* ADDRESSES GRID */
  .addresses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .address-card {
    background: #ffffff;
    border: 1px solid rgba(138, 23, 75, 0.12);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .addr-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.65rem;
  }

  .addr-tag {
    font-size: 0.688rem;
    font-weight: 700;
    background: #8A174B;
    color: #fff;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .addr-lines {
    font-size: 0.844rem;
    color: var(--ink-soft, #7C6B6E);
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }

  .addr-phone {
    font-size: 0.813rem;
    font-weight: 600;
    color: var(--ink, #3E3336);
    margin: 0;
  }

  /* PROFILE CARD */
  .profile-card {
    background: #ffffff;
    border: 1px solid rgba(138, 23, 75, 0.12);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 540px;
  }

  .profile-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed rgba(138, 23, 75, 0.08);
    padding-bottom: 0.65rem;
  }

  .prof-lbl {
    font-size: 0.844rem;
    color: var(--ink-soft, #7C6B6E);
  }

  .prof-val {
    font-size: 0.875rem;
    color: var(--maroon, #8A174B);
  }
</style>
