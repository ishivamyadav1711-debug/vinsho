---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Forgot Password | VINSHO" description="Reset your VINSHO account password.">
  <Nav />

  <main class="auth-page-wrapper">
    <div class="auth-card-container wrap">
      <div class="auth-card">
        
        <div class="auth-header-group">
          <span class="auth-eyebrow">PASSWORD RECOVERY</span>
          <h1 class="auth-title">Forgot Your Password?</h1>
          <p class="auth-sub">Enter the email address associated with your account and we'll help you reset it.</p>
        </div>

        <div id="auth-alert" class="auth-alert-box" hidden></div>

        <form id="forgot-form" class="auth-form" novalidate>
          <div class="form-field">
            <label for="email" class="field-label">Email Address *</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="name@example.com" 
                required 
                autocomplete="email"
              />
            </div>
          </div>

          <button type="submit" id="forgot-btn" class="auth-submit-btn">
            SEND RESET LINK
          </button>
        </form>

        <div id="reset-token-box" class="dev-reset-token-box" hidden>
          <p><strong>Demo Reset Link Generated:</strong></p>
          <a id="demo-reset-link" href="#" class="demo-link">Reset Password Now &rarr;</a>
        </div>

        <div class="auth-footer-prompt" style="margin-top: 1.5rem;">
          <a href="/login" class="back-link">&larr; Back to Login</a>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Base>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('forgot-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('auth-alert');
    const submitBtn = document.getElementById('forgot-btn') as HTMLButtonElement | null;
    const resetTokenBox = document.getElementById('reset-token-box');
    const demoResetLink = document.getElementById('demo-reset-link') as HTMLAnchorElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const emailVal = (document.getElementById('email') as HTMLInputElement)?.value.trim();

      if (alertBox) {
        alertBox.hidden = true;
        alertBox.className = 'auth-alert-box';
      }
      if (resetTokenBox) resetTokenBox.hidden = true;

      if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
        if (alertBox) {
          alertBox.textContent = 'Please enter a valid email address.';
          alertBox.classList.add('error');
          alertBox.hidden = false;
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'SENDING…';
      }

      try {
        const res = await fetch('/api/account', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'forgot-password',
            email: emailVal
          })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          if (alertBox) {
            alertBox.textContent = data.message || 'Password reset link has been generated.';
            alertBox.classList.add('success');
            alertBox.hidden = false;
          }

          if (data.resetToken && demoResetLink && resetTokenBox) {
            demoResetLink.href = `/reset-password?token=${encodeURIComponent(data.resetToken)}`;
            resetTokenBox.hidden = false;
          }
        } else {
          if (alertBox) {
            alertBox.textContent = data.error || 'Failed to process request.';
            alertBox.classList.add('error');
            alertBox.hidden = false;
          }
        }
      } catch (err) {
        if (alertBox) {
          alertBox.textContent = 'Network error. Please try again.';
          alertBox.classList.add('error');
          alertBox.hidden = false;
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'SEND RESET LINK';
        }
      }
    });
  });
</script>

<style>
  .auth-page-wrapper {
    background-color: #FAF6F0;
    padding-block: clamp(2rem, 5vw, 4.5rem);
    min-height: 75vh;
    display: flex;
    align-items: center;
  }

  .auth-card-container {
    max-width: 480px;
    margin-inline: auto;
    width: 100%;
  }

  .auth-card {
    background: #ffffff;
    border: 1px solid rgba(138, 23, 75, 0.12);
    border-radius: 16px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 10px 35px rgba(138, 23, 75, 0.05);
  }

  .auth-header-group {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .auth-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--pink, #CD788F);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.35rem;
  }

  .auth-title {
    font-family: var(--serif, serif);
    font-size: clamp(1.5rem, 3.5vw, 1.95rem);
    color: var(--maroon, #8A174B);
    margin: 0 0 0.35rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .auth-sub {
    font-size: 0.844rem;
    color: var(--ink-soft, #7C6B6E);
    margin: 0;
  }

  .auth-alert-box {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.844rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .auth-alert-box.error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .auth-alert-box.success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-size: 0.813rem;
    font-weight: 600;
    color: var(--ink, #3E3336);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background: #FAF6F0;
    border: 1.5px solid rgba(138, 23, 75, 0.15);
    border-radius: 8px;
    padding-left: 0.85rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .input-wrapper:focus-within {
    border-color: var(--maroon, #8A174B);
    box-shadow: 0 0 0 3px rgba(138, 23, 75, 0.08);
  }

  .input-icon {
    color: var(--ink-soft, #7C6B6E);
    flex-shrink: 0;
  }

  .input-wrapper input {
    width: 100%;
    border: none;
    background: transparent;
    outline: none;
    padding: 0.75rem 0.85rem;
    font-size: 16px !important;
    color: var(--ink, #3E3336);
    font-family: var(--sans, sans-serif);
  }

  .auth-submit-btn {
    background: var(--maroon, #8A174B);
    color: #ffffff;
    border: 1.5px solid var(--maroon, #8A174B);
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    margin-top: 0.5rem;
    min-height: 46px;
    transition: all 0.2s ease;
    width: 100%;
  }

  .auth-submit-btn:hover:not(:disabled) {
    background: var(--maroon-2, #6B0E38);
    border-color: var(--maroon-2, #6B0E38);
  }

  .dev-reset-token-box {
    margin-top: 1.25rem;
    background: #fdf4ff;
    border: 1px dashed #d8b4fe;
    border-radius: 8px;
    padding: 0.85rem;
    text-align: center;
    font-size: 0.844rem;
  }

  .demo-link {
    color: #8A174B;
    font-weight: 700;
    text-decoration: underline;
    margin-top: 0.35rem;
    display: inline-block;
  }

  .back-link {
    color: var(--maroon, #8A174B);
    font-size: 0.844rem;
    font-weight: 600;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
