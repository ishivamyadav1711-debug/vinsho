---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';
import { requireSuperAdmin } from '../../lib/auth';

const authCheck = requireSuperAdmin(Astro.request);
if (!authCheck.allowed) {
  return Astro.redirect('/admin/crm');
}
const user = authCheck.user!;

const users = db.prepare('SELECT id, email, name, role, created_at FROM users ORDER BY name ASC').all() as any[];
---

<AdminLayout title="Team Settings & Permissions" activeNav="settings">
  <div class="settings-page-container">
    <div class="s-head">
      <h1 class="s-title">Team Settings &amp; Permissions</h1>
      <p class="s-sub">Manage CRM team user access, roles (ADMIN, SALES, STAFF), and system security.</p>
    </div>

    <div class="settings-grid">
      <!-- Create User Card -->
      <div class="s-card">
        <h2>Add Team Member</h2>
        <form id="create-user-form" class="u-form">
          <div class="f-group">
            <label>Full Name *</label>
            <input type="text" name="name" placeholder="e.g. Kavita Roy" required />
          </div>

          <div class="f-group">
            <label>Email Address *</label>
            <input type="email" name="email" placeholder="kavita@vinsho.com" required />
          </div>

          <div class="f-group">
            <label>Password *</label>
            <input type="password" name="password" placeholder="••••••••••••" required />
          </div>

          <div class="f-group">
            <label>Role &amp; Access Level *</label>
            <select name="role" required>
              <option value="SALES">SALES — View/update leads, follow-ups &amp; activities</option>
              <option value="STAFF">STAFF — Limited CRM view</option>
              <option value="ADMIN">ADMIN — Full CRM control &amp; team management</option>
            </select>
          </div>

          <p id="user-form-error" class="error-msg" hidden></p>
          <button type="submit" class="submit-btn">+ Create Team User</button>
        </form>
      </div>

      <!-- Users List Card -->
      <div class="s-card">
        <h2>Active Team Members ({users.length})</h2>
        <div class="users-list">
          {users.map((u) => (
            <div class="user-item-card">
              <div class="u-avatar">{u.name.charAt(0)}</div>
              <div class="u-info">
                <span class="u-name">{u.name}</span>
                <span class="u-email">{u.email}</span>
                <span class="u-date">Created {new Date(u.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
              </div>
              <span class={`role-pill role-${u.role.toLowerCase()}`}>{u.role}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('create-user-form') as HTMLFormElement | null;
  const errEl = document.getElementById('user-form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errEl) errEl.hidden = true;

    const formData = new FormData(form);
    const body = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();

      if (!res.ok || data.error) {
        if (errEl) {
          errEl.hidden = false;
          errEl.textContent = data.error || 'Failed to create user.';
        }
        return;
      }

      window.location.reload();
    } catch (err) {
      if (errEl) {
        errEl.hidden = false;
        errEl.textContent = 'Server connection error.';
      }
    }
  });
</script>

<style>
  .settings-page-container { display: flex; flex-direction: column; gap: 1.5rem; }
  .s-title { font-family: var(--display); font-size: 2rem; color: var(--maroon-2); margin: 0; }
  .s-sub { font-size: 0.88rem; color: var(--ink-soft); margin-top: 0.2rem; }

  .settings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; }
  .s-card { background: var(--paper-2); border: 1px solid var(--line); border-radius: 8px; padding: 1.5rem; }
  .s-card h2 { font-family: var(--display); font-size: 1.25rem; color: var(--maroon-2); margin: 0 0 1.25rem; border-bottom: 1px solid var(--line); padding-bottom: 0.5rem; }

  .u-form { display: flex; flex-direction: column; gap: 1rem; }
  .f-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .f-group label { font-size: 0.781rem; font-weight: 600; color: var(--maroon-2); }
  .f-group input, .f-group select { background: #ffffff; border: 1px solid var(--line); border-radius: 4px; padding: 0.6rem; font-size: 0.875rem; outline: none; }
  .error-msg { color: #b91c1c; font-size: 0.813rem; margin: 0; }
  .submit-btn { background: var(--maroon); color: #ffffff; border: none; padding: 0.7rem; border-radius: 999px; font-weight: 600; font-size: 0.813rem; cursor: pointer; }

  .users-list { display: flex; flex-direction: column; gap: 0.85rem; }
  .user-item-card { display: flex; align-items: center; gap: 0.85rem; background: #ffffff; border: 1px solid var(--line); padding: 0.85rem; border-radius: 6px; }
  .u-avatar { width: 40px; height: 40px; background: var(--maroon-2); color: #ffffff; font-weight: 700; border-radius: 50%; display: grid; place-items: center; font-size: 1.1rem; }
  .u-info { display: flex; flex-direction: column; flex: 1; }
  .u-name { font-weight: 700; color: var(--maroon-2); font-size: 0.9rem; }
  .u-email { font-size: 0.781rem; color: var(--ink); }
  .u-date { font-size: 0.72rem; color: var(--ink-soft); margin-top: 0.15rem; }

  .role-pill { font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; letter-spacing: 0.06em; }
  .role-admin { background: #fee2e2; color: #991b1b; }
  .role-sales { background: #dcfce7; color: #166534; }
  .role-staff { background: #e0f2fe; color: #075985; }

  @media (max-width: 900px) {
    .settings-grid { grid-template-columns: 1fr; }
  }
</style>
