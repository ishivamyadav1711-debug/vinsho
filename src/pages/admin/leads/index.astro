---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { prisma } from '../../../lib/db';
import { getSessionUser } from '../../../lib/auth';
import taxonomyData from '../../../../vinsho-taxonomy.json';

const user = await getSessionUser(Astro.request);
if (!user) {
  return Astro.redirect('/admin/login');
}

const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') || '').trim().toLowerCase();
const statusFilter = url.searchParams.get('status') || '';
const sourceFilter = url.searchParams.get('source') || '';
const sortFilter = url.searchParams.get('sort') || 'newest';

// Build Prisma where filter on customers table with status = 'Lead'
const where: any = {
  deleted_at: null,
  status: statusFilter ? statusFilter : 'Lead'
};

if (q) {
  where.OR = [
    { name: { contains: q, mode: 'insensitive' } },
    { email: { contains: q, mode: 'insensitive' } },
    { phone: { contains: q, mode: 'insensitive' } },
    { city: { contains: q, mode: 'insensitive' } }
  ];
}
if (sourceFilter) where.source = sourceFilter;

const orderByMap: Record<string, any> = {
  'oldest': { created_at: 'asc' },
  'name': { name: 'asc' },
  'last_contact': { updated_at: 'desc' },
  'newest': { created_at: 'desc' }
};
const orderBy = orderByMap[sortFilter] || { created_at: 'desc' };

const [leads, users] = await Promise.all([
  prisma.customers.findMany({
    where,
    orderBy,
    include: {
      Enquiries: {
        take: 1,
        orderBy: { created_at: 'desc' }
      }
    }
  }),
  prisma.adminUsers.findMany({ select: { id: true, name: true }, orderBy: { name: 'asc' } })
]);

const productIds = Array.from(new Set(leads.map(l => l.Enquiries?.[0]?.product_id).filter((pid): pid is number => typeof pid === 'number')));
const products = productIds.length > 0 ? await prisma.products.findMany({
  where: { id: { in: productIds } },
  select: { id: true, name: true, slug: true }
}) : [];
const productMap = new Map(products.map(p => [p.id, p]));

const collections = taxonomyData.collections;
---

<AdminLayout title="Lead Management" activeNav="leads">
  <div class="leads-page-container">
    <div class="leads-head-row">
      <div>
        <h1 class="leads-page-title">Lead Management</h1>
        <p class="leads-page-sub">Track, filter, assign and convert inquiries into clients.</p>
      </div>
      <button class="primary-btn" id="open-add-lead-btn">+ Create Manual Lead</button>
    </div>

    <!-- Filter & Search Controls Bar -->
    <div class="controls-card">
      <form method="GET" class="filter-form">
        <div class="search-input-frame">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="search" name="q" value={q} placeholder="Search name, email, phone, location..." class="search-field" />
        </div>

        <select name="status" class="filter-select">
          <option value="">All Leads</option>
          <option value="Lead" selected={statusFilter === 'Lead'}>Lead</option>
          <option value="New" selected={statusFilter === 'New'}>New</option>
          <option value="Active" selected={statusFilter === 'Active'}>Active</option>
          <option value="Repeat" selected={statusFilter === 'Repeat'}>Repeat</option>
          <option value="VIP" selected={statusFilter === 'VIP'}>VIP</option>
          <option value="Inactive" selected={statusFilter === 'Inactive'}>Inactive</option>
        </select>

        <select name="source" class="filter-select">
          <option value="">All Sources</option>
          <option value="Website Enquiry" selected={sourceFilter === 'Website Enquiry'}>Website Enquiry</option>
          <option value="Product Page" selected={sourceFilter === 'Product Page'}>Product Page</option>
          <option value="Contact Us Page" selected={sourceFilter === 'Contact Us Page'}>Contact Us Page</option>
          <option value="Manual Entry" selected={sourceFilter === 'Manual Entry'}>Manual Entry</option>
        </select>

        <select name="sort" class="filter-select">
          <option value="newest" selected={sortFilter === 'newest'}>Newest First</option>
          <option value="oldest" selected={sortFilter === 'oldest'}>Oldest First</option>
          <option value="name" selected={sortFilter === 'name'}>Name A-Z</option>
          <option value="last_contact" selected={sortFilter === 'last_contact'}>Recent Contact</option>
        </select>

        <button type="submit" class="apply-btn">Apply</button>
        {(q || statusFilter || sourceFilter) && (
          <a href="/admin/leads" class="reset-link">Reset</a>
        )}
      </form>
    </div>

    <!-- Active Filter Chips -->
    {(q || statusFilter || sourceFilter) && (
      <div class="active-chips-bar">
        <span class="chips-label">Active Filters:</span>
        {statusFilter && <span class="chip">Status: {statusFilter}</span>}
        {sourceFilter && <span class="chip">Source: {sourceFilter}</span>}
        {q && <span class="chip">Search: "{q}"</span>}
        <a href="/admin/leads" class="clear-chips">CLEAR ALL</a>
      </div>
    )}

    <!-- Table -->
    <div class="table-card">
      <div class="table-meta-bar">
        <span>Showing <b>{leads.length}</b> leads</span>
      </div>

      <div class="table-scroll-container">
        <table class="leads-master-table">
          <thead>
            <tr>
              <th>Customer Name</th>
              <th>Location</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Source</th>
              <th>Latest Product Enquiry</th>
              <th>Status</th>
              <th>Last Activity</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {leads.length === 0 ? (
              <tr>
                <td colspan="10" class="empty-cell">No leads match the selected criteria.</td>
              </tr>
            ) : (
              leads.map((lead: any) => {
                const latestEnquiry = lead.Enquiries?.[0];
                return (
                  <tr>
                    <td>
                      <a href={`/admin/leads/${lead.id}`} class="lead-link">{lead.name}</a>
                    </td>
                    <td>
                      {lead.city ? <span>{lead.city}</span> : <span class="muted-dash">&mdash;</span>}
                    </td>
                    <td><a href={`tel:${lead.phone}`} class="contact-sublink">{lead.phone}</a></td>
                    <td><a href={`mailto:${lead.email}`} class="contact-sublink">{lead.email || '&mdash;'}</a></td>
                    <td><span class="source-tag">{lead.source || 'Website'}</span></td>
                    <td>
                      {latestEnquiry?.product_id && productMap.has(latestEnquiry.product_id) ? (
                        <span class="prod-tag">📦 {productMap.get(latestEnquiry.product_id)!.name}</span>
                      ) : (
                        <span class="muted-dash">&mdash;</span>
                      )}
                    </td>
                    <td>
                      <span class={`status-pill status-${lead.status.toLowerCase()}`}>{lead.status}</span>
                    </td>
                    <td>{new Date(lead.updated_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' })}</td>
                    <td>{new Date(lead.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' })}</td>
                    <td>
                      <a href={`/admin/leads/${lead.id}`} class="action-link">Open &rarr;</a>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Create Lead Modal -->
  <div class="modal-backdrop" id="add-lead-modal" hidden>
    <div class="modal-card">
      <div class="modal-head">
        <h2>Create New Lead</h2>
        <button class="close-btn" id="close-add-lead-btn">&times;</button>
      </div>

      <form id="create-lead-form" class="modal-form">
        <div class="form-grid">
          <div class="f-group">
            <label>Customer Name *</label>
            <input type="text" name="name" required placeholder="e.g. Anish Malhotra" />
          </div>

          <div class="f-group">
            <label>Phone Number *</label>
            <input type="tel" name="phone" required placeholder="+91 98123 45678" />
          </div>

          <div class="f-group">
            <label>Email Address</label>
            <input type="email" name="email" placeholder="customer@company.com" />
          </div>

          <div class="f-group">
            <label>Location / City</label>
            <input type="text" name="location" placeholder="e.g. Gurugram, Haryana" />
          </div>

          <div class="f-group">
            <label>Company / Firm</label>
            <input type="text" name="company" placeholder="e.g. Design Studio Inc." />
          </div>

          <div class="f-group">
            <label>Source</label>
            <select name="source">
              <option value="Manual Entry">Manual Entry</option>
              <option value="Phone Enquiry">Phone Enquiry</option>
              <option value="WhatsApp">WhatsApp</option>
              <option value="Referral">Referral</option>
            </select>
          </div>

          <div class="f-group full-width">
            <label>Requirement / Notes</label>
            <textarea name="requirement" rows="2" placeholder="Customer requirements or product interest..."></textarea>
          </div>
        </div>

        <p class="error-msg" id="modal-error" hidden></p>

        <div class="modal-foot">
          <button type="button" class="cancel-btn" id="cancel-add-lead-btn">Cancel</button>
          <button type="submit" class="submit-btn">Create Lead</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const modal = document.getElementById('add-lead-modal');
  const openBtn = document.getElementById('open-add-lead-btn');
  const closeBtn = document.getElementById('close-add-lead-btn');
  const cancelBtn = document.getElementById('cancel-add-lead-btn');
  const form = document.getElementById('create-lead-form') as HTMLFormElement | null;
  const errEl = document.getElementById('modal-error');

  openBtn?.addEventListener('click', () => modal && (modal.hidden = false));
  closeBtn?.addEventListener('click', () => modal && (modal.hidden = true));
  cancelBtn?.addEventListener('click', () => modal && (modal.hidden = true));

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errEl) errEl.hidden = true;

    const formData = new FormData(form);
    const body = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/admin/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (!res.ok || data.error) {
        if (errEl) {
          errEl.hidden = false;
          errEl.textContent = data.error || 'Failed to create lead.';
        }
        return;
      }
      window.location.reload();
    } catch (err) {
      if (errEl) {
        errEl.hidden = false;
        errEl.textContent = 'Server connection error.';
      }
    }
  });
</script>

<style>
  .leads-page-container { display: flex; flex-direction: column; gap: 1.5rem; }
  .leads-head-row { display: flex; align-items: baseline; justify-content: space-between; }
  .leads-page-title { font-family: var(--display); font-size: 2rem; color: var(--maroon-2); margin: 0; }
  .leads-page-sub { font-size: 0.88rem; color: var(--ink-soft); margin-top: 0.2rem; }
  .primary-btn { background: var(--maroon); color: #ffffff; font-size: 0.813rem; font-weight: 600; padding: 0.6rem 1.25rem; border-radius: 999px; border: none; cursor: pointer; }
  .controls-card { background: var(--paper-2); border: 1px solid var(--line); border-radius: 8px; padding: 1rem 1.25rem; }
  .filter-form { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .search-input-frame { display: flex; align-items: center; gap: 0.5rem; background: #ffffff; border: 1px solid var(--line); border-radius: 999px; padding: 0.45rem 0.85rem; flex: 1; min-width: 220px; }
  .search-field { border: none; outline: none; background: transparent; font-size: 0.844rem; width: 100%; }
  .filter-select { background: #ffffff; border: 1px solid var(--line); border-radius: 999px; padding: 0.45rem 1rem; font-size: 0.813rem; outline: none; }
  .apply-btn { background: var(--maroon-2); color: #ffffff; font-size: 0.813rem; font-weight: 600; padding: 0.45rem 1rem; border-radius: 999px; border: none; cursor: pointer; }
  .reset-link { font-size: 0.813rem; color: var(--maroon); text-decoration: underline; font-weight: 600; }
  .active-chips-bar { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; font-size: 0.781rem; }
  .chips-label { color: var(--ink-soft); font-weight: 600; }
  .chip { background: var(--paper-3); border: 1px solid var(--line); padding: 0.2rem 0.65rem; border-radius: 999px; }
  .clear-chips { color: var(--maroon); font-weight: 700; text-decoration: none; margin-left: 0.5rem; }
  .table-card { background: var(--paper-2); border: 1px solid var(--line); border-radius: 8px; padding: 1rem; }
  .table-meta-bar { font-size: 0.813rem; color: var(--ink-soft); margin-bottom: 0.75rem; }
  .table-scroll-container { overflow-x: auto; }
  .leads-master-table { width: 100%; border-collapse: collapse; font-size: 0.844rem; text-align: left; }
  .leads-master-table th { background: var(--paper-3); color: var(--maroon-2); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.75rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .leads-master-table td { padding: 0.75rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .lead-link { font-weight: 700; color: var(--maroon-2); text-decoration: none; }
  .lead-link:hover { text-decoration: underline; }
  .contact-sublink { color: var(--ink); text-decoration: none; }
  .source-tag { font-size: 0.72rem; background: var(--paper-3); padding: 0.15rem 0.5rem; border-radius: 4px; }
  .prod-tag { font-size: 0.75rem; font-weight: 600; color: var(--maroon); }
  .status-pill { font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; }
  .status-lead { background: #fef3c7; color: #92400e; }
  .status-new { background: #e0f2fe; color: #075985; }
  .status-active { background: #dcfce7; color: #166534; }
  .status-repeat { background: #ede9fe; color: #5b21b6; }
  .status-vip { background: #fdf4ff; color: #a21caf; }
  .status-inactive { background: #fee2e2; color: #991b1b; }
  .action-link { font-weight: 600; color: var(--maroon); text-decoration: none; }
  .empty-cell { text-align: center; padding: 2rem; color: var(--ink-soft); }
  .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; display: grid; place-items: center; padding: 1.5rem; }
  .modal-card { background: var(--paper, #FBF3F0); border: 1px solid var(--line); border-radius: 8px; width: 100%; max-width: 580px; padding: 1.75rem; box-shadow: 0 20px 40px rgba(0,0,0,0.2); }
  .modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--line); padding-bottom: 0.75rem; }
  .modal-head h2 { font-family: var(--display); margin: 0; color: var(--maroon-2); }
  .close-btn { background: none; border: none; font-size: 1.5rem; cursor: pointer; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .f-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .f-group.full-width { grid-column: span 2; }
  .f-group label { font-size: 0.781rem; font-weight: 600; color: var(--maroon-2); }
  .f-group input, .f-group select, .f-group textarea { background: #ffffff; border: 1px solid var(--line); border-radius: 4px; padding: 0.55rem; font-size: 0.844rem; outline: none; }
  .error-msg { color: #b91c1c; font-size: 0.813rem; margin-top: 0.5rem; }
  .modal-foot { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem; }
  .cancel-btn { background: none; border: 1px solid var(--line); padding: 0.55rem 1.25rem; border-radius: 999px; cursor: pointer; }
  .submit-btn { background: var(--maroon); color: #ffffff; border: none; padding: 0.55rem 1.25rem; border-radius: 999px; font-weight: 600; cursor: pointer; }
</style>
