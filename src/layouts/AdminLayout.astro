---
import Base from './Base.astro';
import { getSessionUser } from '../lib/auth';

export interface Props {
  title: string;
  activeNav?: string;
}

const { title, activeNav = 'dashboard' } = Astro.props;
const user = getSessionUser(Astro.request);

if (!user) {
  return Astro.redirect('/crm/login');
}
---

<Base title={`${title} — VINSHO Admin CRM`}>
  <div class="admin-shell">
    <!-- Top Header -->
    <header class="admin-topbar">
      <div class="topbar-left">
        <a href="/crm/dashboard" class="admin-logo" aria-label="VINSHO CRM">
          <img src="/vinsho-logo-transparent.png" alt="VINSHO" class="admin-logo-img" />
          <span class="logo-sub">CRM</span>
        </a>
      </div>
      <div class="topbar-right">
        <div class="user-badge">
          <span class="user-role-tag">{user.role}</span>
          <span class="user-name">{user.name}</span>
        </div>
        <button class="admin-logout-btn" id="admin-logout-trigger">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
          </svg>
          Logout
        </button>
      </div>
    </header>

    <div class="admin-body">
      <!-- Sidebar Navigation -->
      <aside class="admin-sidebar" aria-label="Admin Navigation">
        <nav class="admin-nav-list">
          <a href="/crm/dashboard" class={`nav-item ${activeNav === 'dashboard' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="3" width="7" height="9"/>
              <rect x="14" y="3" width="7" height="5"/>
              <rect x="14" y="12" width="7" height="9"/>
              <rect x="3" y="16" width="7" height="5"/>
            </svg>
            Dashboard
          </a>
          <a href="/crm/leads" class={`nav-item ${activeNav === 'leads' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Leads Management
          </a>
          <a href="/crm/customers" class={`nav-item ${activeNav === 'customers' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            Customers
          </a>
          <a href="/crm/analytics" class={`nav-item ${activeNav === 'analytics' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <line x1="18" y1="20" x2="18" y2="10"/>
              <line x1="12" y1="20" x2="12" y2="4"/>
              <line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
            Analytics
          </a>
          {user.role === 'ADMIN' && (
            <a href="/crm/settings" class={`nav-item ${activeNav === 'settings' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
              </svg>
              Team Settings
            </a>
          )}
        </nav>

        <div class="sidebar-foot">
          <a href="/" target="_blank" class="view-site-link">
            Visit Public Site &rarr;
          </a>
        </div>
      </aside>

      <!-- Main Admin Content -->
      <main class="admin-main">
        <slot />
      </main>
    </div>
  </div>
</Base>

<script>
  document.getElementById('admin-logout-trigger')?.addEventListener('click', async () => {
    try {
      await fetch('/api/admin/logout', { method: 'POST' });
      window.location.href = '/crm/login';
    } catch (err) {
      window.location.href = '/crm/login';
    }
  });
</script>

<style>
  .admin-shell {
    min-height: 100vh;
    background: var(--paper, #FBF3F0);
    display: flex;
    flex-direction: column;
    color: var(--ink, #1C1917);
    font-family: var(--sans);
  }

  .admin-topbar {
    height: 60px;
    background: var(--paper-2, #F9F4F0);
    border-bottom: 1px solid var(--line, #e2d8d5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1.5rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .admin-logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .admin-logo-img {
    height: 34px;
    width: auto;
    object-fit: contain;
  }

  .logo-sub {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    background: var(--maroon, #8A174B);
    color: #ffffff;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .user-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.813rem;
  }

  .user-role-tag {
    background: var(--paper-3, #f1e7e4);
    color: var(--maroon);
    font-size: 0.688rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    letter-spacing: 0.08em;
  }

  .user-name {
    font-weight: 600;
    color: var(--maroon-2);
  }

  .admin-logout-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.781rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .admin-logout-btn:hover {
    background: var(--maroon);
    border-color: var(--maroon);
    color: #ffffff;
  }

  .admin-body {
    display: flex;
    flex: 1;
  }

  .admin-sidebar {
    width: 240px;
    background: var(--paper-2);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem 1rem;
    position: sticky;
    top: 60px;
    height: calc(100vh - 60px);
  }

  .admin-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .nav-item:hover {
    background: var(--paper-3);
    color: var(--maroon);
  }

  .nav-item.active {
    background: var(--maroon);
    color: #ffffff;
    font-weight: 600;
  }

  .sidebar-foot {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .view-site-link {
    font-size: 0.781rem;
    color: var(--maroon);
    text-decoration: none;
    font-weight: 500;
  }

  .admin-main {
    flex: 1;
    padding: 2rem 2.5rem;
    overflow-y: auto;
  }

  @media (max-width: 900px) {
    .admin-body {
      flex-direction: column;
    }
    .admin-sidebar {
      width: 100%;
      height: auto;
      position: static;
    }
    .admin-main {
      padding: 1.5rem 1rem;
    }
  }
</style>
