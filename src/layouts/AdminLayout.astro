---
import Base from './Base.astro';
import { getSessionUser } from '../lib/auth';

export interface Props {
  title: string;
  activeNav?: string;
}

const { title, activeNav = 'dashboard' } = Astro.props;
const user = await getSessionUser(Astro.request);

if (!user) {
  return Astro.redirect('/crm/login');
}
---

<Base title={`${title} — VINSHO Admin CRM`}>
  <div class="admin-shell">
    <!-- Top Header -->
    <header class="admin-topbar">
      <div class="topbar-left">
        <button 
          type="button" 
          class="admin-menu-toggle" 
          id="admin-menu-toggle" 
          aria-label="Open Navigation Menu" 
          aria-expanded="false" 
          aria-controls="admin-sidebar"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <a href="/crm/dashboard" class="admin-logo" aria-label="VINSHO CRM">
          <img src="/vinsho-logo-transparent.png" alt="VINSHO" class="admin-logo-img" />
          <span class="logo-sub">CRM</span>
        </a>
      </div>
      <div class="topbar-right">
        <div class="user-badge">
          <span class="user-role-tag">{user.role}</span>
          <span class="user-name">{user.name}</span>
        </div>
        <button class="admin-logout-btn" id="admin-logout-trigger" aria-label="Logout from CRM">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
          </svg>
          <span class="logout-text">Logout</span>
        </button>
      </div>
    </header>

    <!-- Backdrop for Drawer Navigation on Mobile / Tablet -->
    <div id="admin-sidebar-backdrop" class="admin-sidebar-backdrop" aria-hidden="true"></div>

    <div class="admin-body">
      <!-- Sidebar Navigation / Drawer -->
      <aside class="admin-sidebar" id="admin-sidebar" aria-label="Admin Navigation">
        <div class="drawer-header">
          <div class="drawer-brand">
            <img src="/vinsho-logo-transparent.png" alt="VINSHO" class="drawer-logo-img" />
            <span class="logo-sub">CRM</span>
          </div>
          <button type="button" class="drawer-close-btn" id="admin-drawer-close" aria-label="Close navigation menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="drawer-user-info">
          <div class="drawer-avatar">{(user.name || 'U').charAt(0).toUpperCase()}</div>
          <div class="drawer-user-meta">
            <span class="drawer-user-name">{user.name}</span>
            <span class="drawer-user-role">{user.role}</span>
          </div>
        </div>

        <nav class="admin-nav-list">
          <a href="/crm/dashboard" class={`nav-item ${activeNav === 'dashboard' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="3" width="7" height="9"/>
              <rect x="14" y="3" width="7" height="5"/>
              <rect x="14" y="12" width="7" height="9"/>
              <rect x="3" y="16" width="7" height="5"/>
            </svg>
            Dashboard
          </a>
          <a href="/crm/leads" class={`nav-item ${activeNav === 'leads' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Leads Management
          </a>
          <a href="/crm/orders" class={`nav-item ${activeNav === 'orders' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            Orders
          </a>
          <a href="/crm/customers" class={`nav-item ${activeNav === 'customers' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            Customers
          </a>
          <a href="/crm/orders" class={`nav-item ${activeNav === 'orders' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
              <path d="M3 6h18"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            Orders
          </a>
          <a href="/crm/products" class={`nav-item ${activeNav === 'products' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
            Products
          </a>
          <a href="/crm/returns" class={`nav-item ${activeNav === 'returns' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
              <path d="M3 3v5h5"/>
            </svg>
            Returns &amp; RTO
          </a>
          <a href="/crm/analytics" class={`nav-item ${activeNav === 'analytics' ? 'active' : ''}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <line x1="18" y1="20" x2="18" y2="10"/>
              <line x1="12" y1="20" x2="12" y2="4"/>
              <line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
            Analytics
          </a>
          {(user.role === 'ADMIN' || user.role === 'SUPER_ADMIN') && (
            <a href="/crm/settings" class={`nav-item ${activeNav === 'settings' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
              </svg>
              Team Settings
            </a>
          )}
        </nav>

        <div class="sidebar-foot">
          <a href="/" target="_blank" rel="noopener noreferrer" class="view-site-link">
            Visit Public Site &rarr;
          </a>
        </div>
      </aside>

      <!-- Main Admin Content -->
      <main class="admin-main">
        <slot />
      </main>
    </div>
  </div>
</Base>

<script>
  // Logout handling
  document.getElementById('admin-logout-trigger')?.addEventListener('click', async () => {
    try {
      await fetch('/api/admin/logout', { method: 'POST' });
      window.location.href = '/crm/login';
    } catch (err) {
      window.location.href = '/crm/login';
    }
  });

  // Off-canvas mobile/tablet drawer navigation
  const menuToggle = document.getElementById('admin-menu-toggle');
  const drawerClose = document.getElementById('admin-drawer-close');
  const sidebar = document.getElementById('admin-sidebar');
  const backdrop = document.getElementById('admin-sidebar-backdrop');

  function openDrawer() {
    sidebar?.classList.add('drawer-open');
    backdrop?.classList.add('active');
    menuToggle?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('drawer-lock-scroll');
  }

  function closeDrawer() {
    sidebar?.classList.remove('drawer-open');
    backdrop?.classList.remove('active');
    menuToggle?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('drawer-lock-scroll');
  }

  menuToggle?.addEventListener('click', () => {
    if (sidebar?.classList.contains('drawer-open')) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  drawerClose?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebar?.classList.contains('drawer-open')) {
      closeDrawer();
    }
  });

  // Auto-close on link click (for smooth in-page or dynamic navigation)
  sidebar?.querySelectorAll('.nav-item').forEach((item) => {
    item.addEventListener('click', () => {
      if (window.innerWidth < 1024) {
        closeDrawer();
      }
    });
  });
</script>

<style>
  .admin-shell {
    min-height: 100vh;
    background: var(--paper, #FBF3F0);
    display: flex;
    flex-direction: column;
    color: var(--ink, #1C1917);
    font-family: var(--sans);
    position: relative;
    overflow-x: hidden;
  }

  .admin-topbar {
    height: 60px;
    background: var(--paper-2, #F9F4F0);
    border-bottom: 1px solid var(--line, #e2d8d5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1.5rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Hamburger toggle for mobile/tablet */
  .admin-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 6px;
    background: #ffffff;
    border: 1px solid var(--line, #e2d8d5);
    color: var(--maroon, #8A174B);
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .admin-menu-toggle:hover {
    background: var(--paper-3, #f1e7e4);
  }

  .admin-logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .admin-logo-img {
    height: 34px;
    width: auto;
    object-fit: contain;
  }

  .logo-sub {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    background: var(--maroon, #8A174B);
    color: #ffffff;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .user-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.813rem;
  }

  .user-role-tag {
    background: var(--paper-3, #f1e7e4);
    color: var(--maroon);
    font-size: 0.688rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    letter-spacing: 0.08em;
  }

  .user-name {
    font-weight: 600;
    color: var(--maroon-2);
  }

  .admin-logout-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.781rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .admin-logout-btn:hover {
    background: var(--maroon);
    border-color: var(--maroon);
    color: #ffffff;
  }

  .admin-body {
    display: flex;
    flex: 1;
    min-width: 0;
  }

  /* Desktop persistent sidebar (>= 1024px) */
  .admin-sidebar {
    width: 240px;
    flex-shrink: 0;
    background: var(--paper-2);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem 1rem;
    position: sticky;
    top: 60px;
    height: calc(100vh - 60px);
  }

  .drawer-header {
    display: none;
  }

  .drawer-user-info {
    display: none;
  }

  .admin-sidebar-backdrop {
    display: none;
  }

  .admin-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .nav-item:hover {
    background: var(--paper-3);
    color: var(--maroon);
  }

  .nav-item.active {
    background: var(--maroon);
    color: #ffffff;
    font-weight: 600;
  }

  .sidebar-foot {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    margin-top: auto;
  }

  .view-site-link {
    font-size: 0.781rem;
    color: var(--maroon);
    text-decoration: none;
    font-weight: 500;
    display: inline-block;
  }

  .admin-main {
    flex: 1;
    padding: 2rem 2.5rem;
    min-width: 0;
    box-sizing: border-box;
  }

  /* Tablet and Mobile Shell (< 1024px) */
  @media (max-width: 1023px) {
    .admin-menu-toggle {
      display: inline-flex;
    }

    .admin-sidebar-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(28, 25, 23, 0.48);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
      z-index: 998;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .admin-sidebar-backdrop.active {
      opacity: 1;
      pointer-events: auto;
    }

    .admin-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 290px;
      max-width: 84vw;
      height: 100vh;
      background: var(--paper-2);
      z-index: 999;
      transform: translateX(-100%);
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
      padding: 1.25rem 1rem;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      border-right: 1px solid var(--line);
    }

    .admin-sidebar.drawer-open {
      transform: translateX(0);
    }

    .drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--line);
      margin-bottom: 0.85rem;
    }

    .drawer-brand {
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }

    .drawer-logo-img {
      height: 28px;
      width: auto;
      object-fit: contain;
    }

    .drawer-close-btn {
      background: var(--paper-3, #f1e7e4);
      border: none;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      color: var(--ink);
      cursor: pointer;
      padding: 0;
      transition: background 0.2s;
    }

    .drawer-close-btn:hover {
      background: #e2d8d5;
      color: var(--maroon);
    }

    .drawer-user-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 0.85rem;
      background: var(--paper-3, #f1e7e4);
      border-radius: 8px;
      margin-bottom: 1rem;
    }

    .drawer-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--maroon);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .drawer-user-meta {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .drawer-user-name {
      font-size: 0.844rem;
      font-weight: 700;
      color: var(--maroon-2);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .drawer-user-role {
      font-size: 0.688rem;
      font-weight: 600;
      color: var(--ink-soft);
      letter-spacing: 0.05em;
    }

    .admin-main {
      padding: 1.5rem 1.25rem;
      width: 100%;
      max-width: 100vw;
    }
  }

  /* Mobile Shell (< 768px) */
  @media (max-width: 767px) {
    .admin-topbar {
      height: 56px;
      padding-inline: 0.85rem;
    }

    .admin-logo-img {
      height: 28px;
    }

    .topbar-right {
      gap: 0.6rem;
    }

    .user-role-tag {
      display: none;
    }

    .user-name {
      font-size: 0.75rem;
      max-width: 90px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .admin-logout-btn {
      padding: 0.3rem 0.6rem;
      font-size: 0.72rem;
    }

    .logout-text {
      display: none;
    }

    .admin-main {
      padding: 1rem 0.75rem;
    }
  }
</style>

<!-- Global CRM Responsive Utilities -->
<style is:global>
  /* Prevent horizontal viewport spill */
  html, body {
    max-width: 100vw;
    overflow-x: hidden;
  }

  body.drawer-lock-scroll {
    overflow: hidden !important;
  }

  /* Ensure all tables are safely scrollable horizontally on mobile/tablet */
  .table-scroll-container,
  .table-container,
  .table-responsive {
    width: 100% !important;
    max-width: 100% !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    position: relative;
    border-radius: 8px;
  }

  .table-card:has(table) {
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    max-width: 100% !important;
  }

  /* Table styling enhancements for touch screens */
  .leads-master-table,
  .cust-master-table,
  .orders-table,
  .products-table,
  .admin-table,
  .crm-table,
  .audit-table,
  .data-table,
  .items-table,
  .variant-edit-table {
    min-width: 680px;
  }

  /* Mobile Modals */
  @media (max-width: 767px) {
    .modal-backdrop,
    .modal-overlay {
      padding: 0.75rem !important;
      align-items: flex-end !important;
    }

    .modal-card,
    .modal-container {
      width: 100% !important;
      max-width: 100% !important;
      max-height: 88vh !important;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch !important;
      padding: 1.25rem 1rem !important;
      border-bottom-left-radius: 0 !important;
      border-bottom-right-radius: 0 !important;
    }

    .form-grid {
      grid-template-columns: 1fr !important;
    }

    .f-group.full-width {
      grid-column: span 1 !important;
    }

    .field-row-2,
    .field-row-3 {
      grid-template-columns: 1fr !important;
    }

    .modal-foot {
      flex-direction: column-reverse;
      gap: 0.5rem !important;
    }

    .modal-foot button,
    .modal-foot .cancel-btn,
    .modal-foot .submit-btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  /* Touch-friendly inputs and buttons */
  @media (max-width: 767px) {
    input[type="text"],
    input[type="search"],
    input[type="email"],
    input[type="password"],
    input[type="tel"],
    select,
    button,
    .btn,
    .primary-btn {
      min-height: 38px;
    }
  }
</style>
