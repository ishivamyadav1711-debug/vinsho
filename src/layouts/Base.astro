---
import '../styles/global.css';
import content from '../../vinsho-content.json';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const { 
  title = "VINSHO — Luxury Home Décor & Furnishings",
  description = "VINSHO — luxury home décor, furnishings and gifting. Curated pieces that blend elegance, comfort and functionality. Greater Noida.",
  canonicalUrl,
  ogImage
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : "https://www.vinsho.in";
const resolvedCanonical = canonicalUrl || new URL(Astro.url.pathname, siteOrigin).href;

const shareImage = ogImage || content.siteImages.hero || content.siteImages.exploreLarge;

// Meta (Facebook) Pixel for marketing. Loaded on production only, so local and preview
// traffic doesn't pollute the data, and never on staff or account pages: the URL is sent
// to Meta, and password-reset links carry a secret token in /account?...&token=...
const META_PIXEL_ID = '1451496613812655';
const PIXEL_EXCLUDED_PATHS = ['/crm', '/admin', '/account', '/reset-password'];
const pixelPath = Astro.url.pathname;
const loadMetaPixel =
  import.meta.env.PROD &&
  !PIXEL_EXCLUDED_PATHS.some((p) => pixelPath === p || pixelPath.startsWith(p + '/'));
const metaPixelScript = `!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '${META_PIXEL_ID}');
fbq('track', 'PageView');`;

// Prepare JSON-LD
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": content.brand.name,
  "url": "https://www.vinsho.in",
  "logo": "https://www.vinsho.in/logo.png"
};

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": content.brand.name,
  "description": content.brand.tagline,
  "foundingDate": content.brand.established,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "India Expo Plaza First Floor, Plot No. C-03 & 04 Knowledge Park-II",
    "addressLocality": "Greater Noida",
    "addressRegion": "Uttar Pradesh",
    "postalCode": "201310",
    "addressCountry": "IN"
  },
  "telephone": content.brand.phone,
  "email": content.brand.email
};

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": content.products.map((product, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Product",
      "name": product.name,
      "description": product.description,
      "image": product.image
    }
  }))
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=4" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=4" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
    <link rel="manifest" href="/site.webmanifest?v=4" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    {shareImage && <meta property="og:image" content={shareImage} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:url" content={resolvedCanonical} />
    {shareImage && <meta property="twitter:image" content={shareImage} />}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Inter:opsz,wght@14..32,300..700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemList)} />

    {loadMetaPixel && <script is:inline set:html={metaPixelScript} />}
  </head>
  <body>
    {loadMetaPixel && (
      <noscript>
        <img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`} />
      </noscript>
    )}
    <div id="prog"></div>
    <slot />
    <div class="toast" id="toast"></div>
    
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/modal.ts"></script>
    <script src="../scripts/catalogue.ts"></script>
  </body>
</html>
