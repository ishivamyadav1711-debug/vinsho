---
import content from '../../vinsho-content.json';
import TextReveal from './motion/TextReveal.astro';
import Magnetic from './motion/Magnetic.astro';
---

<section class="wrap statement-section" id="statement-section">
  <div class="stmt">
    <div class="stmt-img-frame" id="stmt-img-frame">
      <img src={content.siteImages.statement} alt="A room styled with VINSHO furnishings" id="stmt-img-target" loading="lazy" />
    </div>
    <div class="stmt-content-col" id="stmt-content-col">
      <TextReveal as="h2">Refined décor that brings beauty to your home and warmth to every room</TextReveal>
      <p id="stmt-para">From cotton that softens with every wash to frames that sit straight on the wall, every VINSHO piece is chosen to last longer than a trend. Thank you for supporting a brand that celebrates beautiful living.</p>
      <Magnetic strength={4}>
        <a class="btn" id="stmt-cta-btn" href={`https://wa.me/${content.brand.whatsapp}?text=Hi%20VINSHO,%20I%20have%20a%20question%20about%20your%20products.`} target="_blank" rel="noopener noreferrer">
          Talk to us
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </Magnetic>
    </div>
  </div>
</section>

<style>
  .stmt-img-frame {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    width: 100%;
    aspect-ratio: 4 / 3;
  }

  #stmt-img-target {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }
</style>
