---
import { prisma } from '../../lib/db';

const now = new Date();
const nowIso = now.toISOString();
const currentMonthStart = new Date(now.getFullYear(), now.getMonth(), 1);
const nextMonthStart = new Date(now.getFullYear(), now.getMonth() + 1, 1);

const metricsStart = Date.now();
const [
  [
    totalCustomers,
    newCustomersMonth,
    totalEnquiries,
    openEnquiries,
    convertedMonth,
    overdueFollowups
  ],
  productDemandRaw,
  recentEnquiriesRaw,
  upcomingFollowupsRaw,
  recentActivitiesRaw
] = await Promise.all([
  Promise.all([
    prisma.customers.count({ where: { deleted_at: null } }),
    prisma.customers.count({ where: { deleted_at: null, created_at: { gte: currentMonthStart, lt: nextMonthStart } } }),
    prisma.enquiries.count(),
    prisma.enquiries.count({ where: { status: { notIn: ['Converted', 'Lost'] } } }),
    prisma.enquiries.count({ where: { status: 'Converted', closed_at: { gte: currentMonthStart.toISOString(), lt: nextMonthStart.toISOString() } } }),
    prisma.followUps.count({ where: { status: 'PENDING', due_at: { lt: nowIso } } })
  ]),
  prisma.enquiries.groupBy({
    by: ['product_id'],
    _count: { id: true },
    orderBy: { _count: { id: 'desc' } },
    take: 5,
    where: { product_id: { not: null } }
  }),
  prisma.enquiries.findMany({
    orderBy: { created_at: 'desc' },
    take: 10,
    include: {
      customer: { select: { name: true, phone: true, email: true } }
    }
  }),
  prisma.followUps.findMany({
    where: { status: 'PENDING' },
    orderBy: { due_at: 'asc' },
    take: 5,
    include: { assignee: { select: { name: true } } }
  }),
  prisma.crmActivities.findMany({
    orderBy: { created_at: 'desc' },
    take: 8
  })
]);

const productDemand = await Promise.all(
  productDemandRaw.map(async (pd) => {
    const product = await prisma.products.findUnique({ where: { id: pd.product_id! } });
    return {
      name: product?.name || 'Unknown',
      slug: product?.slug || '',
      shipping_class: product?.shipping_class || '',
      enquiry_count: pd._count.id
    };
  })
);

const prodIds = recentEnquiriesRaw.map((e: any) => e.product_id).filter(Boolean);
const dashProducts = await prisma.products.findMany({ where: { id: { in: prodIds as number[] } }, select: { id: true, name: true }});
const dashProductsMap = new Map(dashProducts.map((p: any) => [p.id, p]));

const recentEnquiries = recentEnquiriesRaw.map((e: any) => ({
  ...e,
  customer_name: e.customer?.name || '',
  customer_phone: e.customer?.phone || '',
  customer_email: e.customer?.email || '',
  product_name: e.product_id ? dashProductsMap.get(e.product_id)?.name : null
}));

const upcomingFollowups = upcomingFollowupsRaw.map((f: any) => ({
  ...f,
  assignee_name: f.assignee?.name || null
}));

const normalizeStatus = (status: string) => {
  if (!status) return 'New';
  const s = status.trim().toLowerCase();
  if (s === 'new') return 'New';
  if (s === 'in progress') return 'In Progress';
  if (s === 'contacted') return 'Contacted';
  if (s === 'qualified') return 'Qualified';
  if (s === 'converted' || s === 'success') return 'Converted';
  if (s === 'closed') return 'Closed';
  if (s === 'lost') return 'Lost';
  // Fallback Capitalization
  return status.charAt(0).toUpperCase() + status.slice(1).toLowerCase();
};

const normalizeSource = (src: string) => {
  if (!src) return 'Website';
  if (src.includes('Quick View')) return 'Quick View';
  return src;
};
---

    <!-- 1. Real Data Metric Summary Cards Grid -->
    <div class="metrics-grid">
      <div class="metric-card">
        <span class="m-label">Total Customers</span>
        <span class="m-val">{totalCustomers > 0 ? totalCustomers : '0'}</span>
        <span class="m-sub">{totalCustomers === 0 ? 'No data' : 'Deduplicated leads'}</span>
      </div>

      <div class="metric-card highlight-new">
        <span class="m-label">Open Enquiries</span>
        <span class="m-val">{openEnquiries > 0 ? openEnquiries : '0'}</span>
        <span class="m-sub">{openEnquiries === 0 ? 'No data' : 'Requires response'}</span>
      </div>

      <div class="metric-card">
        <span class="m-label">New This Month</span>
        <span class="m-val">{newCustomersMonth > 0 ? newCustomersMonth : '0'}</span>
        <span class="m-sub">{newCustomersMonth === 0 ? 'No data' : 'Captured this month'}</span>
      </div>

      <div class="metric-card">
        <span class="m-label">Converted (MTD)</span>
        <span class="m-val">{convertedMonth > 0 ? convertedMonth : '0'}</span>
        <span class="m-sub">{convertedMonth === 0 ? 'No data' : 'Closed deals'}</span>
      </div>

      <div class={`metric-card ${overdueFollowups > 0 ? 'highlight-alert' : ''}`}>
        <span class="m-label">Overdue Follow-ups</span>
        <span class="m-val">{overdueFollowups > 0 ? overdueFollowups : '0'}</span>
        <span class="m-sub">{overdueFollowups === 0 ? 'No data' : 'Action required'}</span>
      </div>
    </div>

    <!-- 2. Section: Pipeline & Follow-ups Layout -->
    <div class="dash-grid-2">
      <!-- Left Column: Main Content -->
      <div class="main-column">
        <!-- Enquiries Pipeline Table -->
        <div class="content-card">
          <div class="card-head">
            <h2 class="section-title">Recent Enquiries</h2>
            <a href="/crm/leads" class="view-all-link">View all &rarr;</a>
          </div>
          {recentEnquiries.length > 0 ? (
            <div class="table-scroll-container">
              <table class="crm-table">
                <thead>
                  <tr>
                    <th>Customer</th>
                    <th>Product / Service</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  {recentEnquiries.map(e => (
                    <tr class="interactive-row">
                      <td>
                        <strong class="cell-primary">{e.customer_name || <span class="muted-text">Unnamed customer</span>}</strong>
                        <small class="cell-secondary">{e.customer_phone ? `☎ ${e.customer_phone}` : (e.customer_email || 'No contact')}</small>
                      </td>
                      <td>
                        <span class="cell-primary">{e.product_name || <span class="muted-text">General Inquiry</span>}</span>
                      </td>
                      <td>
                        <span class="badge-source">{normalizeSource(e.source)}</span>
                      </td>
                      <td>
                        <span class="badge-status" data-status={normalizeStatus(e.status)}>{normalizeStatus(e.status)}</span>
                      </td>
                      <td>
                        <button class="btn-action-ghost" data-enquiry-id={e.id} onclick={`updateEnquiryStatus(${e.id})`}>
                          View &rarr;
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="empty-state-msg">
              <p>No recent enquiries found.</p>
            </div>
          )}
        </div>

        <!-- Product Demand Ranking -->
        <div class="content-card">
          <div class="card-head">
            <h2 class="section-title">Product Demand</h2>
            <p class="section-subtitle">Most requested products by enquiry volume</p>
          </div>
          {productDemand.length > 0 ? (
            <div class="demand-list">
              {productDemand.map((pd, idx) => (
                <div class="demand-item">
                  <span class="demand-rank">#{idx + 1}</span>
                  <div class="demand-info">
                    <strong class="cell-primary">{pd.name !== 'Unknown' ? pd.name : <span class="muted-text">Category unavailable</span>}</strong>
                    <small class="cell-secondary">{pd.shipping_class ? `Class: ${pd.shipping_class}` : 'No class'}</small>
                  </div>
                  <span class="demand-count">{pd.enquiry_count}</span>
                </div>
              ))}
            </div>
          ) : (
            <div class="empty-state-msg">
              <p>No product demand data available yet.</p>
            </div>
          )}
        </div>
      </div>

      <!-- Right Column: Follow-ups -->
      <div class="side-column">
        <div class="content-card fill-height">
          <div class="card-head">
            <h2 class="section-title">Pending & Overdue<br/>Follow-ups</h2>
          </div>
          {upcomingFollowups.length > 0 ? (
            <div class="followup-list">
              {upcomingFollowups.map(f => (
                <div class="followup-item">
                  <div class="fu-info">
                    <strong class="cell-primary">Lead #{f.lead_id}</strong>
                    <p class="fu-task">{f.outcome || 'Follow-up with lead'}</p>
                    <small class="fu-meta">Due: {new Date(f.due_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} &middot; {f.priority}</small>
                  </div>
                  <button class="btn-complete-icon" onclick={`completeFollowup(${f.id})`} title="Mark Done">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </button>
                </div>
              ))}
            </div>
          ) : (
            <div class="empty-state-msg compact">
              <p>No pending follow-ups</p>
              <a href="/crm/leads" class="create-fu-link">Create follow-up &rarr;</a>
            </div>
          )}
        </div>
      </div>
    </div>

<style>
  /* Local Scoped Styles for Redesigned Dashboard Metrics */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }
  
  .metric-card {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
  }
  
  .metric-card.highlight-new { border-left: 4px solid var(--maroon); }
  .metric-card.highlight-alert { border-left: 4px solid var(--pink); background: var(--paper-3); }
  
  .m-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
  
  .m-val {
    font-size: 28px;
    font-weight: 600;
    color: var(--maroon-2);
    line-height: 1.2;
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }
  
  .m-sub {
    font-size: 12px;
    color: var(--ink-soft);
  }

  .dash-grid-2 {
    display: grid;
    grid-template-columns: minmax(0, 2.5fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .main-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .side-column {
    display: flex;
    flex-direction: column;
  }

  .content-card {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0;
    overflow: hidden;
  }
  
  .content-card.fill-height {
    height: 100%;
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 20px 24px;
    border-bottom: 1px solid var(--line);
  }
  
  .side-column .card-head {
    padding: 20px;
  }

  .section-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--maroon-2);
    margin: 0;
  }

  .section-subtitle {
    font-size: 13px;
    color: var(--ink-soft);
    margin: 4px 0 0 0;
  }

  .view-all-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--maroon);
    text-decoration: none;
  }
  
  .view-all-link:hover {
    text-decoration: underline;
  }

  /* Table Design */
  .table-scroll-container {
    overflow-x: auto;
  }

  .crm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .crm-table th {
    text-align: left;
    padding: 12px 24px;
    color: var(--ink-soft);
    font-weight: 500;
    font-size: 12px;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  .crm-table td {
    padding: 12px 24px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
    height: 64px;
  }

  .interactive-row {
    transition: background-color 0.15s ease;
  }
  .interactive-row:hover {
    background-color: var(--paper-3);
  }

  .cell-primary {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .cell-secondary {
    display: block;
    font-size: 12px;
    color: var(--ink-soft);
  }
  
  .muted-text {
    color: var(--ink-soft);
    font-style: italic;
    font-weight: 400;
  }

  /* Badges */
  .badge-source {
    display: inline-block;
    padding: 4px 8px;
    background: var(--paper-3);
    color: var(--ink);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
  }

  .badge-status {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    background: var(--paper-3);
    color: var(--ink);
  }
  .badge-status[data-status="New"] { background: var(--maroon-3); color: #fff; }
  .badge-status[data-status="In Progress"] { background: var(--pink-soft); color: var(--maroon-2); }
  .badge-status[data-status="Contacted"] { background: var(--pink-soft); color: var(--maroon-2); }
  .badge-status[data-status="Qualified"] { background: var(--paper-3); color: var(--maroon-2); }
  .badge-status[data-status="Converted"] { background: var(--maroon); color: #fff; font-weight: 600; }
  .badge-status[data-status="Closed"] { background: var(--paper-3); color: var(--ink-soft); }
  .badge-status[data-status="Lost"] { background: var(--pink); color: #fff; }

  /* Buttons */
  .btn-action-ghost {
    background: transparent;
    color: var(--maroon);
    border: none;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-action-ghost:hover {
    background: var(--paper-3);
  }

  /* Demand List */
  .demand-list {
    padding: 12px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .demand-item {
    display: flex;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .demand-item:last-child {
    border-bottom: none;
  }
  .demand-rank {
    font-weight: 600;
    color: var(--ink-soft);
    width: 32px;
    font-size: 14px;
  }
  .demand-info {
    flex: 1;
  }
  .demand-count {
    background: var(--paper-3);
    color: var(--ink);
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
  }

  /* Follow-ups List */
  .followup-list {
    padding: 0 20px 20px;
    display: flex;
    flex-direction: column;
  }
  .followup-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .followup-item:last-child {
    border-bottom: none;
  }
  .fu-info {
    flex: 1;
    padding-right: 12px;
  }
  .fu-task {
    font-size: 13px;
    color: var(--ink);
    margin: 4px 0;
    line-height: 1.4;
  }
  .fu-meta {
    font-size: 12px;
    color: var(--ink-soft);
  }
  .btn-complete-icon {
    background: var(--paper-2);
    border: 1px solid var(--line);
    color: var(--ink-soft);
    border-radius: 6px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
    flex-shrink: 0;
  }
  .btn-complete-icon:hover {
    background: var(--maroon);
    color: #ffffff;
    border-color: var(--maroon);
  }

  /* Empty States */
  .empty-state-msg {
    padding: 40px 24px;
    text-align: center;
    color: var(--ink-soft);
    font-size: 14px;
  }
  .empty-state-msg.compact {
    padding: 32px 20px;
  }
  .create-fu-link {
    display: inline-block;
    margin-top: 8px;
    font-size: 13px;
    color: var(--maroon);
    text-decoration: none;
    font-weight: 500;
  }
  .create-fu-link:hover {
    text-decoration: underline;
  }

  /* Responsive Grid */
  @media (max-width: 1023px) {
    .dash-grid-2 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .metric-card {
      padding: 16px;
    }
    .card-head, .side-column .card-head {
      padding: 16px;
    }
    .crm-table th, .crm-table td {
      padding: 12px 16px;
    }
    .demand-list {
      padding: 12px 16px;
    }
    .followup-list {
      padding: 0 16px 16px;
    }
  }

  @media (max-width: 440px) {
    .metrics-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
