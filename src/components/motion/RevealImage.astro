---
export interface Props {
  src: string;
  alt?: string;
  effects?: ('clip' | 'blur' | 'scale' | 'opacity')[];
  duration?: number;
  ease?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  aspectRatio?: string;
}

const {
  src,
  alt = '',
  effects = ['clip', 'scale'],
  duration = 1.0,
  ease = 'power3.out',
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  aspectRatio
} = Astro.props;

// Enforce max 2 effects per prompt rules
const activeEffects = effects.slice(0, 2).join(' ');
---

<div 
  class={`reveal-image-frame ${className}`} 
  data-reveal-image
  data-effects={activeEffects}
  data-duration={duration}
  data-ease={ease}
  style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
>
  <img 
    src={src} 
    alt={alt} 
    loading={loading}
    fetchpriority={fetchpriority}
    class="reveal-img-target"
  />
</div>

<style>
  .reveal-image-frame {
    position: relative;
    overflow: hidden;
    display: block;
    width: 100%;
  }

  .reveal-img-target {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    will-change: transform, clip-path, opacity, filter;
  }
</style>
