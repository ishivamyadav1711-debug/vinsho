---
import ProductCard from './ProductCard.astro';
import TextReveal from './motion/TextReveal.astro';
import content from '../../vinsho-content.json';

const lovedSlugs = ["bedsheet", "curtains", "decorative-candles", "wall-art-2"];
const productsBySlug = Object.fromEntries(content.products.map(p => [p.slug, p]));
const lovedProducts = lovedSlugs.map(slug => productsBySlug[slug]).filter(Boolean);
---

<section class="wrap" id="loved">
  <div class="sh">
    <div>
      <TextReveal as="h2">Most Loved Pieces</TextReveal>
    </div>
    <p>Discover why VINSHO is the go-to for curated, handcrafted home décor — pieces our customers come back for.</p>
  </div>
  <div class="grid" id="lovedGrid" data-clip-grid>
    {lovedProducts.map(product => (
      <ProductCard product={product} />
    ))}
  </div>
</section>
