---
---

<div class="cart-backdrop" id="cart-backdrop" hidden aria-hidden="true"></div>

<aside class="cart-drawer" id="cart-drawer" hidden role="dialog" aria-modal="true" aria-label="Shopping Cart">
  <div class="cart-header">
    <div class="cart-title-group">
      <h2>YOUR CART</h2>
      <span class="cart-count-badge" id="cart-drawer-count">0 items</span>
    </div>
    <button class="cart-close-btn" id="cart-drawer-close" aria-label="Close Cart">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="cart-body" id="cart-drawer-body">
    <div class="cart-empty-state" id="cart-empty-state">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--pink); margin-bottom: 0.75rem;">
        <path d="M6 7h12l-1 13H7L6 7Z"/>
        <path d="M9 7a3 3 0 0 1 6 0"/>
      </svg>
      <p class="empty-title">Your cart is currently empty.</p>
      <p class="empty-desc">Discover our handcrafted candles, cork accessories and curated gifting collections.</p>
      <a href="/products" class="cart-shop-btn">Explore Products</a>
    </div>

    <div class="cart-items-list" id="cart-items-list" hidden>
      <!-- Populated via JS -->
    </div>
  </div>

  <div class="cart-footer" id="cart-drawer-footer" hidden>
    <div class="cart-subtotal-row">
      <span>Subtotal</span>
      <span class="subtotal-val" id="cart-subtotal-val">₹0</span>
    </div>
    <p class="cart-shipping-note">Taxes &amp; shipping calculated at Shopify checkout.</p>
    <button class="cart-checkout-btn" id="cart-checkout-btn">
      <span>PROCEED TO CHECKOUT</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</aside>

<script>
  import { getLocalCartState, updateLocalCartItemQty, removeLocalCartItem } from '../scripts/cart-store';

  document.addEventListener('DOMContentLoaded', () => {
    const backdrop = document.getElementById('cart-backdrop');
    const drawer = document.getElementById('cart-drawer');
    const closeBtn = document.getElementById('cart-drawer-close');
    const countBadge = document.getElementById('cart-drawer-count');
    const emptyState = document.getElementById('cart-empty-state');
    const itemsList = document.getElementById('cart-items-list');
    const footer = document.getElementById('cart-drawer-footer');
    const subtotalVal = document.getElementById('cart-subtotal-val');
    const checkoutBtn = document.getElementById('cart-checkout-btn');

    function renderCart() {
      const state = getLocalCartState();
      
      if (countBadge) {
        countBadge.textContent = `${state.totalQuantity} item${state.totalQuantity === 1 ? '' : 's'}`;
      }

      // Also update header badge if available
      const navBadge = document.getElementById('cartN');
      if (navBadge) {
        navBadge.textContent = state.totalQuantity.toString();
      }

      if (state.items.length === 0) {
        if (emptyState) emptyState.hidden = false;
        if (itemsList) itemsList.hidden = true;
        if (footer) footer.hidden = true;
      } else {
        if (emptyState) emptyState.hidden = true;
        if (itemsList) {
          itemsList.hidden = false;
          itemsList.innerHTML = state.items.map((item) => `
            <div class="cart-item-row" data-id="${item.id}">
              <img src="${item.image || '/placeholder.png'}" alt="${item.name}" class="cart-item-img" />
              <div class="cart-item-details">
                <div class="cart-item-head">
                  <h4 class="cart-item-title">${item.name}</h4>
                  <button class="cart-item-remove" data-remove="${item.id}" aria-label="Remove item">&times;</button>
                </div>
                ${item.variantTitle ? `<p class="cart-item-var">${item.variantTitle}</p>` : ''}
                <div class="cart-item-foot">
                  <div class="cart-qty-ctrl">
                    <button class="qty-btn dec" data-dec="${item.id}">&minus;</button>
                    <span class="qty-num">${item.quantity}</span>
                    <button class="qty-btn inc" data-inc="${item.id}">&plus;</button>
                  </div>
                  <span class="cart-item-price">₹${(item.price * item.quantity).toLocaleString('en-IN')}</span>
                </div>
              </div>
            </div>
          `).join('');

          // Wire up event listeners
          itemsList.querySelectorAll('[data-remove]').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const id = (e.currentTarget as HTMLElement).dataset.remove || '';
              removeLocalCartItem(id);
            });
          });

          itemsList.querySelectorAll('[data-dec]').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const id = (e.currentTarget as HTMLElement).dataset.dec || '';
              const row = state.items.find(i => i.id === id);
              if (row) updateLocalCartItemQty(id, row.quantity - 1);
            });
          });

          itemsList.querySelectorAll('[data-inc]').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const id = (e.currentTarget as HTMLElement).dataset.inc || '';
              const row = state.items.find(i => i.id === id);
              if (row) updateLocalCartItemQty(id, row.quantity + 1);
            });
          });
        }

        if (footer) footer.hidden = false;
        if (subtotalVal) subtotalVal.textContent = `₹${state.subtotal.toLocaleString('en-IN')}`;
      }
    }

    function openDrawer() {
      if (!drawer || !backdrop) return;
      renderCart();
      drawer.hidden = false;
      backdrop.hidden = false;
      requestAnimationFrame(() => {
        drawer.classList.add('active');
        backdrop.classList.add('active');
      });
      document.body.classList.add('lock');
    }

    function closeDrawer() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('active');
      backdrop.classList.remove('active');
      setTimeout(() => {
        drawer.hidden = true;
        backdrop.hidden = true;
        document.body.classList.remove('lock');
      }, 350);
    }

    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    window.addEventListener('vinsho:open-cart-drawer', openDrawer);
    window.addEventListener('vinsho:cart-updated', renderCart);

    checkoutBtn?.addEventListener('click', () => {
      const state = getLocalCartState();
      if (state.checkoutUrl) {
        window.location.href = state.checkoutUrl;
      } else {
        alert('Redirecting to Shopify Hosted Checkout...\n(Configure SHOPIFY_STOREFRONT_ACCESS_TOKEN in .env for live store checkout)');
      }
    });

    // Initial render call to sync header badge
    renderCart();
  });
</script>

<style>
  .cart-backdrop {
    position: fixed;
    inset: 0;
    z-index: 140;
    background: rgba(30, 20, 24, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .cart-backdrop.active {
    opacity: 1;
  }

  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 150;
    width: min(420px, 92vw);
    background: var(--paper);
    box-shadow: -12px 0 40px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cart-drawer.active {
    transform: translateX(0);
  }

  .cart-header {
    padding: calc(1rem + env(safe-area-inset-top, 0px)) 1.25rem 1rem;
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-title-group {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .cart-title-group h2 {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--maroon-2);
    margin: 0;
  }

  .cart-count-badge {
    font-size: 0.75rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .cart-close-btn {
    background: none;
    border: none;
    color: var(--maroon-2);
    cursor: pointer;
    padding: 0.35rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    transition: background 0.2s ease;
  }

  .cart-close-btn:hover {
    background: var(--paper-3);
  }

  .cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
  }

  .cart-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1rem;
  }

  .empty-title {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--maroon-2);
    margin: 0 0 0.4rem;
  }

  .empty-desc {
    font-size: 0.813rem;
    color: var(--ink-soft);
    max-width: 20rem;
    margin: 0 0 1.25rem;
  }

  .cart-shop-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--maroon);
    color: #fff;
    font-size: 0.813rem;
    font-weight: 600;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart-item-row {
    display: flex;
    gap: 0.85rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .cart-item-img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 4px;
    background: var(--paper-3);
    flex-shrink: 0;
  }

  .cart-item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .cart-item-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .cart-item-title {
    font-family: var(--display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--maroon-2);
    margin: 0;
    line-height: 1.25;
  }

  .cart-item-remove {
    background: none;
    border: none;
    color: var(--ink-soft);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }

  .cart-item-remove:hover {
    color: var(--maroon);
  }

  .cart-item-var {
    font-size: 0.75rem;
    color: var(--ink-soft);
    margin: 0.15rem 0 0;
  }

  .cart-item-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
  }

  .cart-qty-ctrl {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper-2);
  }

  .qty-btn {
    background: none;
    border: none;
    color: var(--maroon-2);
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .qty-num {
    font-size: 0.781rem;
    font-weight: 600;
    min-width: 24px;
    text-align: center;
  }

  .cart-item-price {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--maroon);
  }

  .cart-footer {
    padding: 1.25rem;
    padding-bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    background: var(--paper-2);
    border-top: 1px solid var(--line);
  }

  .cart-subtotal-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--maroon-2);
    margin-bottom: 0.25rem;
  }

  .subtotal-val {
    font-size: 1.1rem;
    color: var(--maroon);
  }

  .cart-shipping-note {
    font-size: 0.75rem;
    color: var(--ink-soft);
    margin: 0 0 1rem;
  }

  .cart-checkout-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--maroon);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.85rem 1.25rem;
    min-height: 48px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .cart-checkout-btn:hover {
    background: var(--maroon-3);
  }
</style>
