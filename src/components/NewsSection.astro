---
import TextReveal from './motion/TextReveal.astro';

// Published posts dataset (currently 1 post exists)
const articles = [
  {
    title: 'Artisanal Furnishings for Modern Homes',
    date: 'October 2025',
    category: 'Design Philosophy',
    summary: 'Exploring how natural cottons, hand-finished metals, and architectural lighting ground contemporary interiors.',
    image: '/images/vinsho/site/WhatsApp-Image-2026-01-21-at-10.23.07.jpeg'
  }
];

const showSection = articles.length >= 3;
---

{showSection && (
  <section class="wrap news-section" id="news">
    <div class="sh">
      <div>
        <TextReveal as="h2">Latest Articles</TextReveal>
        <p>Design notes, material explorations and stories from Greater Noida.</p>
      </div>
    </div>

    <div class="news-grid">
      {articles.map((post) => (
        <article class="news-card">
          <div class="news-img-frame">
            <img src={post.image} alt={post.title} loading="lazy" />
          </div>
          <div class="news-body">
            <p class="news-meta">{post.category} &middot; {post.date}</p>
            <h3>{post.title}</h3>
            <p class="news-summary">{post.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.75rem;
    margin-top: 2rem;
  }

  .news-card {
    background: var(--paper-2, #F7F1E9);
    border: 1px solid var(--line, rgba(138, 23, 75, 0.12));
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .news-img-frame {
    width: 100%;
    height: 180px;
    max-height: 190px;
    overflow: hidden;
    background: var(--paper-3, #EFE6DC);
    flex-shrink: 0;
  }

  .news-img-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .news-body {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .news-meta {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--maroon, #8A174B);
    margin: 0 0 0.5rem;
  }

  .news-body h3 {
    font-family: var(--display, 'Playfair Display', serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--maroon-2, #6B0E38);
    margin: 0 0 0.6rem;
    line-height: 1.3;
  }

  .news-summary {
    font-size: 0.88rem;
    color: var(--ink, #3E3336);
    line-height: 1.6;
    margin: 0;
  }
</style>
