---
import TextReveal from './motion/TextReveal.astro';
import { getCollections, getCollectionProductCount, getActiveProducts } from '../utils/taxonomy';

const collections = getCollections();
const activeProducts = getActiveProducts();

const collectionItems = collections.map((col, idx) => {
  const colProducts = activeProducts.filter(p => p.collectionKey === col.key);
  const images = colProducts.map(p => ({
    url: p.image || '/placeholder.png',
    title: p.name,
    price: p.sellingPrice || p.price || 0,
    slug: p.slug
  })).filter(i => i.url);

  const primaryImage = images[0]?.url || '/placeholder.png';

  return {
    num: `0${idx + 1}`,
    key: col.key,
    name: col.name,
    count: `${getCollectionProductCount(col.key)} pieces`,
    blurb: col.blurb,
    image: primaryImage,
    productImages: images.slice(0, 6), // Top 6 product images
    totalProducts: colProducts.length
  };
});
---

<section class="wrap collections-editorial-section" id="collections">
  <div class="sh">
    <div>
      <TextReveal as="h2">Curated Collections</TextReveal>
      <p>Explore our distinct craft disciplines designed to bring unity and elegance to your space.</p>
    </div>
  </div>

  <div class="collections-split-layout">
    <!-- Left Column: Editorial Directory Rows -->
    <div class="collections-rows-list">
      {collectionItems.map((item) => (
        <div class="collection-row-item" data-col-target={item.key}>
          <a href={`/collections/${item.key}`} class="row-header-link">
            <div class="row-left">
              <span class="row-num">{item.num}</span>
              <div class="row-title-group">
                <h3 class="row-name">{item.name}</h3>
                <p class="row-blurb">{item.blurb}</p>
              </div>
            </div>
            <div class="row-right">
              <span class="row-count">{item.count}</span>
              <div class="arrow-circle">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
          </a>

        </div>
      ))}
    </div>

    <!-- Right Column: Desktop Dynamic Product Image Showcase -->
    <div class="collections-right-showcase" aria-hidden="true">
      <div class="showcase-frame">
        {collectionItems.map((item, idx) => (
          <div class={`showcase-slide ${idx === 0 ? 'active' : ''}`} data-col-slide={item.key}>
            <div class="showcase-grid-preview">
              {item.productImages.slice(0, 4).map((prod, pIdx) => (
                <div class={`showcase-img-box img-box-${pIdx + 1}`}>
                  <img src={prod.url} alt={prod.title} loading="lazy" />
                  <div class="img-box-overlay">
                    <span class="box-prod-title">{prod.title}</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="showcase-caption">
              <span>{item.name}</span>
              <span class="caption-count">{item.count}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const rowItems = document.querySelectorAll<HTMLElement>('.collection-row-item');
    const slides = document.querySelectorAll<HTMLElement>('.showcase-slide');
    const isTouch = window.matchMedia('(hover: none), (pointer: coarse)').matches;

    if (!rowItems.length || isTouch) return;

    rowItems.forEach((row) => {
      row.addEventListener('mouseenter', () => {
        const key = row.dataset.colTarget;
        if (!key) return;

        rowItems.forEach(r => r.classList.remove('active'));
        row.classList.add('active');

        slides.forEach((slide) => {
          if (slide.dataset.colSlide === key) {
            slide.classList.add('active');
          } else {
            slide.classList.remove('active');
          }
        });
      });
    });
  });
</script>

<style>
  .collections-editorial-section {
    padding-block: clamp(3rem, 5vw, 6rem);
  }

  .collections-split-layout {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    margin-top: 2rem;
  }

  .collections-rows-list {
    display: flex;
    flex-direction: column;
  }

  .collection-row-item {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
    position: relative;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .collection-row-item:first-child {
    border-top: 1px solid var(--line);
  }

  .row-header-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    text-decoration: none;
    color: var(--ink);
    width: 100%;
  }

  .row-left {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex: 1;
  }

  .row-num {
    font-family: var(--sans);
    font-size: 0.781rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--pink);
    min-width: 1.8rem;
  }

  .row-name {
    font-family: var(--display);
    font-size: clamp(1.25rem, 2vw, 1.85rem);
    font-weight: 600;
    color: var(--maroon-2);
    margin: 0 0 0.3rem 0;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .row-blurb {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.45;
    max-width: 26rem;
  }

  .row-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .row-count {
    font-size: 0.781rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .arrow-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    color: var(--maroon-2);
    transition: all 0.3s ease;
  }

  .row-touch-preview {
    display: none;
    margin-top: 1rem;
  }

  .touch-gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .touch-img-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }

  .touch-img-card img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .touch-card-title {
    font-size: 0.7rem;
    color: var(--maroon-2);
    padding: 0.3rem 0.4rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
  }

  /* Right Column Showcase Frame */
  .collections-right-showcase {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3.5;
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--line);
  }

  .showcase-frame {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .showcase-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    display: flex;
    flex-direction: column;
    padding: 1rem;
  }

  .showcase-slide.active {
    opacity: 1;
    visibility: visible;
  }

  .showcase-grid-preview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.75rem;
    flex: 1;
  }

  .showcase-img-box {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background: var(--paper-3);
  }

  .showcase-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .showcase-img-box:hover img {
    transform: scale(1.06);
  }

  .img-box-overlay {
    position: absolute;
    bottom: 0;
    inset-inline: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.65), transparent);
    padding: 0.6rem 0.5rem 0.4rem;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .showcase-img-box:hover .img-box-overlay {
    opacity: 1;
  }

  .box-prod-title {
    font-size: 0.72rem;
    color: #fff;
    font-weight: 500;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .showcase-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: 0.813rem;
    font-weight: 600;
    color: var(--maroon-2);
  }

  .caption-count {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  /* Desktop Fine Pointer Hover Effects */
  @media (hover: hover) and (pointer: fine) {
    .collection-row-item:hover, .collection-row-item.active {
      padding-left: 0.5rem;
    }

    .collection-row-item:hover .row-name, .collection-row-item.active .row-name {
      color: var(--maroon);
    }

    .collection-row-item:hover .arrow-circle, .collection-row-item.active .arrow-circle {
      background: var(--maroon);
      border-color: var(--maroon);
      color: #ffffff;
      transform: translateX(4px);
    }
  }

  /* Touch Accordion Behavior */
  @media (hover: none), (pointer: coarse), (max-width: 900px) {
    .collections-split-layout {
      grid-template-columns: 1fr;
    }

    .collections-right-showcase {
      display: none;
    }

    .row-header-link {
      flex-direction: column;
      align-items: flex-start;
    }

    .row-right {
      width: 100%;
      justify-content: space-between;
      margin-top: 0.5rem;
    }

    .collection-row-item.expanded .row-touch-preview {
      display: block;
    }
  }
</style>
