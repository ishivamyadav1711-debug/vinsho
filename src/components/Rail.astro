---
import ProductCard from './ProductCard.astro';
import TextReveal from './motion/TextReveal.astro';
import Magnetic from './motion/Magnetic.astro';
import content from '../../vinsho-content.json';

const railSlugs = ["decorative-candles", "carpets", "wall-art-2", "mirror", "metal-tree", "flowers-bouquet"];
const productsBySlug = Object.fromEntries(content.products.map(p => [p.slug, p]));
const railProducts = railSlugs.map(slug => productsBySlug[slug]).filter(Boolean);
---

<section class="wrap" id="dream">
  <div class="sh">
    <div>
      <TextReveal as="h2">Dream Décor</TextReveal>
      <p>Curated architectural lighting, textile textures and wall accents designed to elevate everyday living.</p>
    </div>
    <div class="r">
      <Magnetic strength={4}>
        <button class="arw" id="prev" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M19 12H5M11 6l-6 6 6 6"/>
          </svg>
        </button>
      </Magnetic>
      <Magnetic strength={4}>
        <button class="arw" id="next" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </button>
      </Magnetic>
    </div>
  </div>
  <div class="rail" id="rail" data-rail-stagger>
    {railProducts.map(product => (
      <ProductCard product={product} />
    ))}
  </div>
</section>
