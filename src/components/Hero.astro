---
import content from '../../vinsho-content.json';
import Magnetic from './motion/Magnetic.astro';
// Compressed versions of hero-bg.png (942 KB PNG), generated with sharp:
// AVIF 41/89 KB for current browsers, WebP 66/143 KB as the fallback.
import hero640Avif from '../assets/hero/hero-bg-640.avif';
import hero1024Avif from '../assets/hero/hero-bg-1024.avif';
import hero640 from '../assets/hero/hero-bg-640.webp';
import hero1024 from '../assets/hero/hero-bg-1024.webp';
---

<section class="hero" id="hero-section" style="padding:0">
  <div class="hero-bg" id="hero-bg-frame">
    {content.siteImages.hero && (
      <picture>
      <source type="image/avif" srcset={`${hero640Avif.src} 640w, ${hero1024Avif.src} 1024w`} sizes="100vw" />
      <img
        src={hero1024.src}
        srcset={`${hero640.src} 640w, ${hero1024.src} 1024w`}
        sizes="100vw"
        width="1024"
        height="1024"
        alt="VINSHO Home Décor"
        id="hero-img-target"
        loading="eager"
        fetchpriority="high"
        style="width: 100%; height: 100%; object-fit: cover;"
      />
      </picture>
    )}
  </div>
  <div class="hero-in" id="hero-content">
    <h1 class="hero-headline">
      <span class="w"><span id="hero-line-1">Where Every Corner</span></span>
      <span class="w"><span id="hero-line-2">Tells a Story</span></span>
    </h1>
    <Magnetic strength={4}>
      <a class="btn" id="hero-cta-btn" href="/products">Shop Now
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </Magnetic>
  </div>
  <div class="hero-mark"><span id="hero-wordmark">VINSHO</span></div>
</section>
