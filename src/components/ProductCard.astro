---
import { isProductPurchasable } from '../lib/purchasability';

export interface Props {
  product: {
    slug: string;
    name: string;
    collection?: string;
    collectionKey?: string;
    subcategory?: string;
    subcategoryKey?: string;
    mainCategory?: string;
    subCategory?: string;
    material?: string;
    description?: string;
    image: string;
    sku_ref?: string;
    isPurchasable?: boolean;
    price?: number | null;
    sellingPrice?: number | null;
    variants?: any[];
  };
  class?: string;
}

const { product, class: className = '' } = Astro.props;

const isPurchasable = isProductPurchasable(product);
const priceVal = product.price || product.sellingPrice;
const formattedPrice = isPurchasable && priceVal
  ? `₹${priceVal.toLocaleString('en-IN')}`
  : 'Price on request';

const colKey = product.collectionKey || '';
const subKey = product.subcategoryKey || '';

const searchTerms = [
  product.name,
  product.slug,
  product.description || '',
  product.collection || '',
  product.collectionKey || '',
  product.subcategory || '',
  product.subcategoryKey || '',
  product.mainCategory || '',
  product.subCategory || '',
  product.material || '',
  product.sku_ref || ''
].filter(Boolean).join(' ').toLowerCase();

let defaultVariantId: number | null = null;
let isOutOfStock = false;

if (isPurchasable) {
  if (product.variants && product.variants.length > 0) {
    defaultVariantId = product.variants[0].id;
    const totalStock = product.variants.reduce((sum: number, v: any) => sum + (v.stock || 0), 0);
    if (totalStock <= 0) {
      isOutOfStock = true;
    }
  } else {
    isOutOfStock = true; // No variants means no stock
  }
}
---

<article 
  class={`pc in ${className}`} 
  data-s={product.slug}
  data-sku-ref={product.sku_ref || ''}
  data-col-key={colKey}
  data-sub-key={subKey}
  data-material={product.material || ''}
  data-purchasable={isPurchasable ? 'true' : 'false'}
  data-search-terms={searchTerms}
>
  <div class="pc-img">
    <a href={`/product/${product.slug}`} class="pc-img-link" aria-label={`View ${product.name}`}>
      <img src={product.image} alt={product.name} width="400" height="400" loading="lazy" decoding="async" onerror="this.onerror=null; this.src='/images/candles/placeholder.svg';" />
    </a>
  </div>

  <div class="pc-info">
    <div class="pc-text">
      <h3 class="pc-name">
        <a href={`/product/${product.slug}`} class="pc-name-link">{product.name}</a>
      </h3>
      {product.description && (
        <p class="pc-desc">{product.description}</p>
      )}
    </div>
    
    <div class="pc-foot">
      <span class="pc-price">{formattedPrice}</span>
      <div class="pc-actions">
        {isPurchasable ? (
          isOutOfStock ? (
            <span class="pc-out-of-stock-badge">OUT OF STOCK</span>
          ) : (
            <>
              <button 
                class="pc-btn-secondary" 
                data-add={product.slug} 
                data-name={product.name}
                data-price={product.price || 499}
                data-image={product.image}
                data-variant-id={defaultVariantId}
              >
                Add
              </button>
              <button 
                class="pc-btn-primary" 
                data-buy-now={product.slug} 
                data-name={product.name}
                data-price={product.price || 499}
                data-image={product.image}
                data-variant-id={defaultVariantId}
              >
                Buy Now
              </button>
            </>
          )
        ) : (
          <button class="pc-btn-link" data-open={product.slug}>
            Get Quote
          </button>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .pc {
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--line, #e2dcd0);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .pc:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .pc-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--paper-2, #f5f2eb);
    position: relative;
  }
  .pc-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pc:hover .pc-img img {
    transform: scale(1.04);
  }
  .pc-img-link, .pc-name-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .pc-info {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .pc-name {
    font-family: var(--serif, serif);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    font-weight: 500;
    color: var(--maroon, #8A174B);
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc-name-link:hover {
    color: var(--maroon-2, #6B0E38);
  }
  .pc-desc {
    font-family: var(--sans, sans-serif);
    font-size: clamp(0.75rem, 1.1vw, 0.85rem);
    color: var(--grey, #666);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0.35rem 0 0 0;
  }
  .pc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }
  .pc-price {
    font-family: var(--sans, sans-serif);
    font-size: clamp(0.75rem, 1.2vw, 0.813rem);
    font-weight: 600;
    color: var(--maroon-2, #6B0E38);
    white-space: nowrap;
  }
  .pc-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .pc-btn-primary, .pc-btn-secondary {
    font-family: var(--sans, sans-serif);
    font-size: clamp(0.7rem, 1.1vw, 0.75rem);
    font-weight: 600;
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
  }
  .pc-btn-primary {
    background: var(--maroon, #8A174B);
    color: #ffffff;
    border: 1px solid var(--maroon, #8A174B);
  }
  .pc-btn-primary:hover {
    background: var(--maroon-2, #6B0E38);
    border-color: var(--maroon-2, #6B0E38);
  }
  .pc-btn-secondary {
    background: var(--paper-2, #f5f2eb);
    color: var(--maroon, #8A174B);
    border: 1px solid var(--line, #e2dcd0);
  }
  .pc-btn-secondary:hover {
    background: var(--line, #e2dcd0);
  }
  .pc-btn-link {
    font-family: var(--sans, sans-serif);
    font-size: clamp(0.75rem, 1.1vw, 0.813rem);
    font-weight: 500;
    color: #D3869B; /* Slightly muted pinkish color for link */
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s ease;
  }
  .pc-btn-link:hover {
    color: var(--maroon, #8A174B);
  }
  .pc-out-of-stock-badge {
    font-family: var(--sans, sans-serif);
    font-size: clamp(0.7rem, 1.1vw, 0.75rem);
    font-weight: 700;
    color: #b91c1c;
    background: #fef2f2;
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    display: inline-block;
    border: 1px solid #f87171;
  }

  @media (max-width: 640px) {
    .pc-info {
      padding: 0.55rem;
      gap: 0.4rem;
    }
    .pc-name {
      font-size: 0.813rem;
      line-height: 1.25;
    }
    .pc-foot {
      flex-direction: row;
      align-items: center;
      gap: 0.4rem;
    }
    .pc-price {
      font-size: 0.75rem;
      text-align: left;
    }
    .pc-actions {
      margin-left: auto;
    }
    .pc-btn-primary, .pc-btn-secondary {
      font-size: 0.7rem;
      padding: 0.35rem 0.5rem;
      min-height: 26px;
    }
  }
</style>
