---
import { isProductPurchasable } from '../lib/purchasability';

export interface Props {
  product: {
    slug: string;
    name: string;
    collection?: string;
    collectionKey?: string;
    subcategory?: string;
    subcategoryKey?: string;
    mainCategory?: string;
    subCategory?: string;
    material?: string;
    description?: string;
    image: string;
    sku_ref?: string;
    isPurchasable?: boolean;
    price?: number | null;
    sellingPrice?: number | null;
  };
  class?: string;
}

const { product, class: className = '' } = Astro.props;

const isPurchasable = isProductPurchasable(product);
const priceVal = product.price || product.sellingPrice;
const formattedPrice = isPurchasable && priceVal
  ? `₹${priceVal.toLocaleString('en-IN')}`
  : 'Price on request';

const eyebrowLabel = product.subCategory || product.subcategory || product.mainCategory || product.collection || '';
const colKey = product.collectionKey || '';
const subKey = product.subcategoryKey || '';

const searchTerms = [
  product.name,
  product.slug,
  product.description || '',
  product.collection || '',
  product.collectionKey || '',
  product.subcategory || '',
  product.subcategoryKey || '',
  product.mainCategory || '',
  product.subCategory || '',
  product.material || '',
  product.sku_ref || ''
].filter(Boolean).join(' ').toLowerCase();
---

<article 
  class={`pc in ${className}`} 
  data-s={product.slug}
  data-sku-ref={product.sku_ref || ''}
  data-col-key={colKey}
  data-sub-key={subKey}
  data-material={product.material || ''}
  data-purchasable={isPurchasable ? 'true' : 'false'}
  data-search-terms={searchTerms}
>
  <div class="pc-img">
    <a href={`/product/${product.slug}`} class="pc-img-link" aria-label={`View ${product.name}`}>
      <img src={product.image} alt={product.name} width="400" height="400" loading="lazy" decoding="async" onerror="this.onerror=null; this.src='/images/candles/placeholder.svg';" />
    </a>
    <div class="pc-ov">
      <a href={`/product/${product.slug}`} class="view">VIEW</a>
    </div>
    <div class="pc-acts">
      {isPurchasable ? (
        <button 
          class="pc-act-add" 
          data-add={product.slug}
          data-name={product.name}
          data-price={product.price || 499}
          data-image={product.image}
        >
          &#43; Add to Cart
        </button>
      ) : (
        <button data-open={product.slug}>&#9678; Quick View</button>
      )}
    </div>
  </div>

  <h3 class="pc-name">
    <a href={`/product/${product.slug}`} class="pc-name-link">{product.name}</a>
  </h3>
  <p class="pc-desc">{product.description}</p>
  
  <div class="pc-foot">
    <span class="pc-price">{formattedPrice}</span>
    {isPurchasable ? (
      <div class="pc-buy-grp">
        <button 
          class="pc-btn-cart" 
          data-add={product.slug} 
          data-name={product.name}
          data-price={product.price || 499}
          data-image={product.image}
          title="Add to Cart"
        >
          Add
        </button>
        <button 
          class="pc-btn-buy" 
          data-buy-now={product.slug}
          data-name={product.name}
          data-price={product.price || 499}
          data-image={product.image}
          title="Buy Now"
        >
          Buy Now
        </button>
      </div>
    ) : (
      <button class="pc-q" data-open={product.slug}>Get Quote</button>
    )}
  </div>
</article>

<style>
  .pc {
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }
  .pc-img-link, .pc-name-link {
    text-decoration: none;
    color: inherit;
    display: block;
    width: 100%;
    height: 100%;
  }
  .pc-name-link:hover {
    text-decoration: underline;
  }
  .pc-buy-grp {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }
  .pc-btn-cart, .pc-btn-buy {
    font-size: clamp(0.6rem, 1.1vw, 0.72rem);
    font-weight: 600;
    padding: 0.25rem 0.45rem;
    min-height: 28px;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .pc-btn-cart {
    background: var(--paper-3, #f5f2eb);
    color: var(--maroon, #8A174B);
    border: 1px solid var(--line, #e2dcd0);
  }
  .pc-btn-cart:hover {
    background: var(--maroon, #8A174B);
    color: #fff;
  }
  .pc-btn-buy {
    background: var(--maroon, #8A174B);
    color: #fff;
    border: 1px solid var(--maroon, #8A174B);
  }
  .pc-btn-buy:hover {
    background: var(--maroon-2, #6B0E38);
  }

  @media (max-width: 640px) {
    .pc {
      padding: 0.25rem 0;
    }
    .pc-eyebrow {
      font-size: 0.65rem;
      margin: 0.35rem 0 0.15rem;
    }
    .pc-name {
      font-size: clamp(0.8125rem, 3.2vw, 0.9375rem);
      line-height: 1.25;
      margin: 0 0 0.25rem;
    }
    .pc-desc {
      font-size: 0.72rem;
      line-height: 1.3;
      margin: 0 0 0.35rem;
      -webkit-line-clamp: 2;
    }
    .pc-foot {
      flex-direction: column;
      align-items: stretch;
      gap: 0.35rem;
      padding-top: 0.35rem;
    }
    .pc-price {
      font-size: 0.781rem;
      font-weight: 600;
    }
    .pc-buy-grp {
      flex-direction: column;
      gap: 0.35rem;
      width: 100%;
    }
    .pc-btn-cart, .pc-btn-buy, .pc-q {
      width: 100%;
      min-height: 44px;
      padding: 0.5rem 0.6rem;
      font-size: 0.75rem;
      text-align: center;
      justify-content: center;
      box-sizing: border-box;
    }
  }

  @media (max-width: 400px) {
    .pc-name {
      font-size: 0.8125rem;
    }
    .pc-price {
      font-size: 0.75rem;
    }
  }
</style>

