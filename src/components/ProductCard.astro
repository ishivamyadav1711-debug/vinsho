---
import { isProductPurchasable } from '../lib/purchasability';

export interface Props {
  product: {
    slug: string;
    name: string;
    collection?: string;
    collectionKey?: string;
    subcategory?: string;
    subcategoryKey?: string;
    mainCategory?: string;
    subCategory?: string;
    material?: string;
    description?: string;
    image: string;
    isPurchasable?: boolean;
    price?: number | null;
    sellingPrice?: number | null;
  };
  class?: string;
}

const { product, class: className = '' } = Astro.props;

const isPurchasable = isProductPurchasable(product);
const priceVal = product.price || product.sellingPrice;
const formattedPrice = isPurchasable && priceVal
  ? `₹${priceVal.toLocaleString('en-IN')}`
  : 'Price on request';

const eyebrowLabel = product.subCategory || product.subcategory || product.mainCategory || product.collection || '';
const colKey = product.collectionKey || '';
const subKey = product.subcategoryKey || '';
---

<article 
  class={`pc ${className}`} 
  data-s={product.slug}
  data-col-key={colKey}
  data-sub-key={subKey}
  data-material={product.material || ''}
  data-purchasable={isPurchasable ? 'true' : 'false'}
>
  <div class="pc-img">
    <a href={`/product/${product.slug}`} class="pc-img-link" aria-label={`View ${product.name}`}>
      <img src={product.image} alt={product.name} loading="lazy" />
    </a>
    <div class="pc-ov">
      <a href={`/product/${product.slug}`} class="view">VIEW</a>
    </div>
    <div class="pc-acts">
      {isPurchasable ? (
        <button class="pc-act-add" data-add={product.slug}>&#43; Add to Cart</button>
      ) : (
        <button data-open={product.slug}>&#9678; Quick View</button>
      )}
    </div>
  </div>

  <p class="pc-eyebrow">{eyebrowLabel}</p>
  <h3 class="pc-name">
    <a href={`/product/${product.slug}`} class="pc-name-link">{product.name}</a>
  </h3>
  <p class="pc-desc">{product.description}</p>
  
  <div class="pc-foot">
    <span class="pc-price">{formattedPrice}</span>
    {isPurchasable ? (
      <div class="pc-buy-grp">
        <button class="pc-btn-cart" data-add={product.slug} title="Add to Cart">
          Add
        </button>
        <a href={`/product/${product.slug}?buy=1`} class="pc-btn-buy" title="Buy Now">
          Buy Now
        </a>
      </div>
    ) : (
      <button class="pc-q" data-open={product.slug}>Get Quote</button>
    )}
  </div>
</article>

<script>
  import { addLocalCartItem, openCartDrawer } from '../scripts/cart-store';

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-add]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = (e.currentTarget as HTMLElement).dataset.add || '';
        const card = (e.currentTarget as HTMLElement).closest('.pc');
        if (!card) return;

        const name = card.querySelector('.pc-name')?.textContent?.trim() || 'Product';
        const img = card.querySelector('.pc-img img')?.getAttribute('src') || '';
        const priceText = card.querySelector('.pc-price')?.textContent || '0';
        const price = parseInt(priceText.replace(/[^\d]/g, ''), 10) || 499;

        addLocalCartItem({
          slug,
          name,
          image: img,
          price,
          quantity: 1
        });
        openCartDrawer();
      });
    });
  });
</script>

<style>
  .pc-img-link, .pc-name-link {
    text-decoration: none;
    color: inherit;
    display: block;
    width: 100%;
    height: 100%;
  }
  .pc-name-link:hover {
    text-decoration: underline;
  }
  .pc-buy-grp {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .pc-btn-cart, .pc-btn-buy {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.35rem 0.6rem;
    min-height: 32px;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .pc-btn-cart {
    background: var(--paper-3, #f5f2eb);
    color: var(--maroon, #670832);
    border: 1px solid var(--line, #e2dcd0);
  }
  .pc-btn-cart:hover {
    background: var(--maroon, #670832);
    color: #fff;
  }
  .pc-btn-buy {
    background: var(--maroon, #670832);
    color: #fff;
    border: 1px solid var(--maroon, #670832);
  }
  .pc-btn-buy:hover {
    background: var(--maroon-2, #4a0523);
  }

  @container (max-width: 190px) {
    .pc-buy-grp {
      flex-direction: column;
      gap: 0.25rem;
      width: 100%;
    }
    .pc-btn-cart, .pc-btn-buy {
      width: 100%;
      padding: 0.25rem 0.4rem;
      font-size: 0.68rem;
      min-height: 28px;
    }
    .pc-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
  }
</style>

