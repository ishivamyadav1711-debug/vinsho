# VINSHO Environment Configuration Template

# Site Mode ('enquiry' or 'live')
COMMERCE_MODE=live

# Shopify Storefront API Credentials
# Replace with your Shopify store domain & Storefront API access token
SHOPIFY_STORE_DOMAIN=vinsho-official.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token_here
SHOPIFY_API_VERSION=2024-07

# Database Session & Encryption Secrets (Server-side only)
SESSION_SECRET=your_random_session_secret_here
ADMIN_PASSPHRASE_HASH=your_bcrypt_hashed_passphrase_here
