# VINSHO — Environment Configuration Template
# ────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development.
# For production, set variables in your hosting platform's secure secret store (e.g. Vercel).
# NEVER commit .env or .env.local to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Site URL ─────────────────────────────────────────────────────────────────
# Production SITE_URL must be https://vinsho.in
SITE_URL=https://vinsho.in

# ── Commerce Mode ────────────────────────────────────────────────────────────
# 'enquiry' = enquiry-only storefront
# 'live'    = full e-commerce checkout enabled
COMMERCE_MODE=live

# ── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# DATABASE_URL: Connect to Supabase transaction pooler (port 6543 with pgbouncer=true&connection_limit=1)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL: Direct session-mode connection for migrations (port 5432)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── Supabase Credentials ─────────────────────────────────────────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Admin Panel Credentials ──────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — application startup fails if these are absent.
ADMIN_EMAIL=admin@vinsho.in
ADMIN_PASSWORD=your_strong_production_admin_password_here

# ── Razorpay Payment Gateway ─────────────────────────────────────────────────
# REQUIRED IN PRODUCTION
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id_here

# ── SMTP / Email Delivery (Optional) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=VINSHO <contact@vinsho.in>
