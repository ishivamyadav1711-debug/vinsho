# VINSHO — Environment Configuration Template
# ────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development.
# For production, set variables in your hosting platform's secure secret store.
# NEVER commit .env or .env.production to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Commerce Mode ────────────────────────────────────────────────────────────
# 'enquiry' = enquiry-only storefront (no checkout)
# 'live'    = full e-commerce checkout enabled
COMMERCE_MODE=live

# ── Admin Panel Credentials ──────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — application startup fails if these are absent.
# Set a strong, unique password. Never reuse a default or example value.
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=your_strong_admin_password_here

# ── Razorpay Payment Gateway ─────────────────────────────────────────────────
# RAZORPAY_WEBHOOK_SECRET — REQUIRED IN PRODUCTION (startup fails if absent).
# Obtain from Razorpay Dashboard → Webhooks → Secret.
RAZORPAY_WEBHOOK_SECRET=50c457c314bcf57a8e7f2607109fcbe2a03af0c660a6445b0fc9a0a30e03501c
# Optional until payments go live:
RAZORPAY_KEY_ID=rzp_live_Th9T7ALkvpNZNx
RAZORPAY_KEY_SECRET=2wNt9MZsgKhwxdMP0u0KxUak

# ── Shopify Storefront API (optional / not currently active) ─────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token_here
SHOPIFY_API_VERSION=2024-07
